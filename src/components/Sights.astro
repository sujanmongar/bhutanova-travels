---
// A place's sights, every one linking to its own page, as attraction cards (square photo, name, two lines): sights with
// their own photo first, then the editor's order; one without a photo shows the place's. id="sights" is where
// "All of <place>" lands.
import type { CollectionEntry } from 'astro:content';
import Section from './Section.astro';
import PlaceCards from './PlaceCards.astro';
import { DESTINATIONS } from '../utils';
interface Props { heading: string; sights: CollectionEntry<'sights'>[]; fallbackImage: string; grey?: boolean; link?: { href: string; label: string }; id?: string }
const { heading, sights, fallbackImage, grey = false, link, id = 'sights' } = Astro.props;
const sorted = [...sights].sort((a, b) => Number(!a.data.image) - Number(!b.data.image) || a.data.order - b.data.order);
---
{sorted.length > 0 && (
  <Section heading={heading} grey={grey} link={link} id={id}>
    <PlaceCards kind="attraction" items={sorted.map((s) => ({ href: `${DESTINATIONS}${s.id}/`, image: s.data.image ?? fallbackImage, title: s.data.title, text: s.data.excerpt }))} />
  </Section>
)}
