---
// ponytail: placeholder wordmark — swap for the real brand logo SVG when designed.
// The name follows the surrounding text colour (white over photos, ink elsewhere).
const { light = false } = Astro.props;
---
<svg class="logo" viewBox="0 0 168 44" role="img" aria-label="Bhutanova Travels" style={light ? 'color:#fff' : undefined}>
  <path d="M4 34 L16 14 L22 23 L27 16 L40 34 Z" fill="#ffa500" />
  <path d="M16 14 L19.5 19.8 L16.6 19 L14.2 21 Z" fill="#fff" />
  <text x="46" y="25" font-weight="600" font-size="18" fill="currentColor">Bhutanova</text>
  <text x="47" y="38" font-weight="600" font-size="8.5" letter-spacing="3.1" fill="#ffa500">TRAVELS</text>
</svg>
<style>
  .logo { width: 132px; height: auto; }
  .logo text { font-family: var(--ff); }
  @media (min-width: 1200px) { .logo { width: 150px; } }
</style>
