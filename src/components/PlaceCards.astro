---
// Photo cards for places — destinations and sights. One style everywhere a place links to its page.
import { img, srcset } from '../config';
interface Props { items: { href: string; image: string; title: string; text: string }[] }
const { items } = Astro.props;
---
<ul class="grid-3 places" data-reveal="stagger">
  {items.map((p) => (
    <li>
      <a href={p.href}>
        <img src={img(p.image, 800, 600)} srcset={srcset(p.image, [400, 600, 900, 1200], 4 / 3)}
          sizes="(min-width:1200px) 384px, (min-width:1024px) 360px, (min-width:808px) calc(50vw - 44px), (min-width:768px) 360px, calc(100vw - 32px)"
          alt="" width="800" height="600" loading="lazy" decoding="async" />
        <div class="places__body">
          <h3 class="t-card">{p.title}</h3>
          <p class="t-body">{p.text}</p>
        </div>
      </a>
    </li>
  ))}
</ul>
<style>
  .places { row-gap: var(--space-12); }
  .places a { display: block; color: inherit; }
  /* Same photo height as every other card */
  .places img { width: 100%; height: var(--card-photo); object-fit: cover; border-radius: var(--radius); corner-shape: squircle; background: var(--s-50); transition: scale var(--dur-4) var(--ease-out); }
  .places__body { padding-top: var(--space-4); }
  .places p { margin-top: var(--space-3); color: var(--text-2); }
  @media (hover: hover) {
    .places a:hover img { scale: 1.02; }
    .places a:hover h3 { text-decoration: underline 1.5px var(--p-500); text-underline-offset: 6px; }
  }
</style>
