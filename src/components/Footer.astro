---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Social from './Social.astro';
import { SITE, tel } from '../config';
import { TOURS, DESTINATIONS, catPath } from '../utils';

// Left: who we are and how to reach us. Right: four short link columns under small uppercase headings.
// Bottom bar: copyright on the left, policies on the right.
const cats = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const columns: { title: string; links: [string, string][]; external?: boolean }[] = [
  { title: 'Tours', links: [...cats.map((c): [string, string] => [c.data.menuTitle, catPath(c.id)]), ['All tours', TOURS]] },
  {
    title: 'Information',
    links: [['Travel guide', '/travel-guide/'], ['Destinations', DESTINATIONS], ['Festival dates', '/travel-guide/festival-calendar/'], ['Flight schedules', '/travel-guide/flight-schedules/'], ['Travel FAQs', '/travel-guide/travel-faqs/'], ['Blog', '/blog/']],
  },
  { title: 'About', links: [['About us', '/about/'], ['About Bhutan', '/about-bhutan/'], ['Contact us', '/contact/']] },
  {
    title: 'Quick links',
    external: true,
    links: [['Department of Tourism', 'https://www.bhutan.travel/'], ['Department of Immigration', 'https://www.immi.gov.bt/'], ['Drukair', 'https://www.drukair.com.bt/'], ['Bhutan Airlines', 'https://www.bhutanairlines.bt/'], ['ABTO', 'https://abto.org.bt/']],
  },
];
---
<footer class="footer">
  <div class="container footer__main">
    <div class="footer__us">
      <a class="footer__logo" href="/" aria-label="Bhutanova Travels home"><Logo light /></a>
      <ul class="footer__contact t-label">
        <li>WhatsApp: <a href={tel(SITE.phone)}>{SITE.phone}</a></li>
        <li>Phone: <a href={tel(SITE.phoneAlt)}>{SITE.phoneAlt}</a></li>
        <li>Email: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li>Address: {SITE.address}</li>
        <li>Licence: Department of Tourism, no. {SITE.licence}</li>
      </ul>
      <p class="footer__h t-label t-caps">Connect with us</p>
      <Social />
    </div>

    <div class="footer__cols">
      {columns.map((c, i) => (
        <nav aria-labelledby={`f-${i}`}>
          <p id={`f-${i}`} class="footer__h t-label t-caps">{c.title}</p>
          <ul class="t-label">
            {c.links.map(([t, u]) => (
              <li>{c.external
                ? <a href={u} target="_blank" rel="noopener">{t.slice(0, t.lastIndexOf(' ') + 1)}<span class="ext">{t.slice(t.lastIndexOf(' ') + 1)}<Icon name="arrow-up-right" /></span><span class="sr-only"> (opens in a new tab)</span></a>
                : <a href={u}>{t}</a>}</li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
  </div>

  <div class="footer__bar t-label">
    <div class="container">
      <p>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</p>
      <p class="footer__legal"><a href="/privacy/">Privacy policy</a><span aria-hidden="true">|</span><a href="/cancellation-policy/">Cancellation policy</a></p>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--s-500); color: var(--on-dark-2); -webkit-font-smoothing: antialiased; }
  .footer a { color: inherit; text-decoration: underline 1px transparent; text-underline-offset: 4px; transition: color var(--dur-1), text-decoration-color var(--dur-1); }
  .footer a:hover { color: #fff; text-decoration-color: currentColor; }
  .footer ul { list-style: none; padding: 0; }

  .footer__main { display: grid; gap: var(--space-12); padding-block: var(--space-16) var(--space-12); }

  /* Left: logo, one line, contact details, social */
  .footer__us { display: grid; justify-items: start; align-content: start; }
  .footer__logo { display: block; }
  .footer__logo :global(.logo) { width: 200px; }
  .footer__contact { display: grid; gap: var(--space-2); margin-top: var(--space-8); }
  .footer__contact a { color: #fff; text-decoration: underline 1px rgb(255 255 255 / .4); text-underline-offset: 3px; transition: text-decoration-color var(--dur-1); }
  @media (hover: hover) { .footer__contact a:hover { text-decoration-color: var(--p-500); } }
  .footer__us > .footer__h { margin: var(--space-8) 0 0; }
  /* Social icons in outlined circles, 12px under their title */
  .footer__us :global(.social) { gap: var(--space-3); margin: var(--space-3) 0 0; }
  .footer__us :global(.social a) { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 1px solid rgb(255 255 255 / .32); border-radius: var(--r-full); font-size: 18px; color: #fff; transition: border-color var(--dur-1), background-color var(--dur-1); }
  .footer__us :global(.social a:not([aria-disabled]):hover) { border-color: #fff; background: rgb(255 255 255 / .08); }

  /* Right: four columns (two by two on phones) */
  .footer__cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-10) var(--space-6); }
  .footer__h { margin-bottom: var(--space-4); color: #fff; }
  .footer__cols ul { display: grid; }
  .footer__cols a { display: inline-block; padding-block: var(--space-2); }
  /* The outside-link arrow stays with the last word when a name wraps */
  .ext { white-space: nowrap; }
  .ext :global(.icon) { display: inline-block; margin-left: var(--space-1); font-size: 11px; opacity: .7; }

  /* Bottom bar: copyright left, policies right */
  .footer__bar { background: var(--s-800); }
  .footer__bar .container { display: grid; gap: var(--space-2); padding-block: var(--space-4) calc(var(--space-4) + env(safe-area-inset-bottom)); }
  .footer__legal { display: flex; align-items: center; gap: var(--space-3); }
  .footer__legal a { display: inline-block; padding-block: var(--space-2); }
  .footer__legal span { opacity: .4; }

  @media (min-width: 768px) {
    .footer__cols { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .footer__bar .container { grid-template-columns: minmax(0, 1fr) auto; align-items: center; }
  }
  @media (min-width: 1024px) {
    .footer__main { grid-template-columns: 4fr 8fr; column-gap: var(--space-16); padding-block: var(--space-20) var(--space-16); }
    .footer__cols a { padding-block: var(--space-1); }
  }
</style>
