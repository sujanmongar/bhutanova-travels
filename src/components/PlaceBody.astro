---
// Body of a destination or sight page. The reading column: key facts (label over value, so each one says something
// concrete), then the article with its photos and links and the photo credit; WithSidebar adds the share row and,
// from 1200px, the plan card beside it.
import WithSidebar from './WithSidebar.astro';
import FactList, { type Fact } from './FactList.astro';
interface Props { facts: Fact[]; credit?: { text: string; url?: string }; place: string; shareTitle: string }
const { facts, credit, place, shareTitle } = Astro.props;
---
<WithSidebar class="layout" share={shareTitle} plan={{ title: `Plan a trip to ${place}`, topic: place }}>
  {facts.length > 0 && <FactList facts={facts} />}
  <slot />
  {credit && <p class="credit t-caption subtle">Photo: {credit.url ? <a href={credit.url} target="_blank" rel="noopener">{credit.text}<span class="sr-only"> (opens in a new tab)</span></a> : credit.text}</p>}
</WithSidebar>
<style>
  .layout { padding-block: var(--stack) var(--section); }

  /* Key facts (FactList) between hairlines; the column shares the text's measure */
  .keyfacts, .credit { max-width: 64ch; }
  .keyfacts { margin: 0 0 var(--space-10); padding: var(--space-6) 0; border-block: 1px solid var(--border); }

  .credit { margin-top: var(--space-8); }
</style>
