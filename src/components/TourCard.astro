---
import type { CollectionEntry } from 'astro:content';
import { img, srcset } from '../config';
interface Props { tour: CollectionEntry<'tours'>; eager?: boolean }
const { tour, eager } = Astro.props;
const t = tour.data;
---
<article class="tc">
  <div class="tc__img">
    <img src={img(t.image, 800)} srcset={srcset(t.image, [400, 600, 800])} sizes="(min-width:1200px) 360px, (min-width:768px) 45vw, 84vw"
      alt="" width="800" height="600" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
  <h3><a href={`/tours/${tour.id}/`}>{t.title}</a></h3>
  <p class="tc__foot">
    <span>{t.days} days · {t.nights} nights</span>
    <span class="num">From <b>USD {t.price.toLocaleString('en-US')}</b></span>
  </p>
</article>
<style>
  .tc { position: relative; display: flex; flex-direction: column; height: 100%; }
  .tc__img { aspect-ratio: 4 / 3; margin-bottom: 16px; border-radius: var(--radius); background: var(--s-50); overflow: hidden; clip-path: inset(0 round var(--radius)); }
  .tc__img img { width: 100%; height: 100%; object-fit: cover; transition: scale var(--dur-4) var(--ease-out); }
  .tc h3 { margin-bottom: 10px; }
  .tc h3 a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .tc h3 a:focus-visible { outline: none; }
  .tc:has(h3 a:focus-visible) { outline: 2px solid var(--s-500); outline-offset: 6px; border-radius: var(--radius); }
  .tc__foot {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: auto; padding-top: 12px;
    border-top: 1px solid var(--border); font-size: var(--fs-small); line-height: var(--lh-small); color: var(--text-2);
  }
  .tc__foot b { font-weight: 600; color: var(--ink); }
  @media (hover: hover) {
    .tc:hover .tc__img img { scale: 1.03; }
    .tc:hover h3 a { text-decoration: underline 1.5px var(--p-500); text-underline-offset: 5px; }
  }
</style>
