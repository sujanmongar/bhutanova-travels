---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { img, srcset } from '../config';
interface Props { tour: CollectionEntry<'tours'>; eager?: boolean }
const { tour, eager } = Astro.props;
const t = tour.data;

// What's included, read from the tour's own inclusions so the icons never disagree with the tour page.
const has = (re: RegExp) => t.inclusions.some((x) => re.test(x));
const included = ([
  ['identification-card', 'Bhutan visa', /visa/i],
  ['compass', 'Licensed guide', /guide/i],
  ['bed', 'Hotels', /hotel|lodge|accommodation|homestay|room/i],
  ['tent', 'Camping gear', /camping|tent/i],
  ['fork-knife', 'All meals', /meal/i],
  ['car', 'Private transport', /vehicle|transport/i],
  ['ticket', 'Entry fees', /entry fee|monument/i],
] as const).filter(([, , re]) => has(re)).slice(0, 6);
---
<article class="tc">
  <div class="tc__img">
    <img src={img(t.image, 800)} srcset={srcset(t.image, [400, 600, 800])} sizes="(min-width:1200px) 360px, (min-width:768px) 45vw, 84vw"
      alt="" width="800" height="600" loading={eager ? 'eager' : 'lazy'} decoding="async" />
    {included.length > 0 && (
      <ul class="tc__inc" aria-label="Included">
        {included.map(([icon, label]) => <li title={label}><Icon name={`ph_${icon}`} label={label} /></li>)}
      </ul>
    )}
  </div>
  <h3 class="t-h3"><a href={`/tours/${tour.id}/`}>{t.title}</a></h3>
  <p class="tc__meta">
    <span><Icon name="ph_currency-dollar" /><span class="sr-only">Price </span>From <b class="num">{t.price.toLocaleString('en-US')}</b><span class="sr-only"> US dollars</span></span>
    <span><Icon name="ph_clock" />{t.nights} nights / {t.days} days</span>
  </p>
</article>
<style>
  .tc { position: relative; display: flex; flex-direction: column; height: 100%; }
  .tc__img { position: relative; aspect-ratio: 4 / 3; margin-bottom: 18px; border-radius: var(--radius); background: var(--s-50); overflow: hidden; clip-path: inset(0 round var(--radius)); isolation: isolate; }
  .tc__img img { width: 100%; height: 100%; object-fit: cover; transition: scale var(--dur-4) var(--ease-out); }
  .tc__img::after { content: ''; position: absolute; inset: 55% 0 0; background: linear-gradient(transparent, rgb(12 25 37 / .55)); pointer-events: none; }
  .tc__inc { position: absolute; z-index: 1; left: 0; right: 0; bottom: 14px; display: flex; justify-content: center; gap: 14px; list-style: none; margin: 0; padding: 0; color: #fff; font-size: 17px; }
  .tc__inc li { display: grid; }
  .tc h3 a::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .tc h3 a:focus-visible { outline: none; }
  .tc:has(h3 a:focus-visible) { outline: 2px solid var(--s-500); outline-offset: 6px; border-radius: var(--radius); }
  .tc__meta { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: auto; padding-top: 10px; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--text-2); }
  .tc__meta > span { display: inline-flex; align-items: center; gap: 6px; }
  .tc__meta :global(.icon) { font-size: 16px; color: var(--ink); }
  .tc__meta b { font-weight: 600; color: var(--ink); }
  @media (hover: hover) {
    .tc:hover .tc__img img { scale: 1.04; }
    .tc:hover h3 a { text-decoration: underline 1.5px var(--p-500); text-underline-offset: 6px; }
  }
</style>
