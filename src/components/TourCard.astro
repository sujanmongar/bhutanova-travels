---
import type { CollectionEntry } from 'astro:content';
import { img, srcset } from '../config';
import { nextFestival, tourPath } from '../utils';
interface Props { tour: CollectionEntry<'tours'>; eager?: boolean; rail?: boolean }
const { tour, eager, rail } = Astro.props;
// The photo frame is the same height on every card site-wide (--card-photo: 240px phones, 270px from 768px), whatever
// the card's width; the CDN's 4:3 crop is drawn at the frame's width, or 360px (270 × 4/3) when the frame is narrower,
// so sizes is the larger of the two and nothing gets upscaled.
// Rail: 2-up from 768px, 3-up from 1200px. Grid: 1 → 2 → 3 columns (768 / 1024px).
const sizes = rail
  ? '(min-width:1200px) 384px, (min-width:808px) calc(50vw - 44px), (min-width:412px) 360px, calc(100vw - 52px)'
  : '(min-width:1200px) 384px, (min-width:1024px) 360px, (min-width:808px) calc(50vw - 44px), (min-width:768px) 360px, calc(100vw - 32px)';
const t = tour.data;
// Festival tours show when their next festival is, the one thing a festival-goer checks first
const festival = nextFestival(t.festivalDates);
---
<article class="tc">
  <div class="tc__img">
    <img src={img(t.image, 800, 600)} srcset={srcset(t.image, [400, 600, 800, 1000, 1200], 4 / 3)} sizes={sizes}
      alt="" width="800" height="600" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
  <h3 class="tc__title t-card"><a href={tourPath(tour)}>{t.title}</a></h3>
  <p class="tc__meta t-body">{t.days} days · from <b class="num">${t.price.toLocaleString('en-US')}</b> per person</p>
  {festival && <p class="tc__fest t-label">Next festival: <time datetime={festival.start}>{festival.label}</time></p>}
</article>
<style>
  .tc { position: relative; display: flex; flex-direction: column; height: 100%; }
  .tc__img { position: relative; height: var(--card-photo); margin-bottom: var(--space-4); border-radius: var(--radius); corner-shape: squircle; background: var(--s-50); overflow: hidden; isolation: isolate; }
  @supports not (corner-shape: squircle) { .tc__img { clip-path: inset(0 round var(--radius)); } }
  .tc__img img { width: 100%; height: 100%; object-fit: cover; transition: scale var(--dur-4) var(--ease-out); }
  .tc h3 a::after { content: ''; position: absolute; inset: 0; z-index: 2; }
  .tc h3 a:focus-visible { outline: none; }
  .tc:has(h3 a:focus-visible) { outline: 2px solid var(--s-500); outline-offset: 6px; border-radius: var(--radius); corner-shape: squircle; }
  /* "8 days · from $1,690 per person" at body size, price bold; sits at the bottom so it lines up across a row of cards. */
  .tc__meta { margin-top: auto; padding-top: var(--space-2); color: var(--text-2); }
  .tc__meta b { font-weight: 600; color: var(--ink); }
  .tc__fest { margin-top: var(--space-1); color: var(--text-2); }
  @media (hover: hover) {
    .tc:hover .tc__img img { scale: 1.02; }
    .tc:hover h3 a { text-decoration: underline 1.5px var(--p-500); text-underline-offset: 6px; }
  }
</style>
