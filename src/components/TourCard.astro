---
// A tour as a Card: its photo, name, then "8 days · from $1,690 per person" (Body, price bold) at the card's foot.
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import { tourPath, usd } from '../utils';
interface Props { tour: CollectionEntry<'tours'>; eager?: boolean; rail?: boolean }
const { tour, eager, rail } = Astro.props;
const t = tour.data;
---
<Card href={tourPath(tour)} image={t.image} title={t.title} rail={rail} eager={eager}>
  <Fragment slot="meta">{t.days} days · from <b class="num">{usd(t.price)}</b> per person</Fragment>
</Card>
