---
// "Tours that visit …" as a swipe rail, for destination and sight pages. A place no set tour visits yet shows the tours
// of the places near it ("Tours near …") with one line saying so. No enquiry card here: the page already has the plan
// card beside the text and the closing contact card, and one ask while reading plus one at the end is enough.
import type { CollectionEntry } from 'astro:content';
import Section from './Section.astro';
import TourCard from './TourCard.astro';
import { TOURS } from '../utils';
interface Props { place: string; tours: CollectionEntry<'tours'>[]; near?: CollectionEntry<'tours'>[]; grey?: boolean }
const { place, tours, near = [], grey = false } = Astro.props;
const list = tours.length ? tours : near;
---
{list.length > 0 && (
  <Section heading={tours.length ? `Tours that visit ${place}` : `Tours near ${place}`} text={tours.length ? undefined : `${place} isn't on a set tour yet. These tours pass close by, and any of them can include it.`}
    grey={grey} link={{ href: TOURS, label: 'All tours' }} rail="place-tours" railLabel="tours">
    {list.map((t) => <TourCard tour={t} rail />)}
  </Section>
)}
