---
// The photo behind a page banner (.banner). Phones get a 4:5 crop from the CDN (the banner is taller than wide there),
// kept around the editor's focal point when there is one; tablets/desktops get the landscape photo. It is the page's LCP image.
import { img, srcset, focal } from '../config';
interface Props { src: string; alt?: string; hotspot?: { x: number; y: number } }
const { src, alt = '', hotspot } = Astro.props;
const pos = hotspot && focal(hotspot);
---
<picture>
  <source media="(max-width: 767px) and (orientation: portrait)" sizes="100vw" srcset={srcset(src, [480, 800, 1200], 4 / 5, hotspot)} />
  <img src={img(src, 1600)} srcset={srcset(src, [800, 1200, 1600, 2000, 2400])} sizes="100vw" alt={alt} width="1600" height="700"
    fetchpriority="high" decoding="async" style={pos ? `object-position:${pos}` : undefined} />
</picture>
