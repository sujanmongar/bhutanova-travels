---
// Renders a page-builder page: one component per Sanity block type, in the editor's order.
// Sections are direct children of <main> so the shared spacing and transparent-header rules still apply.
import Hero from './blocks/Hero.astro';
import PageBanner from './blocks/PageBanner.astro';
import Intro from './blocks/Intro.astro';
import Reasons from './blocks/Reasons.astro';
import StoryRows from './blocks/StoryRows.astro';
import RichText from './blocks/RichText.astro';
import TourRail from './blocks/TourRail.astro';
import CategoryTiles from './blocks/CategoryTiles.astro';
import LatestPosts from './blocks/LatestPosts.astro';
import Reviews from './blocks/Reviews.astro';
import FaqBlock from './blocks/FaqBlock.astro';
import BookingSteps from './blocks/BookingSteps.astro';
import Partners from './blocks/Partners.astro';
import CtaBanner from './CtaBanner.astro';
import WhatsAppCta from './WhatsAppCta.astro';
import GithubSlugger from 'github-slugger';

interface Props { sections: Array<Record<string, any>>; title: string }
const { sections, title } = Astro.props;
// One H1 per page: banners and the hero carry it; otherwise add a hidden one so search engines still get it.
const hasH1 = ['pageBanner', 'hero'].includes(sections[0]?._type);
// Heading ids from every Text block share one counter (and skip ids the layout already uses), so anchors stay unique.
const slugger = new GithubSlugger();
['main', 'drawer', 'plan', 'whatsapp', 'rail-quotes'].forEach((id) => slugger.slug(id));

const blocks: Record<string, any> = { hero: Hero, pageBanner: PageBanner, intro: Intro, reasons: Reasons, storyRows: StoryRows, richText: RichText, tourRail: TourRail, categoryTiles: CategoryTiles, latestPosts: LatestPosts, reviewList: Reviews, bookingSteps: BookingSteps, faqList: FaqBlock, partners: Partners };
// The two older components take slightly different prop names.
const cta = (b: any) => ({ title: b.heading, text: b.text ?? '', cta: b.buttonLabel, href: b.buttonLink, image: b.image?.url, hotspot: b.image?.hotspot });
const whatsapp = (b: any) => ({ title: b.heading, ...(b.text && { text: b.text }), about: b.topic, id: 'whatsapp' });
---
{!hasH1 && <h1 class="sr-only">{title}</h1>}
{sections.map((b) => {
  if (b._type === 'ctaBanner') return <CtaBanner {...cta(b)} />;
  if (b._type === 'whatsapp') return <WhatsAppCta {...whatsapp(b)} />;
  const Block = blocks[b._type];
  return Block ? <Block {...b} pageTitle={title} slugger={slugger} /> : null;
})}
