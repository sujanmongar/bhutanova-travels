---
import Icon from './Icon.astro';
import { SITE, wa, tel } from '../config';
interface Props { title?: string; text?: string; about?: string; id?: string }
const {
  title = 'Not sure which trip fits?',
  text = 'Message a planner in Thimphu on WhatsApp. We usually reply within the hour.',
  about,
  id = 'whatsapp',
} = Astro.props;
// The chat opens with this page's link (and this section's anchor) already in the message.
const chat = wa(`${new URL(Astro.url.pathname, Astro.site).href}#${id}`, about);
---
<section class="section wa" id={id}>
  <div class="container">
    <div class="wa__card" data-reveal>
      <div class="wa__txt">
        <h2>{title}</h2>
        <p class="t-body">{text}</p>
      </div>
      <div class="wa__act">
        <a class="wa__num" href={chat} target="_blank" rel="noopener">
          <span class="wa__ic" aria-hidden="true"><Icon name="social_whatsapp" /></span>
          <span class="num">{SITE.phone}</span>
          <span class="sr-only"> — open a WhatsApp chat (new tab)</span>
        </a>
        <a class="wa__link t-link" href={chat} target="_blank" rel="noopener">Chat on WhatsApp<Icon name="arrow-up-right" /></a>
        <p class="wa__alt t-caption">Or call <a href={tel(SITE.phoneAlt)}>{SITE.phoneAlt}</a> · <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
    </div>
  </div>
</section>
<style>
  .wa__card {
    display: grid; gap: var(--space-8); padding: var(--space-8) var(--space-6); border-radius: var(--radius); corner-shape: squircle; background: var(--s-500); color: #fff;
    -webkit-font-smoothing: antialiased; --focus: #fff;
  }
  .wa__txt h2 { color: #fff; max-width: 18ch; }
  .wa__txt p { margin-top: var(--space-3); max-width: 40ch; color: var(--on-dark-2); }
  .wa__act { display: grid; justify-items: start; gap: var(--space-2); }
  .wa__num {
    display: inline-flex; align-items: center; gap: var(--space-4); min-height: 56px;
    font-family: var(--ff); font-size: var(--fs-price); line-height: var(--lh-price); letter-spacing: var(--ls-price); font-weight: var(--fw-price); color: #fff; white-space: nowrap;
    transition: color var(--dur-1);
  }
  .wa__ic { display: grid; place-items: center; flex: none; width: 52px; height: 52px; border-radius: 50%; background: #25d366; color: #fff; font-size: 28px; transition: scale var(--dur-2) var(--ease-out); }
  .wa__link {
    display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; color: #fff;
    text-decoration: underline 1.5px rgb(255 255 255 / .5); text-underline-offset: 6px; transition: color var(--dur-1), text-decoration-color var(--dur-2);
  }
  .wa__link :global(.icon) { font-size: 12px; transition: translate var(--dur-2) var(--ease-out); }
  .wa__alt { color: var(--on-dark-3); }
  /* 44px tap targets; underlined on touch screens, where there is no hover to reveal them as links */
  .wa__alt a { display: inline-flex; align-items: center; min-height: 44px; color: var(--on-dark-2); text-decoration: underline 1px currentColor; text-underline-offset: 4px; }
  @media (hover: hover) {
    .wa__alt a { text-decoration-color: transparent; }
    .wa__alt a:hover { color: #fff; text-decoration-color: currentColor; }
    .wa__num:hover { color: var(--p-500); }
    .wa__num:hover .wa__ic { scale: 1.06; }
    .wa__link:hover { color: #fff; text-decoration-color: #fff; }
    .wa__link:hover :global(.icon) { translate: 2px -2px; }
  }
  @media (max-width: 400px) { .wa__num { font-size: var(--fs-h5); line-height: var(--lh-h5); letter-spacing: var(--ls-h5); gap: var(--space-3); } .wa__ic { width: 44px; height: 44px; font-size: 24px; } }
  @media (min-width: 768px) { .wa__card { padding: var(--space-12); } }
  @media (min-width: 1024px) {
    .wa__card { grid-template-columns: 1fr auto; align-items: center; gap: var(--space-16); padding: var(--space-16); }
  }
</style>
