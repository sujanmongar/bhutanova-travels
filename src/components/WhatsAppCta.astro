---
// The closing "talk to us" card on every page: the full-width version of the sidebar support card (PlanCta), navy.
// Heading and a line on the left; on the right the trip planner (the Team member picked in the homepage's "Plan your
// trip" section; left out while it's a sample profile), WhatsApp, a second button, phone and email.
// Sanity's WhatsApp card and Call to action blocks render it.
import TalkPanel from './TalkPanel.astro';
import { SITE, tel, mailto } from '../config';
interface Props { title?: string; text?: string; about?: string; id?: string; cta?: string; href?: string; customise?: string }
const {
  title = 'Not sure which trip fits?',
  text = `Message us on WhatsApp. ${SITE.promise}`,
  about,
  id = 'whatsapp',
  cta = 'Send an enquiry',
  href = '/contact/',
  customise,  // a tour id: the enquiry form opens with that tour filled in
} = Astro.props;
---
<section class="section wa" id={id}>
  <div class="container">
    <div class="wa__card" data-reveal>
      <div class="wa__txt">
        <h2>{title}</h2>
        {text && <p class="t-body">{text}</p>}
      </div>
      <div class="wa__talk">
        <TalkPanel layout="row" anchor={id} about={about}
          enquiry={{ label: cta, href: href === '/contact/' ? undefined : href, tour: customise, title: customise ? 'Enquire about this tour' : undefined }}>
          <p class="wa__alt t-label"><span>Or call <a href={tel(SITE.phone)}>{SITE.phone}</a></span><span class="wa__dot" aria-hidden="true"> · </span><span><a href={mailto()}>{SITE.email}</a></span></p>
          {SITE.hours && <p class="wa__alt t-label">{SITE.hours}</p>}
        </TalkPanel>
      </div>
    </div>
  </div>
</section>
<style>
  .wa__card {
    display: grid; gap: var(--space-10); padding: var(--space-10) var(--space-6); border-radius: var(--radius); corner-shape: squircle;
    background: var(--s-500); color: var(--on-dark); -webkit-font-smoothing: antialiased; --focus: var(--on-dark);
  }
  .wa__txt h2 { max-width: 18ch; color: var(--on-dark); }
  .wa__txt p { margin-top: var(--space-4); max-width: 44ch; color: var(--on-dark-2); }
  .wa__talk { display: grid; gap: var(--space-4); justify-items: start; }
  .wa__alt { color: var(--on-dark-2); }
  /* 44px tap targets for the phone and email */
  .wa__alt a { display: inline-flex; align-items: center; min-height: 44px; }
  /* Phone and email on their own lines at every width, so no line ever ends in a dot */
  .wa__alt span:not(.wa__dot) { display: block; } .wa__dot { display: none; }
  @media (min-width: 768px) { .wa__card { padding: var(--space-12); } }
  /* Laptops: two even halves, so the planner and both buttons fit on one line each */
  @media (min-width: 1024px) { .wa__card { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-12); align-items: center; } }
  @media (min-width: 1200px) { .wa__card { grid-template-columns: 7fr 5fr; gap: var(--space-16); padding: var(--space-16); } }
</style>
