---
import Form from './Form.astro';
---
<section class="cb section section--grey">
  <div class="container cb__in">
    <div>
      <h2>Not sure which trip fits?</h2>
      <p>Leave your number and a planner in Thimphu will call you back within a day.</p>
    </div>
    <Form subject="Callback request" class="cb__form">
      <div class="field"><label for="cb-name">Name</label><input class="input" id="cb-name" name="name" autocomplete="name" required /></div>
      <div class="field"><label for="cb-email">Email</label><input class="input" id="cb-email" name="email" type="email" autocomplete="email" required /></div>
      <div class="field"><label for="cb-phone">Phone</label><input class="input" id="cb-phone" name="phone" type="tel" autocomplete="tel" required /></div>
      <button class="btn btn--primary">Call me back</button>
    </Form>
  </div>
</section>
<style>
  .cb__in { display: grid; gap: 28px; }
  .cb p { margin-top: 12px; max-width: 44ch; font-size: var(--fs-lead); line-height: var(--lh-lead); color: var(--text-2); }
  .cb :global(.cb__form) { display: grid; gap: 14px; align-items: end; }
  @media (min-width: 768px) { .cb :global(.cb__form) { grid-template-columns: 1fr 1fr; } .cb :global(.cb__form) .btn { align-self: end; } }
  @media (min-width: 1200px) { .cb__in { grid-template-columns: 4fr 7fr; gap: 64px; align-items: end; } .cb :global(.cb__form) { grid-template-columns: 1fr 1fr 1fr auto; } }
</style>
