---
import Form from './Form.astro';
---
<section class="cb section--grey">
  <div class="container">
    <h2>Not sure which package to pick for Bhutan?</h2>
    <p>Talk to our trip experts now to get the best deal!</p>
    <Form subject="Callback request" class="cb__form">
      <label class="sr-only" for="cb-name">Your name</label>
      <input class="input" id="cb-name" name="name" placeholder="Your Name" autocomplete="name" required />
      <label class="sr-only" for="cb-email">Email address</label>
      <input class="input" id="cb-email" name="email" type="email" placeholder="Email Address" autocomplete="email" required />
      <label class="sr-only" for="cb-phone">Mobile</label>
      <input class="input" id="cb-phone" name="phone" type="tel" placeholder="Mobile" autocomplete="tel" required />
      <button class="btn btn--primary">Get Callback</button>
    </Form>
  </div>
</section>
<style>
  .cb { padding-block: 48px; text-align: center; }
  .cb p { margin: 8px 0 24px; color: var(--text-2); }
  .cb :global(.cb__form) { display: grid; gap: 12px; }
  @media (min-width: 768px) { .cb { padding-block: 56px; } .cb :global(.cb__form) { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1200px) { .cb :global(.cb__form) { grid-template-columns: 1fr 1fr 1fr auto; gap: 10px; } }
</style>
