---
import type { CollectionEntry } from 'astro:content';
import { img, srcset } from '../config';
interface Props { post: CollectionEntry<'blog'> | CollectionEntry<'guides'>; base?: string }
const { post, base = '/blog/' } = Astro.props;
const d = post.data;
const href = `${base}${post.id}/`;
const meta = 'group' in d ? d.group : [d.tags[0], d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })].filter(Boolean).join(' · ');
---
<article class="bc">
  <div class="bc__img">
    <img src={img(d.image, 800)} srcset={srcset(d.image, [400, 600, 800])} sizes="(min-width:1200px) 360px, (min-width:768px) 45vw, 84vw"
      alt="" width="800" height="533" loading="lazy" decoding="async" />
  </div>
  <p class="bc__meta">{meta}</p>
  <h3><a href={href}>{d.title}</a></h3>
  <p class="bc__ex">{d.excerpt}</p>
</article>
<style>
  .bc { position: relative; display: flex; flex-direction: column; height: 100%; }
  .bc__img { aspect-ratio: 3 / 2; margin-bottom: 16px; border-radius: var(--radius); background: var(--s-50); overflow: hidden; clip-path: inset(0 round var(--radius)); }
  .bc__img img { width: 100%; height: 100%; object-fit: cover; transition: scale var(--dur-4) var(--ease-out); }
  .bc__meta { font-size: var(--fs-xs); color: var(--text-3); }
  .bc h3 { margin: 6px 0 8px; font-size: 1.25rem; line-height: 1.3; letter-spacing: -.012em; }
  .bc h3 a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .bc h3 a:focus-visible { outline: none; }
  .bc:has(h3 a:focus-visible) { outline: 2px solid var(--s-500); outline-offset: 6px; border-radius: var(--radius); }
  .bc__ex { font-size: var(--fs-sm); line-height: var(--lh-sm); color: var(--text-2); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  @media (hover: hover) {
    .bc:hover .bc__img img { scale: 1.03; }
    .bc:hover h3 a { text-decoration: underline 1.5px var(--p-500); text-underline-offset: 5px; }
  }
</style>
