---
// An article or a travel guide as a Card: the topic (guides) or tag and date (articles) over the title, then the excerpt.
// rail: in a swipe row; list: a thumbnail row on phones (the travel guide index).
import type { CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import { topicName } from '../utils';
interface Props { post: CollectionEntry<'blog'> | CollectionEntry<'guides'>; base?: string; rail?: boolean; list?: boolean }
const { post, base = '/blog/', rail = false, list = false } = Astro.props;
const d = post.data;
const meta = 'group' in d ? topicName(d.group) : [d.tags[0], d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })].filter(Boolean).join(' · ');
---
<Card href={`${base}${post.id}/`} image={d.image} title={d.title} eyebrow={meta} text={d.excerpt} rail={rail} list={list} />
