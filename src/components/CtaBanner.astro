---
import Icon from './Icon.astro';
import { SITE, img, srcset, wa } from '../config';
const {
  title = 'Your Bhutan journey starts with a conversation',
  text = 'Tell us when you would like to travel and what draws you to Bhutan. A trip planner in Thimphu will reply within a day with ideas and a clear quote.',
  cta = 'Start planning',
  href = '/contact/',
  image = 'photo-1662547150045-7a8d3a9ad0b2',
} = Astro.props;
---
<section class="cta" id="plan">
  <img src={img(image, 1600)} srcset={srcset(image)} sizes="100vw" alt="" width="1600" height="900" loading="lazy" decoding="async" />
  <div class="container cta__in" data-reveal>
    <h2>{title}</h2>
    <p>{text}</p>
    <div class="cta__act">
      <a class="btn btn--light btn--lg" href={href}>{cta}<Icon name="arrow-right" class="i-end" /></a>
      <a class="cta__tel" href={wa(`${new URL(Astro.url.pathname, Astro.site).href}#plan`)} target="_blank" rel="noopener"><Icon name="social_whatsapp" />{SITE.phone}</a>
    </div>
  </div>
</section>
<style>
  .cta { position: relative; isolation: isolate; overflow: hidden; background: var(--s-800); color: #fff; padding-block: 96px; -webkit-font-smoothing: antialiased; --focus: #fff; }
  .cta > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .cta::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(12 25 37 / .88), rgb(12 25 37 / .55) 60%, rgb(12 25 37 / .25)); }
  .cta h2 { max-width: 24ch; color: #fff; }
  .cta p { margin: 18px 0 32px; max-width: 48ch; font-size: var(--fs-lead); line-height: var(--lh-lead); color: rgb(255 255 255 / .85); }
  .cta__act { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
  .cta__tel { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; color: #fff; text-decoration: underline 1px rgb(255 255 255 / .4); text-underline-offset: 6px; }
  .cta__tel:hover { text-decoration-color: #fff; }
  @media (min-width: 1200px) { .cta { padding-block: 136px; } }
</style>
