---
import Icon from './Icon.astro';
import { SITE, img, srcset, wa } from '../config';
const {
  title = 'Your Bhutan journey starts with a conversation',
  text = 'Tell us when you would like to travel and what draws you to Bhutan. A trip planner in Thimphu will reply within a day with ideas and a clear quote.',
  cta = 'Plan a trip',
  href = '/contact/',
  image = 'photo-1662547150045-7a8d3a9ad0b2',
  position,
} = Astro.props;
---
<section class="section cta" id="plan">
  <div class="container">
    <div class="cta__card" data-reveal>
      <img src={img(image, 1600)} srcset={srcset(image)} sizes="(min-width:1200px) 1120px, 100vw" alt="" width="1600" height="900"
        loading="lazy" decoding="async" style={position && `object-position:${position}`} />
      <div class="cta__in">
        <h2>{title}</h2>
        {text && <p>{text}</p>}
        <div class="cta__act">
          <a class="btn btn--light btn--lg" href={href}>{cta}<Icon name="arrow-right" class="i-end" /></a>
          <a class="btn btn--on-dark btn--lg" href={wa(`${new URL(Astro.url.pathname, Astro.site).href}#plan`)} target="_blank" rel="noopener">
            <Icon name="social_whatsapp" />{SITE.phone}<span class="sr-only"> on WhatsApp (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  /* An inset photo card: rounded, content centred, the photo settling in as it scrolls into view */
  .cta__card {
    position: relative; isolation: isolate; overflow: hidden; display: grid; place-items: center; min-height: 500px;
    padding: 64px 22px; border-radius: var(--r-xl); background: var(--s-800); color: #fff; text-align: center;
    -webkit-font-smoothing: antialiased; --focus: #fff;
  }
  .cta__card > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .cta__card::after { content: ''; position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(120% 95% at 50% 55%, rgb(12 25 37 / .42), rgb(12 25 37 / .74)), linear-gradient(rgb(12 25 37 / .1), rgb(12 25 37 / .3)); }
  .cta__in { display: grid; justify-items: center; max-width: 720px; }
  .cta h2 { max-width: 20ch; color: #fff; font-size: var(--fs-h1); line-height: var(--lh-h1); letter-spacing: var(--ls-h1); text-wrap: balance; }
  .cta p { margin-top: 18px; max-width: 50ch; font-size: var(--fs-lead); line-height: var(--lh-lead); color: rgb(255 255 255 / .86); text-wrap: pretty; }
  .cta__act { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 14px; margin-top: 32px; }
  .cta__act :global(.icon) { font-size: 18px; }
  @media (max-width: 479px) { .cta__act { width: 100%; } .cta__act .btn { width: 100%; } }
  @media (min-width: 768px) { .cta__card { min-height: 520px; padding: 80px 48px; } }
  @media (min-width: 1200px) { .cta__card { min-height: 560px; } }
  @media (prefers-reduced-motion: no-preference) {
    .cta__card > img { scale: 1.08; transition: scale 1.8s var(--ease-out); }
    .cta__card:global(.is-in) > img { scale: 1; }
  }
</style>
