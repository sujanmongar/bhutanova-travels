---
import Icon from './Icon.astro';
import { SITE, img, srcset, focal, wa } from '../config';
const {
  title = 'Your Bhutan journey starts with a conversation',
  text = 'Tell us when you would like to travel and what draws you to Bhutan. A trip planner in Thimphu will reply within 24 hours with ideas and a clear quote.',
  cta = 'Enquire',
  href = '/contact/',
  image = 'photo-1662547150045-7a8d3a9ad0b2',
  hotspot,
} = Astro.props;
---
<section class="section cta" id="plan">
  <div class="container">
    <div class="cta__card" data-reveal>
      {/* Phones: the card is portrait (about 343 × 550), so the CDN sends a 3:5 crop; from 768px, the landscape photo */}
      <picture>
        <source media="(max-width: 479px)" sizes="calc(100vw - 32px)" srcset={srcset(image, [400, 800, 1200], 3 / 5, hotspot)} />
        <img src={img(image, 1600)} srcset={srcset(image)} sizes="(min-width:1264px) 1200px, calc(100vw - 64px)" alt="" width="1600" height="900"
          loading="lazy" decoding="async" style={hotspot && `object-position:${focal(hotspot)}`} />
      </picture>
      <div class="cta__in">
        <h2>{title}</h2>
        {text && <p class="t-body">{text}</p>}
        <div class="cta__act">
          <a class="btn btn--light btn--lg" href={href}>{cta}</a>
          <a class="btn btn--on-dark btn--lg" href={wa(`${new URL(Astro.url.pathname, Astro.site).href}#plan`)} target="_blank" rel="noopener">
            <Icon name="social_whatsapp" />{SITE.phone}<span class="sr-only"> on WhatsApp (opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  /* An inset photo card: rounded, content centred, the photo settling in as it scrolls into view */
  .cta__card {
    position: relative; isolation: isolate; overflow: hidden; display: grid; place-items: center; min-height: 500px;
    padding: var(--space-16) var(--space-6); border-radius: var(--radius); corner-shape: squircle; background: var(--s-800); color: #fff; text-align: center;
    -webkit-font-smoothing: antialiased; --focus: #fff;
  }
  .cta__card picture { display: contents; }  /* not a grid item, so the text stays centred in the card */
  .cta__card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .cta__card::after { content: ''; position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(120% 95% at 50% 55%, rgb(12 25 37 / .42), rgb(12 25 37 / .74)), linear-gradient(rgb(12 25 37 / .1), rgb(12 25 37 / .3)); }
  .cta__in { display: grid; justify-items: center; max-width: 720px; }
  .cta h2 { max-width: 20ch; color: #fff; text-wrap: balance; }
  .cta p { margin-top: var(--space-4); max-width: 50ch; color: #fff; text-wrap: pretty; }
  .cta__act { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3) var(--space-4); margin-top: var(--space-8); }
  .cta__act :global(.icon) { font-size: 18px; }
  @media (max-width: 479px) { .cta__act { width: 100%; } .cta__act .btn { width: 100%; } }
  @media (min-width: 768px) { .cta__card { min-height: 520px; padding: var(--space-20) var(--space-12); } }
  @media (min-width: 1200px) { .cta__card { min-height: 560px; } }
  @media (prefers-reduced-motion: no-preference) {
    .cta__card img { scale: 1.08; transition: scale 1.8s var(--ease-out); }
    .cta__card:global(.is-in) img { scale: 1; }
  }
</style>
