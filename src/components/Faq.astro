---
import { getEntry } from 'astro:content';
import { ldJson } from '../config';
const { items = (await getEntry('faqs', 'faqs'))?.data.items ?? [], open = 0 } = Astro.props;
const split = Astro.slots.has('default');
const schema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((f: { q: string; a: string }) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<div class:list={['faq', { 'faq--split': split }]}>
  {split && <div class="faq__head"><slot /></div>}
  <div class="faq__list">
    {items.map((f: { q: string; a: string }, i: number) => (
      <details open={i === open} name="faq">
        <summary><span>{f.q}</span><span class="faq__tog" aria-hidden="true"></span></summary>
        <p class="faq__a">{f.a}</p>
      </details>
    ))}
  </div>
</div>
<script type="application/ld+json" set:html={ldJson(schema)} />
<style>
  .faq { max-width: 820px; }
  .faq__list { border-bottom: 1px solid var(--border-dark); }
  details { border-top: 1px solid var(--border-dark); }
  summary {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; padding: 22px 0; cursor: pointer; list-style: none;
    font-family: var(--ff-display); font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: var(--ls-title); font-weight: 500; color: var(--ink); -webkit-tap-highlight-color: transparent;
    transition: color var(--dur-1);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--s-500); }
  .faq__tog { position: relative; flex: none; width: 14px; height: 14px; margin-top: .3em; color: var(--s-500); }
  .faq__tog::before, .faq__tog::after { content: ''; position: absolute; inset: 0; margin: auto; width: 14px; height: 1.5px; background: currentColor; }
  .faq__tog::after { rotate: 90deg; transition: rotate var(--dur-3) var(--ease-out); }
  details[open] .faq__tog::after { rotate: 0deg; }
  .faq__a { padding: 0 40px 24px 0; max-width: 64ch; font-size: var(--fs-body); line-height: var(--lh-body); color: var(--text); }
  .faq--split { max-width: none; display: grid; gap: 32px; }
  .faq__head :global(.sh) { margin-bottom: 0; }
  @media (min-width: 1024px) {
    .faq--split { grid-template-columns: 4fr 7fr; column-gap: 80px; align-items: start; }
    .faq__head { position: sticky; top: calc(var(--header-h) + 32px); }
  }
</style>
