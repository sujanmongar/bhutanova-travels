---
// The three newest posts in a row like the tour row: one on phones, two on tablets, three from 1200px (arrows only
// when there is more to see). Same card as the blog index.
import { getCollection } from 'astro:content';
import Section from '../Section.astro';
import BlogCard from '../BlogCard.astro';
interface Props { heading: string; grey?: boolean }
const { heading, grey = false } = Astro.props;
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
---
{posts.length > 0 && (
<Section heading={heading} grey={grey} link={{ href: '/blog/', label: 'All articles' }} rail="posts" railLabel="articles">
  {posts.map((p) => <BlogCard post={p} rail />)}
</Section>
)}
