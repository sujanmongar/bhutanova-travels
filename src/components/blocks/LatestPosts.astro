---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { img, srcset } from '../../config';
interface Props { heading: string; text?: string; grey?: boolean }
const { heading, text, grey = true } = Astro.props;
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const [lead, ...rest] = posts;
const short = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
{lead && (
<section class:list={['section', { 'section--grey': grey }]}>
  <div class="container">
    <div class="sh sh--row" data-reveal>
      <h2>{heading}</h2>
      {text && <p>{text}</p>}
      <div class="sh__act"><a class="link-more" href="/blog/">View all blogs<Icon name="arrow-right" /></a></div>
    </div>
    <div class="journal" data-reveal="stagger">
      <article class="journal__lead">
        <div class="journal__img"><img src={img(lead.data.image, 1000, 667)} srcset={srcset(lead.data.image, [480, 800, 1200, 1600], 3 / 2)}
          sizes="(min-width:1264px) 664px, (min-width:1024px) calc(58vw - 74px), (min-width:768px) calc(100vw - 64px), calc(100vw - 32px)" alt="" width="1000" height="667" loading="lazy" decoding="async" /></div>
        <p class="t-label subtle">{lead.data.tags[0]} · {short(lead.data.date)}</p>
        <h3 class="t-card"><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h3>
        <p class="journal__ex t-body muted">{lead.data.excerpt}</p>
      </article>
      <ul class="journal__list">
        {rest.slice(0, 3).map((p) => (
          <li>
            <article>
              <img src={img(p.data.image, 320, 240)} srcset={srcset(p.data.image, [160, 320, 480], 4 / 3)} sizes="(min-width:1024px) 160px, 112px"
                alt="" width="160" height="120" loading="lazy" decoding="async" />
              <div>
                <p class="t-label subtle">{p.data.tags[0]} · {short(p.data.date)}</p>
                <h3 class="t-card"><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
                <p class="journal__sum t-body muted">{p.data.excerpt}</p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
    <a class="link-more m-only" href="/blog/">View all blogs<Icon name="arrow-right" /></a>
  </div>
</section>
)}
<style>
  /* The featured post stays a step above the list beside it (card titles drop to h6 on desktop) */
  .journal__lead h3 { font-size: var(--fs-h5); line-height: var(--lh-h5); letter-spacing: var(--ls-h5); }
  /* Journal — one lead story + a short list */
  .journal { display: grid; gap: var(--space-8); }
  .journal__lead { position: relative; }
  .journal__img { aspect-ratio: 3 / 2; margin-bottom: var(--space-4); border-radius: var(--radius); corner-shape: squircle; overflow: hidden; background: var(--s-50); }
  @supports not (corner-shape: squircle) { .journal__img { clip-path: inset(0 round var(--radius)); } }
  .journal__img img { width: 100%; height: 100%; object-fit: cover; transition: scale var(--dur-4) var(--ease-out); }
  .journal h3 a::after { content: ''; position: absolute; inset: 0; }
  .journal__lead h3 { margin: var(--space-2) 0 var(--space-3); }
  /* Excerpts are cut with an ellipsis: 2 lines under the lead story, 2 under each post in the list */
  .journal__ex, .journal__sum { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
  .journal__ex { max-width: 56ch; }
  .journal__sum { margin-top: var(--space-3); }
  .journal__list { list-style: none; margin: 0; padding: 0; }
  .journal__list li { border-top: 1px solid var(--border-dark); }
  .journal__list li:last-child { border-bottom: 1px solid var(--border-dark); }
  /* Older posts: label → title 8, title → excerpt 12 inside a post; 16px above and below each post (24 on desktop) */
  .journal__list article { position: relative; display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: var(--space-4); align-items: start; padding-block: var(--space-4); }
  .journal__list img { width: 112px; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-sm); background: var(--s-50); }
  .journal__list h3 { margin-top: var(--space-2); }
  @media (hover: hover) {
    .journal__lead:hover img { scale: 1.03; }
    .journal article:hover h3 a { text-decoration: underline 1.5px var(--p-500); text-underline-offset: 5px; }
  }
  @media (min-width: 1024px) {
    .journal { grid-template-columns: 7fr 5fr; gap: var(--space-16); align-items: start; }
    .journal__list article { grid-template-columns: 128px minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-6); }
    .journal__list li:first-child article { padding-top: 0; }
    .journal__list li:first-child { border-top: 0; }
    .journal__list img { width: 128px; }
  }
  /* Bigger thumbnails once the list column has room for them */
  @media (min-width: 1200px) {
    .journal__list article { grid-template-columns: 160px minmax(0, 1fr); gap: var(--space-6); }
    .journal__list img { width: 160px; }
  }
</style>
