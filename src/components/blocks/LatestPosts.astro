---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { img, srcset } from '../../config';
interface Props { heading: string; text?: string; grey?: boolean }
const { heading, text, grey = true } = Astro.props;
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const [lead, ...rest] = posts;
const short = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
{lead && (
<section class:list={['section', { 'section--grey': grey }]}>
  <div class="container">
    <div class="sh sh--row" data-reveal>
      <h2>{heading}</h2>
      {text && <p>{text}</p>}
      <div class="sh__act"><a class="link-more" href="/blog/">All articles<Icon name="arrow-right" /></a></div>
    </div>
    <div class="journal" data-reveal="stagger">
      <article class="journal__lead">
        <div class="journal__img"><img src={img(lead.data.image, 1000)} srcset={srcset(lead.data.image, [480, 800, 1200])} sizes="(min-width:1024px) 55vw, 100vw" alt="" width="1000" height="667" loading="lazy" decoding="async" /></div>
        <p class="t-meta">{lead.data.tags[0]} · {short(lead.data.date)}</p>
        <h3 class="t-card"><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h3>
        <p class="journal__ex t-small">{lead.data.excerpt}</p>
      </article>
      <ul class="journal__list">
        {rest.slice(0, 3).map((p) => (
          <li>
            <article>
              <img src={img(p.data.image, 300)} alt="" width="120" height="90" loading="lazy" decoding="async" />
              <div>
                <p class="t-meta">{p.data.tags[0]} · {short(p.data.date)}</p>
                <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
    <a class="link-more m-only" href="/blog/">All articles<Icon name="arrow-right" /></a>
  </div>
</section>
)}
<style>
  /* Journal — one lead story + a short list */
  .journal { display: grid; gap: 32px; }
  .journal__lead { position: relative; }
  .journal__img { aspect-ratio: 3 / 2; margin-bottom: 18px; border-radius: var(--radius); overflow: hidden; background: var(--s-50); clip-path: inset(0 round var(--radius)); }
  .journal__img img { width: 100%; height: 100%; object-fit: cover; transition: scale var(--dur-4) var(--ease-out); }
  .journal h3 a::after { content: ''; position: absolute; inset: 0; }
  .journal__lead h3 { margin: 8px 0 10px; }
  .journal__ex { max-width: 56ch; }
  .journal__list { list-style: none; margin: 0; padding: 0; }
  .journal__list li { border-top: 1px solid var(--border-dark); }
  .journal__list li:last-child { border-bottom: 1px solid var(--border-dark); }
  .journal__list article { position: relative; display: grid; grid-template-columns: 96px 1fr; gap: 16px; align-items: center; padding-block: 20px; }
  .journal__list img { width: 96px; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--r-sm); background: var(--s-50); }
  .journal__list h3 { margin-top: 4px; }
  @media (hover: hover) {
    .journal__lead:hover img { scale: 1.03; }
    .journal article:hover h3 a { text-decoration: underline 1.5px var(--p-500); text-underline-offset: 5px; }
  }
  @media (min-width: 1024px) {
    .journal { grid-template-columns: 7fr 5fr; gap: 56px; align-items: start; }
    .journal__list article { grid-template-columns: 128px 1fr; gap: 20px; padding-block: 24px; }
    .journal__list img { width: 128px; }
  }
</style>
