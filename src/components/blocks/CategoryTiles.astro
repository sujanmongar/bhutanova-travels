---
import { getCollection } from 'astro:content';
import Section from '../Section.astro';
import { img, srcset } from '../../config';
import { catPath, usd } from '../../utils';
// grid: the same cards laid out as a grid (the tours hub) instead of a row visitors swipe or move with the arrows.
// hideHeading keeps the h2 for screen readers only, where the page's h1 already says it. exclude: the category page's own.
interface Props { heading: string; text?: string; grey?: boolean; grid?: boolean; hideHeading?: boolean; exclude?: string }
const { heading, text, grey = false, grid = false, hideHeading = false, exclude } = Astro.props;
const cats = (await getCollection('categories')).filter((c) => c.id !== exclude).sort((a, b) => a.data.order - b.data.order);
// How many tours each theme has and its lowest price, so the card sets expectations before the click
const tours = await getCollection('tours');
const meta = (id: string) => {
  const list = tours.filter((t) => t.data.category.id === id);
  if (!list.length) return 'New trips coming soon';
  return `${list.length} ${list.length === 1 ? 'tour' : 'tours'} · from ${usd(Math.min(...list.map((t) => t.data.price)))}`;
};
// The CDN crops each photo to the card's 5:7 shape (the same centred crop CSS cover shows), so files stay card-sized.
const RATIO = 5 / 7;
// Row: each tile an <article> in the shared tile rail. Grid (the tours hub): a list, each tile a list item.
const List = grid ? 'ul' : Fragment;
const Tile = grid ? 'li' : 'article';
---
<Section heading={heading} text={text} grey={grey} hideHeading={hideHeading} rail={grid ? undefined : 'themes'} railLabel="themes" railClass="rail--tile">
  <List {...(grid ? { class: 'grid-3 cats', 'data-reveal': 'stagger' } : {})}>
    {cats.map((c) => (
      <Tile class="cat">
        <img src={img(c.data.image, 680, 952)} srcset={srcset(c.data.image, [340, 500, 680, 1000], RATIO)} sizes={grid ? '(min-width:1264px) 384px, (min-width:1024px) 30vw, (min-width:768px) calc(50vw - 44px), calc(100vw - 32px)' : '(min-width:1200px) 340px, (min-width:768px) 320px, calc(100vw - 52px)'}
          alt="" width="680" height="952" loading="lazy" decoding="async" />
        <div class="cat__txt">
          <p class="cat__meta t-label">{meta(c.id)}</p>
          <h3 class="t-card"><a href={catPath(c.id)}>{c.data.menuTitle}</a></h3>
          <p class="t-body">{c.data.excerpt}</p>
        </div>
      </Tile>
    ))}
  </List>
</Section>

<style>
  /* Row: the shared tile rail (.rail--tile), swiped or moved with the arrows; nothing moves on its own.
     Grid (the tours hub): .grid-3, with the card gap between rows too, as the words sit on the photos. */
  .cats { row-gap: var(--grid-gap); }

  .cat { position: relative; display: flex; flex-direction: column; justify-content: flex-end; aspect-ratio: 5 / 7; border-radius: var(--radius); corner-shape: squircle; overflow: hidden; isolation: isolate; background: var(--s-800); color: var(--on-dark); -webkit-font-smoothing: antialiased; }
  .cat img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: scale var(--dur-4) var(--ease-out); }
  .cat::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(transparent 12%, rgb(var(--scrim-rgb) / .5) 42%, rgb(var(--scrim-rgb) / .92)); }
  .cat__txt { padding: var(--space-4); }
  .cat h3 { color: var(--on-dark); }
  .cat__meta { margin-bottom: var(--space-2); color: var(--on-dark-2); }
  .cat h3 a::after { content: ''; position: absolute; inset: 0; }
  .cat p.t-body { margin-top: var(--space-3); color: var(--on-dark);
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  /* Three lines on every card, so the labels and titles line up across a row */
  .cat p.t-body { min-height: calc(3 * var(--lh-body) * var(--fs-body)); }
  .cat:has(a:focus-visible) { outline: 2px solid var(--s-500); outline-offset: 3px; }
  .cat a:focus-visible { outline: 0; }
  @media (max-width: 767px) {
    .cat { aspect-ratio: 4 / 5; }
    .cat p.t-body { -webkit-line-clamp: 4; }
  }
  @media (min-width: 1200px) { .cat__txt { padding: var(--card-pad); } }
</style>
