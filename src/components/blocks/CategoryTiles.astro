---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { img, srcset } from '../../config';
import { catPath } from '../../utils';
interface Props { heading: string; text?: string; grey?: boolean }
const { heading, text, grey = false } = Astro.props;
const cats = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
---
<section class:list={['section cats-sec', { 'section--grey': grey }]}>
  <div class="container">
    <div class="sh sh--center" data-reveal>
      <h2>{heading}</h2>
      {text && <p>{text}</p>}
    </div>
    <ul class="cats" data-cats data-reveal>
      {cats.map((c) => (
        <li>
          <article class="cat">
            <img src={img(c.data.image, 700)} srcset={srcset(c.data.image, [400, 700, 1000])} sizes="(min-width:1200px) 300px, (min-width:768px) 280px, 74vw"
              alt="" width="600" height="800" loading="lazy" decoding="async" />
            <div class="cat__txt">
              <h3 class="t-h3"><a href={catPath(c.id)}>{c.data.menuTitle}</a></h3>
              <p>{c.data.excerpt}</p>
            </div>
          </article>
        </li>
      ))}
    </ul>
    <div class="arrows cats__nav">
      <button type="button" class="arrow" data-prev aria-label="Previous tour style"><Icon name="arrow-left" /></button>
      <button type="button" class="arrow cats__play" data-play aria-pressed="false" aria-label="Pause the slideshow"></button>
      <button type="button" class="arrow" data-next aria-label="Next tour style"><Icon name="arrow-right" /></button>
    </div>
  </div>
</section>

<script>
  import { loopRail } from '../../scripts/loop-rail';
  document.querySelectorAll<HTMLElement>('[data-cats]').forEach(loopRail);
</script>

<style>
  /* Full-width row: cards run from screen edge to screen edge, one centred, neighbours peeking in */
  .cats-sec { overflow-x: clip; }
  .cats {
    position: relative; display: grid; grid-auto-flow: column; grid-auto-columns: min(74vw, 280px); gap: 16px;
    list-style: none; margin: -8px calc(50% - 50vw); padding: 8px 0; /* 8px keeps the focus ring unclipped */
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none;
  }
  .cats::-webkit-scrollbar { display: none; }
  .cats > li { scroll-snap-align: center; }

  .cat { position: relative; display: flex; flex-direction: column; justify-content: flex-end; aspect-ratio: 3 / 4; border-radius: var(--r-xl); overflow: hidden; isolation: isolate; background: var(--s-800); color: #fff; -webkit-font-smoothing: antialiased; }
  .cat img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: scale var(--dur-4) var(--ease-out); }
  .cat::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(transparent 25%, rgb(12 25 37 / .4) 50%, rgb(12 25 37 / .9)); }
  .cat__txt { padding: 20px; }
  .cat h3 { color: #fff; }
  .cat h3 a::after { content: ''; position: absolute; inset: 0; }
  .cat p { margin-top: 8px; font-size: var(--fs-small); line-height: var(--lh-small); color: rgb(255 255 255 / .94);
    display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
  .cat:has(a:focus-visible) { outline: 2px solid var(--p-500); outline-offset: 3px; }
  .cat a:focus-visible { outline: 0; }
  @media (hover: hover) {
    .cat:hover img { scale: 1.05; }
    .cat:hover h3 a { text-decoration: underline 1.5px var(--p-500); text-underline-offset: 6px; }
  }
  @media (min-width: 768px) { .cats { grid-auto-columns: 280px; gap: 24px; } }
  @media (min-width: 1200px) {
    .cats { grid-auto-columns: 300px; gap: 28px; }
    .cat__txt { padding: 24px; }
  }
  .cats__nav { justify-content: center; margin-top: 28px; }
  /* pause bars ⇄ play triangle, drawn in CSS like the hero's control */
  .cats__play::before { content: ''; width: 8px; height: 10px; border-inline: 2px solid; }
  .cats__play[aria-pressed='true']::before { width: 9px; border: 0; background: currentColor; clip-path: polygon(0 0, 100% 50%, 0 100%); }
  @media (prefers-reduced-motion: reduce) { .cats__play { display: none; } }
</style>
