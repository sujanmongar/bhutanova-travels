---
// A short signed note from the founder. Desktop: portrait beside the note. Phones: the portrait shrinks into the
// signature, so the note isn't pushed a screen down. Name, role and photo come from the Team member it's signed by.
import LinkMore from '../LinkMore.astro';
import PersonSign from '../PersonSign.astro';
import { img, srcset, focal, type BlockImage } from '../../config';
import { ptParagraphs } from '../../pt';
interface Props { heading: string; text?: any[]; person?: { name: string; role: string; photo?: BlockImage} | null; linkLabel?: string; linkHref?: string; grey?: boolean }
const { heading, text, person, linkLabel, linkHref, grey = false } = Astro.props;
const photo = person?.photo;
---
<section class:list={['section', { 'section--grey': grey }]}>
  <div class="container fn">
    {photo && (
      <figure class="fn__photo" data-reveal>
        <img src={img(photo.url, 600, 750, photo.hotspot)} srcset={srcset(photo.url, [400, 600, 900], 4 / 5, photo.hotspot)}
          sizes="(min-width:1264px) 440px, (min-width:768px) 38vw, 1px" alt="" width="600" height="750" loading="lazy" decoding="async"
          style={`object-position:${focal(photo.hotspot)}`} />
      </figure>
    )}
    <div class="fn__txt" data-reveal>
      <h2>{heading}</h2>
      <div class="fn__body">{ptParagraphs(text).map((p) => <p class="t-body" set:html={p} />)}</div>
      {person && <PersonSign person={person} class="fn__sign" />}
      {linkLabel && linkHref && <LinkMore href={linkHref} label={linkLabel} />}
    </div>
  </div>
</section>

<style>
  .fn { display: grid; gap: var(--space-12); align-items: center; }
  .fn__photo { display: none; margin: 0; }
  .fn__photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: var(--radius); corner-shape: squircle; background: var(--s-50); }
  .fn__body { display: grid; gap: var(--space-4); margin-top: var(--space-6); max-width: 60ch; }
  .fn__body p { color: var(--text-2); }
  .fn__sign { margin-top: var(--space-8); }
  .link-more { margin-top: var(--space-6); }
  @media (min-width: 768px) {
    .fn { grid-template-columns: 5fr 7fr; gap: var(--space-12); }
    .fn__photo { display: block; }
    .fn__sign :global(img) { display: none; }  /* the portrait is beside the note here */
  }
  @media (min-width: 1024px) { .fn { gap: var(--space-20); } }
</style>
