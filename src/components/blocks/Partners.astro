---
// Partner logos in full colour, standing still. Phones wrap them into rows; desktop sets them beside the label.
import { type BlockImage } from '../../config';
interface Props { label?: string; logos?: { _key: string; name: string; url?: string; image?: BlockImage }[] }
const { label, logos = [] } = Astro.props;
---
<section class="partners">
  <div class="container partners__in">
    {label && <p class="t-label muted">{label}</p>}
    <ul class="logos">
      {/* SVGs as they are; raster logos at 3× the displayed height, as WebP/AVIF (transparency kept, about 5× lighter than PNG) */}
      {logos.filter((l) => l.image?.url).map((l) => {
        const base = l.image!.url.split('?')[0];
        const logo = <img src={base.endsWith('.svg') ? base : `${base}?h=144&fit=max&auto=format&q=90`} alt={l.name} title={l.name} width="201" height="140" loading="lazy" decoding="async" />;
        return <li>{l.url ? (l.url.startsWith('/') ? <a href={l.url}>{logo}</a> : <a href={l.url} target="_blank" rel="noopener">{logo}<span class="sr-only"> (opens in a new tab)</span></a>) : logo}</li>;
      })}
    </ul>
  </div>
</section>

<style>
  .partners { padding-block: var(--space-12); }
  .partners__in { display: grid; gap: var(--space-6); }
  /* Logos close up with no empty slots: a missing one leaves no gap and a new one joins the end of the row. A fixed
     height (not max-height) so SVG files, which may have no size of their own, never collapse to nothing. */
  .logos { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-6) var(--space-10); list-style: none; margin: 0; padding: 0; }
  @media (min-width: 768px) { .logos { justify-content: space-between; } }
  .logos a { display: grid; }
  .logos img { width: auto; height: 40px; max-width: 120px; object-fit: contain; }
  @media (min-width: 1024px) {
    .partners__in { grid-template-columns: 220px minmax(0, 1fr); gap: var(--space-12); align-items: center; }
    .logos img { height: 48px; max-width: 140px; }
  }
</style>
