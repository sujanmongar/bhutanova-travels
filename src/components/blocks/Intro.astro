---
import Checklist from '../Checklist.astro';
import LinkMore from '../LinkMore.astro';
import Logo from '../Logo.astro';
import { img, srcset, focal, type BlockImage } from '../../config';
import { ptParagraphs } from '../../pt';
interface Props { heading: string; text?: any[]; expertise?: string[]; linkLabel?: string; linkHref?: string; image?: BlockImage; quote?: string; grey?: boolean }
const { heading, text, expertise = [], linkLabel, linkHref, image, quote, grey = false } = Astro.props;
const paras = ptParagraphs(text);
// No photo: text alone. Photo + quote: photo and quote below the text. Photo alone: photo beside the text.
const layout = !image?.url ? 'alone' : quote ? 'below' : 'side';
// The photo is a 4:3 frame (full width below 1024px, the 5fr column from 1024px), so the CDN crops it around the focal
// point. From 1024px the side photo takes its height from the text (about 3:2), so it gets a 3:2 crop there instead.
const sizes = '(min-width:1264px) 510px, (min-width:1024px) calc(45vw - 65px), (min-width:768px) calc(100vw - 64px), calc(100vw - 32px)';
const crop = (ratio: number) => srcset(image!.url, [480, 800, 1200, 1600], ratio, image!.hotspot);
---
<section class:list={['section', { 'section--grey': grey }]}>
  <div class:list={['container', { side: layout === 'side' }]}>
    <div class:list={['sh', { 'sh--split': layout === 'below', 'sh--alone': layout === 'alone' }]} data-reveal>
      <h2>{heading}</h2>
      {paras.length === 1 ? <p class="t-body" set:html={paras[0]} /> : paras.length > 1 && <div class="sh__body">{paras.map((p) => <p class="t-body" set:html={p} />)}</div>}
      {expertise.length > 0 && <Checklist class="expertise" items={expertise} />}
      {linkLabel && linkHref && <LinkMore href={linkHref} label={linkLabel} />}
    </div>
    {layout === 'side' && (
      <figure class="photo" data-reveal>
        <picture>
          <source media="(max-width: 1023px)" sizes={sizes} srcset={crop(4 / 3)} />
          <img src={img(image!.url, 900, 600, image!.hotspot)} srcset={crop(3 / 2)} sizes={sizes}
            alt={image!.alt ?? ''} width="900" height="600" loading="lazy" decoding="async" style={`object-position:${focal(image!.hotspot)}`} />
        </picture>
        <span class="photo__logo"><Logo /></span>
      </figure>
    )}
    {layout === 'below' && (
      <div class="mission" data-reveal>
        <img src={img(image!.url, 900, 675, image!.hotspot)} srcset={crop(4 / 3)} sizes={sizes} alt={image!.alt ?? ''} width="900" height="675" loading="lazy" decoding="async" />
        <figure><blockquote class="t-quote">“{quote}”</blockquote></figure>
      </div>
    )}
  </div>
</section>
<style>
  .sh--alone { margin-bottom: 0; }
  .sh :global(:is(b, strong)) { color: var(--ink); }
  /* Breathing room: paragraph → checklist 32, 12 between ticks, 24 to the link */
  .expertise { margin-top: var(--space-8); }
  .link-more { margin-top: var(--space-6); }
  .sh__body { display: grid; gap: var(--space-6); margin-top: var(--space-6); }
  .sh__body p { max-width: 60ch; color: var(--text-2); }
  @media (min-width: 1024px) { .sh__body { grid-column: 2; grid-row: 1 / span 2; margin-top: 0; } }

  /* Photo beside the text, with the logo pinned over its corner at a slight tilt */
  .side { display: grid; gap: var(--space-12); align-items: center; }
  .side .sh { margin-bottom: 0; align-content: start; }
  .side .sh__body { grid-column: auto; grid-row: auto; margin-top: var(--space-6); }
  /* The photo takes its height from the text beside it (desktop), so it never runs taller than the content */
  .photo { position: relative; margin: 0; aspect-ratio: 4 / 3; }
  .photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius); corner-shape: squircle; background: var(--s-50); }
  .photo__logo { position: absolute; left: var(--space-4); bottom: var(--space-4); display: block; padding: var(--space-4) var(--space-6) var(--space-3); border-radius: var(--radius); corner-shape: squircle; background: var(--white); box-shadow: var(--sh-lg); rotate: -5deg; }
  .photo__logo :global(.logo) { display: block; width: 176px; }
  @media (min-width: 1024px) {
    .side { grid-template-columns: 6fr 5fr; gap: var(--space-20); align-items: stretch; }
    .photo { aspect-ratio: auto; min-height: 320px; }
    .photo__logo { left: calc(var(--space-8) * -1); bottom: var(--space-10); padding: var(--space-6) var(--space-8) var(--space-4); }
    .photo__logo :global(.logo) { width: 224px; }
  }

  .mission { display: grid; gap: var(--space-8); align-items: center; }
  .mission img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); corner-shape: squircle; background: var(--s-50); }
  .mission blockquote { margin: 0; text-wrap: balance; }
  .mission figure { margin: 0; }
  @media (min-width: 1024px) {
    .mission { grid-template-columns: 5fr 6fr; gap: var(--space-20); }
  }
</style>
