---
import { getCollection } from 'astro:content';
import Icon from '../Icon.astro';
import { img, srcset, focal, type BlockImage } from '../../config';
import { ptParagraphs } from '../../pt';
interface Props { heading: string; text?: any[]; image?: BlockImage; quote?: string; grey?: boolean }
const { heading, text, image, quote, grey = false } = Astro.props;
const paras = ptParagraphs(text);
const alone = !image?.url;
// The company's own tour categories, standing in for an "areas of expertise" list — real and always
// in sync, rather than a separate editorial list that drifts from what's actually offered.
const cats = alone ? (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order) : [];
---
<section class:list={['section', { 'section--grey': grey }]}>
  <div class="container">
    <div class:list={['sh', { 'sh--split': !alone, 'sh--alone': alone }]} data-reveal>
      <h2>{heading}</h2>
      {paras.length === 1 ? <p set:html={paras[0]} /> : paras.length > 1 && <div class="sh__body">{paras.map((p) => <p set:html={p} />)}</div>}
      {cats.length > 0 && (
        <p class="expertise t-small">{cats.map((c, i) => <>{i > 0 && ' · '}{c.data.menuTitle}</>)}</p>
      )}
      {alone && <a class="link-more" href="/about/">Learn more about us<Icon name="arrow-right" /></a>}
    </div>
    {image?.url && (
      <div class="mission" data-reveal>
        <img src={img(image.url, 900)} srcset={srcset(image.url, [480, 800, 1200])} sizes="(min-width:1024px) 45vw, 100vw"
          alt={image.alt ?? ''} width="900" height="700" loading="lazy" decoding="async" style={`object-position:${focal(image.hotspot)}`} />
        {quote && <figure><blockquote class="t-quote">“{quote}”</blockquote></figure>}
      </div>
    )}
  </div>
</section>
<style>
  .sh--alone { margin-bottom: 0; }
  .sh :global(:is(b, strong)) { color: var(--ink); }
  .expertise { margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border-dark); max-width: 56ch; color: var(--text-3); }
  .link-more { margin-top: 20px; }
  .sh__body { display: grid; gap: 16px; margin-top: 16px; }
  .sh__body p { max-width: 60ch; font-size: var(--fs-lead); line-height: var(--lh-lead); color: var(--text-2); }
  @media (min-width: 1024px) { .sh__body { grid-column: 2; grid-row: 1 / span 2; margin-top: 0; } }

  .mission { display: grid; gap: 28px; align-items: center; }
  .mission img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); background: var(--s-50); }
  .mission blockquote { margin: 0; text-wrap: balance; }
  .mission figure { margin: 0; }
  @media (min-width: 1024px) {
    .mission { grid-template-columns: 5fr 6fr; gap: 80px; }
  }
</style>
