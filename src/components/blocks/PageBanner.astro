---
import Banner from '../Banner.astro';
import { type BlockImage } from '../../config';
interface Props { heading: string; text?: string; image?: BlockImage; pageTitle: string }
const { heading, text, image, pageTitle } = Astro.props;
---
<Banner heading={heading} line={text} image={image?.url} alt={image?.alt} hotspot={image?.hotspot} crumbs={Astro.url.pathname !== '/' ? [[pageTitle]] : undefined} />
