---
// Plan your trip: how booking works beside how to reach us, in one navy closing section.
// The contact panel names the trip planner picked in Sanity (a Team member).
import Icon from '../Icon.astro';
import TalkPanel from '../TalkPanel.astro';
import { SITE, tel, mailto, type BlockImage } from '../../config';
interface Props { heading: string; text?: string; steps?: { _key: string; title: string; text?: string }[]; person?: { name: string; role: string; photo?: BlockImage} | null }
const { heading, text, steps = [], person } = Astro.props;
const first = person?.name.split(' ')[0];
---
<section class="section section--grey plan">
  <div class="container plan__in">
    <div data-reveal>
      <h2>{heading}</h2>
      {text && <p class="plan__lead t-body">{text}</p>}
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="steps__n t-card" aria-hidden="true">{i + 1}</span>
            <div>
              <h3 class="t-card">{s.title}</h3>
              {s.text && <p class="t-body">{s.text}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
    <aside class="talk" data-reveal aria-label="Contact us">
      <TalkPanel person={person ?? null} text={first ? `Your message comes to ${first}. ${SITE.promise}` : SITE.promise} about="planning a trip">
        <ul class="talk__lines t-label">
          <li><Icon name="envelope" /><a href={mailto()}>{SITE.email}</a></li>
          {SITE.hours && <li><Icon name="clock" /><span>{SITE.hours}</span></li>}
          <li><Icon name="phone" /><a href={tel(SITE.phone)}>{SITE.phone}</a></li>
        </ul>
      </TalkPanel>
    </aside>
  </div>
</section>

<style>
  .plan { background: var(--s-500); color: var(--on-dark); --focus: var(--on-dark); -webkit-font-smoothing: antialiased; }
  .plan h2, .plan h3 { color: var(--on-dark); }
  .plan__in { display: grid; gap: var(--space-12); }
  .plan__lead { margin-top: var(--space-6); max-width: 56ch; color: var(--on-dark-2); }
  /* .section--grey only keeps the section spacing rule from treating this band as white; the navy wins */
  /* Steps: a number, then title → 12px → text; hairlines between */
  .steps { list-style: none; margin: var(--stack) 0 0; padding: 0; border-bottom: 1px solid var(--on-dark-line); }
  .steps li { display: grid; grid-template-columns: var(--space-10) minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-6); border-top: 1px solid var(--on-dark-line); }
  .steps__n { color: var(--on-dark-2); }
  .steps p { margin-top: var(--space-3); color: var(--on-dark-2); }
  /* Contact: a panel with a named planner, two buttons, then email and phone */
  .talk { display: grid; gap: var(--space-6); align-content: start; padding: var(--card-pad); border: 1px solid var(--on-dark-line); border-radius: var(--radius); corner-shape: squircle; background: var(--on-dark-tint); }
  .talk__lines { display: grid; gap: var(--space-2); list-style: none; margin: 0; padding: 0; }
  .talk__lines li { display: flex; align-items: center; gap: var(--space-3); }
  .talk__lines :global(.icon) { flex: none; font-size: var(--icon-sm); color: var(--on-dark-2); }
  .talk__lines a { display: inline-flex; align-items: center; min-height: 44px; overflow-wrap: anywhere; }
  @media (min-width: 1024px) {
    .plan__in { grid-template-columns: 7fr 5fr; gap: var(--space-16); align-items: start; }
    .talk { position: sticky; top: var(--sticky-top); padding: var(--space-8); }
  }
</style>
