---
import Icon from '../Icon.astro';
import { wa } from '../../config';
interface Props { heading: string; text?: string; steps?: { _key: string; title: string; text?: string }[]; buttonLabel?: string; buttonLink?: string; whatsapp?: boolean; grey?: boolean }
const { heading, text, steps = [], buttonLabel, buttonLink, whatsapp = true, grey = false } = Astro.props;
const chat = wa(new URL(Astro.url.pathname, Astro.site).href, 'planning a trip');
---
{steps.length > 0 && (
<section class:list={['section', { 'section--grey': grey }]}>
  <div class="container">
    <div class="sh" data-reveal><h2>{heading}</h2>{text && <p>{text}</p>}</div>
    <!-- A short timeline: a vertical line joins the numbers on phones, a horizontal one on desktop -->
    <ol class="steps" data-reveal="stagger">
      {steps.map((s, i) => (
        <li class="step">
          <span class="step__n" aria-hidden="true">{i + 1}</span>
          <div class="step__txt">
            <h3 class="t-title">{s.title}</h3>
            {s.text && <p class="t-body muted">{s.text}</p>}
          </div>
        </li>
      ))}
    </ol>
    {(whatsapp || (buttonLabel && buttonLink)) && (
      <div class="steps__cta">
        {whatsapp && <a class="btn btn--primary" href={chat} target="_blank" rel="noopener"><Icon name="social_whatsapp" />Start on WhatsApp<span class="sr-only"> (opens in a new tab)</span></a>}
        {buttonLabel && buttonLink && <a class="btn btn--outline" href={buttonLink}>{buttonLabel}</a>}
      </div>
    )}
  </div>
</section>
)}
<style>
  /* Phones: number in a small ring on the left, a line down to the next one; title → description 12px.
     Desktop: one row, the rings joined by a line across; ring → title 24px. */
  .steps { --ring: var(--space-10); display: grid; list-style: none; margin: 0; padding: 0; counter-reset: none; }
  .step { position: relative; display: grid; grid-template-columns: var(--ring) minmax(0, 1fr); column-gap: var(--space-6); padding-bottom: var(--space-8); }
  .step:last-child { padding-bottom: 0; }
  .step__n {
    position: relative; z-index: 1; display: grid; place-items: center; width: var(--ring); height: var(--ring);
    border: 1.5px solid var(--s-500); border-radius: var(--r-full); background: var(--white);
    font-family: var(--ff-display); font-size: var(--fs-h6); line-height: 1; color: var(--s-500); font-variant-numeric: lining-nums;
  }
  .section--grey .step__n { background: var(--surface); }
  /* the joining line */
  .step:not(:last-child)::before { content: ''; position: absolute; left: calc(var(--ring) / 2); top: var(--ring); bottom: 0; width: 1px; background: var(--border-dark); }
  .step__txt { display: grid; gap: var(--space-3); padding-top: var(--space-2); }
  .steps__cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--stack); }
  @media (max-width: 479px) { .steps__cta .btn { flex: 1 1 100%; } }
  @media (min-width: 1024px) {
    .steps { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); column-gap: var(--grid-gap); }
    .step { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-6); padding-bottom: 0; }
    .step:not(:last-child)::before { left: var(--ring); right: calc(var(--grid-gap) * -1); top: calc(var(--ring) / 2); bottom: auto; width: auto; height: 1px; }
    .step__txt { padding-top: 0; }
  }
</style>
