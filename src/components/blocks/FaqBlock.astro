---
import Faq from '../Faq.astro';
import { ptParagraphs } from '../../pt';
interface Props { heading: string; text?: any[]; grey?: boolean }
const { heading, text, grey = true } = Astro.props;
---
<section class:list={['section', { 'section--grey': grey }]}>
  <div class="container">
    <Faq>
      <div class="sh" data-reveal>
        <h2>{heading}</h2>
        {ptParagraphs(text).map((p) => <p class="t-body" set:html={p} />)}
      </div>
    </Faq>
  </div>
</section>

