---
// The sidebar "talk to us" card (destination, sight, guide and Text-section pages): the compact twin of the closing
// contact card (WhatsAppCta), navy, with the same named planner, WhatsApp and the
// enquiry form. Pages pass their own title, line and chat topic.
import TalkPanel from './TalkPanel.astro';
import { SITE } from '../config';
interface Props { title?: string; text?: string; topic?: string }
const {
  title = 'Plan your Bhutan trip',
  text = SITE.promise,
  topic = 'a trip',
} = Astro.props;
---
<section class="widget widget--cta plan" aria-labelledby="w-plan">
  <p class="widget__h" id="w-plan">{title}</p>
  <TalkPanel size="md" text={text} anchor="w-plan" about={topic} enquiry={{ title }}>
    {SITE.hours && <p class="plan__hours t-label">{SITE.hours}</p>}
  </TalkPanel>
</section>
<style>
  .plan :global(.talk-text) { margin-bottom: var(--space-1); }
  .plan .plan__hours { margin: var(--space-1) 0 0; color: var(--on-dark-2); }
</style>
