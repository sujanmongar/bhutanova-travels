---
import Icon from './Icon.astro';
import { wa } from '../config';
const chat = wa(`${new URL(Astro.url.pathname, Astro.site).href}#w-plan`, 'a trip');
---
<section class="widget widget--cta" aria-labelledby="w-plan">
  <p class="widget__h" id="w-plan">Plan your Bhutan trip</p>
  <p>Tell us your dates and interests. A local expert replies within 24 hours.</p>
  <a class="btn btn--light btn--block" href="/contact/">Enquire</a>
  <a class="btn btn--on-dark btn--block" href={chat} target="_blank" rel="noopener"><Icon name="social_whatsapp" />Chat on WhatsApp</a>
</section>
