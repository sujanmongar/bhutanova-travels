---
import IconButton from './IconButton.astro';
const { target, label = 'items' } = Astro.props;
---
<div class="arrows" data-rail={target}>
  <IconButton tone="line" icon="arrow-left" label={`Previous ${label}`} aria-controls={target} />
  <IconButton tone="line" icon="arrow-right" label={`Next ${label}`} aria-controls={target} />
</div>
