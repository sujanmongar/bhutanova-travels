---
import IconButton from './IconButton.astro';
import { SITE } from '../config';
const { class: cls = '' } = Astro.props;
const names = { facebook: 'Facebook', instagram: 'Instagram', linkedin: 'LinkedIn', twitter: 'X', google: 'Google', tripadvisor: 'Tripadvisor', whatsapp: 'WhatsApp' } as const;
// Google and Tripadvisor use their official full-colour logos (the same files as the review badges).
const icons: Record<string, string> = { google: 'logo_google', tripadvisor: 'logo_tripadvisor' };
// Only profiles that exist: a network still set to '#' (or empty) in SITE.social stays hidden until its page is live.
const links = Object.entries(SITE.social).filter(([, href]) => href && href !== '#');
---
<ul class:list={['social', cls]}>
  {links.map(([k, href]) => (
    <li><IconButton tone="on-dark" href={href} target="_blank" rel="noopener" icon={icons[k] ?? `social_${k}`} label={`${names[k as keyof typeof names]} (opens in a new tab)`} /></li>
  ))}
</ul>
<style>
  .social { display: flex; flex-wrap: wrap; gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
</style>
