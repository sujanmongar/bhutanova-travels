---
import Icon from './Icon.astro';
import { SITE } from '../config';
const { class: cls = '' } = Astro.props;
const names = { facebook: 'Facebook', instagram: 'Instagram', linkedin: 'LinkedIn', twitter: 'X', whatsapp: 'WhatsApp' } as const;
---
<ul class:list={['social', cls]}>
  {Object.entries(SITE.social).map(([k, href]) => (
    <li><a href={href} target="_blank" rel="noopener" aria-label={names[k as keyof typeof names]}><Icon name={`social_${k}`} /></a></li>
  ))}
</ul>
<style>
  .social { display: flex; gap: 2px; list-style: none; margin: 0 -10px; padding: 0; }
  .social a { display: block; padding: 12px; font-size: 20px; color: rgb(255 255 255 / .7); transition: color var(--dur-1); }
  .social a:hover { color: #fff; }
</style>
