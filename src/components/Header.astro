---
import { getCollection } from 'astro:content';
import WaButton from './WaButton.astro';
import EnquireButton from './EnquireButton.astro';
import Icon from './Icon.astro';
import IconButton from './IconButton.astro';
import Logo from './Logo.astro';
import { SITE, tel } from '../config';
import { TOURS, DESTINATIONS, catPath } from '../utils';

const cats = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const allGuides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
// Guides the client puts in the menu (Sanity → "Show in the menu"): under Bhutan after Destinations, or under Travel guide.
const menuLinks = (menu: 'bhutan' | 'guide') =>
  allGuides.filter((g) => g.data.menu === menu).map((g) => ({ href: `/travel-guide/${g.id}/`, label: g.data.menuTitle ?? g.data.title }));
// Tours, the country, how to plan, who we are. The drawer and the footer's Explore list follow the same order.
// An item without children is a plain link (no dropdown).
const nav: { href: string; label: string; all?: string; children: { href: string; label: string }[] }[] = [
  { href: TOURS, label: 'Tours', all: 'All tours', children: cats.map((c) => ({ href: catPath(c.id), label: c.data.menuTitle })) },
  {
    href: '/about-bhutan/',
    label: 'Bhutan',
    // Overview (the About Bhutan page) leads the list as a plain link, on phones and desktop (owner's call)
    children: [{ href: '/about-bhutan/', label: 'Overview' }, { href: DESTINATIONS, label: 'Destinations & attractions' }, ...menuLinks('bhutan')],
  },
  { href: '/travel-guide/', label: 'Travel guide', all: 'All guides', children: menuLinks('guide') },
  {
    href: '/about/',
    label: 'About',
    children: [
      { href: '/about/', label: 'Bhutanova Travels' },  // reads "About › Bhutanova Travels"; the section's own page leads its list
      { href: '/blog/', label: 'Blog' },
      { href: '/contact/', label: 'Contact us' },
    ],
  },
];
const path = Astro.url.pathname;
// One section is active: the one whose link (or child link) matches the most of the path, so a festival-dates guide
// lights up Bhutan rather than Travel guide.
const match = nav
  .flatMap((item, i) => [item, ...item.children].filter((l) => !l.href.startsWith('/#') && path.startsWith(l.href)).map((l) => ({ i, n: l.href.length })))
  .sort((a, b) => b.n - a.n)[0];
const active = (item: (typeof nav)[number]) => match?.i === nav.indexOf(item);
// Tour pages have their own booking bar, and /contact/ is where the button goes.
const showFab = !/^\/(contact\/|bhutan-tours\/[^/]+\/[^/]+\/)/.test(path);
---
<header class="nav" data-nav>
  <div class="container nav__in">
    <a href="/" class="nav__logo" aria-label="Bhutanova Travels home"><Logo /></a>

    <div class="nav__middle">
      <nav class="menu" aria-label="Main">
        <ul class="menu__list">
          {nav.map((item) => (
            <li class:list={['menu__item', { 'has-sub': item.children.length > 0 }]}>
              <a href={item.href} class:list={['menu__link', { 'is-active': active(item) }]} aria-current={path === item.href && !item.children.some((c) => c.href === item.href) ? 'page' : undefined}>
                {item.label}{item.children.length > 0 && <Icon name="chevron-up" class="chev" />}
              </a>
              {item.children.length > 0 && (
                <ul class="sub__list">
                  {item.children.map((c) => <li><a href={c.href} class="t-label" aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
                  {item.all && <li><a href={item.href} class="sub__all see-all t-link"><span>{item.all}</span><Icon name="arrow-up-right" /></a></li>}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>

      <!-- Classic expanding search: replaces the nav row (not a side panel) — the toggle button below stays
           put and only swaps its icon, so opening/closing never moves anything else in the header. -->
      <div class="search-field" data-search-field>
        <label class="sr-only" for="search-q">Search tours, guides and articles</label>
        <input id="search-q" class="search-field__input t-caption" type="search" placeholder="Search tours, guides, articles…" autocomplete="off" data-search-q />
      </div>
    </div>

    <div class="nav__cta">
      <IconButton class="nav__search" aria-expanded="false" aria-controls="search-q" data-search-toggle>
        <Icon name="search" class="i-open" /><Icon name="close" class="i-close" /><span class="sr-only" data-search-label>Search</span>
      </IconButton>
      <EnquireButton label="Enquire" accent class="nav__book" />
      <IconButton class="burger" icon="bars" aria-haspopup="dialog" aria-controls="drawer" aria-expanded="false" data-burger><span class="sr-only">Menu</span></IconButton>
    </div>

    <div class="search-panel" data-search-panel hidden>
      <p class="search__empty t-caption" data-search-empty hidden>No matches. Try a different word, or <a href="/contact/" data-open-plan>ask us directly</a>.</p>
      <ul class="search__suggestions" data-search-results></ul>
    </div>
    <p class="sr-only" role="status" data-search-status></p>
  </div>
</header>

<!-- Mobile/tablet only: WhatsApp and Enquire follow you down the page instead of living in the (now tighter) top bar. -->
{showFab && (
  <div class="fab">
    <WaButton class="fab__wa" />
    <EnquireButton label="Enquire" />
  </div>
)}

<!-- Mobile/tablet menu: native modal dialog → focus trap, Esc, inert page, backdrop for free.
     Links and CTAs sit in the lower half where the thumb rests. -->
<dialog id="drawer" class="sheet drawer" aria-labelledby="drawer-t">
  <div class="sheet__in">
    <div class="sheet__head">
      <p id="drawer-t" class="drawer__kicker t-card">Menu</p>
      <IconButton icon="close" label="Close menu" data-close />
    </div>
    <nav aria-label="Main">
      <ul class="drawer__list">
        {nav.map((item, i) => (
          <li style={`--i:${i}`}>
            {/* A section's whole row opens its list (one big target, so a thumb never lands on the section page by mistake);
                the section's own page is a link inside: last for "All tours" and "All guides", as on desktop; Bhutan's "Overview" leads its list */}
            {item.children.length > 0 ? (
              <button type="button" class:list={['d-link', { 'is-active': active(item) }]} aria-expanded="false" aria-controls={`d-sub-${i}`} data-toggle>
                <span>{item.label}</span><Icon name="chevron-up" class="chev" />
              </button>
            ) : (
              <a href={item.href} class:list={['d-link', { 'is-active': active(item) }]} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
            )}
            {item.children.length > 0 && (
              <ul class="d-sub" id={`d-sub-${i}`} hidden>
                {item.children.map((c) => <li><a class="t-body" href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
                {item.all && <li class="d-sub__all"><a href={item.href} class="see-all t-link" aria-current={path === item.href ? 'page' : undefined}><span>{item.all}</span><Icon name="arrow-up-right" /></a></li>}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <!-- Pinned to the foot of the sheet: always in thumb reach, however long the list gets -->
    <div class="drawer__cta" style={`--i:${nav.length}`}>
      <a class="btn btn--soft" href={tel(SITE.phone)}><Icon name="phone-bold" />Call us</a>
      <WaButton label="WhatsApp" tone="soft" />
      <EnquireButton label="Enquire" size="lg" />
    </div>
  </div>
</dialog>

<script>
  import { type SearchItem, matches, groupByKind, suggestionsHTML } from '../scripts/search';

  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const burger = nav.querySelector<HTMLButtonElement>('[data-burger]')!;
  const drawer = document.getElementById('drawer') as HTMLDialogElement;
  burger.addEventListener('click', () => { drawer.showModal(); burger.setAttribute('aria-expanded', 'true'); });
  drawer.addEventListener('close', () => burger.setAttribute('aria-expanded', 'false'));
  // .sheet__in fills the dialog, so target === dialog means a backdrop tap
  drawer.addEventListener('click', (e) => {
    const t = e.target as Element;
    if (t === drawer || t.closest('[data-close], a')) drawer.close();
  });
  addEventListener('resize', () => matchMedia('(min-width: 1024px)').matches && drawer.open && drawer.close());

  // Drawer: the chevron beside a section expands its links; opening one closes the others.
  const toggles = [...drawer.querySelectorAll<HTMLButtonElement>('[data-toggle]')];
  toggles.forEach((b) => b.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') !== 'true';
    toggles.forEach((o) => {
      const on = o === b && open;
      o.setAttribute('aria-expanded', String(on));
      document.getElementById(o.getAttribute('aria-controls')!)!.hidden = !on;
    });
  }));
  // Desktop: Esc closes the open dropdown (hovered or keyboard-opened); focus returns to its top link if it was inside.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const item = (e.target as Element).closest?.('.has-sub') ?? nav.querySelector('.has-sub:hover');
    if (!item) return;
    item.classList.add('is-closed');
    if (item.contains(document.activeElement)) item.querySelector<HTMLAnchorElement>('.menu__link')?.focus();
  });
  nav.querySelectorAll('.has-sub').forEach((i) => i.addEventListener('mouseenter', () => i.classList.remove('is-closed')));
  // Closed with Esc stays closed only while focus is on its top link: Tab into the list, or out of the item, reopens it
  nav.addEventListener('focusout', (e) => { const i = (e.target as Element).closest('.has-sub'); if (i && e.relatedTarget !== i.querySelector('.menu__link')) i.classList.remove('is-closed'); });
  // Transparent over hero/banner photos; frosted glass once the page scrolls
  const onScroll = () => nav.classList.toggle('is-stuck', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Floating Enquire hides while the hero (it has its own Enquire button) or the footer (same navy) is on screen.
  // It stays hidden until this first check runs (.is-ready), so it never flashes over the hero on load.
  const fab = document.querySelector<HTMLElement>('.fab');
  if (fab) {
    const over = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? over.add(e.target) : over.delete(e.target)));
      fab.classList.toggle('is-hidden', over.size > 0);
      fab.classList.add('is-ready');
    });
    document.querySelectorAll('.hero, .footer, .wa').forEach((el) => io.observe(el));  // and over the closing contact card, which has the same buttons
  }

  // Search: a classic expand-in-place field (not a side panel) — the toggle button swaps its own icon and
  // never moves, so it always marks where to click to get back out. A small index (/search-index.json, built
  // with the site) is fetched the first time search opens, then grouped by kind as you type. Enter (or a phone's
  // own keyboard "search"/"go" key — the native `search` event covers both) goes to the full results page.
  const toggle = nav.querySelector<HTMLButtonElement>('[data-search-toggle]')!;
  const searchLabel = toggle.querySelector<HTMLElement>('[data-search-label]')!;
  const field = document.querySelector<HTMLElement>('[data-search-field]')!;
  const searchQ = field.querySelector<HTMLInputElement>('[data-search-q]')!;
  const panel = nav.querySelector<HTMLElement>('[data-search-panel]')!;
  const results = panel.querySelector<HTMLUListElement>('[data-search-results]')!;
  const empty = panel.querySelector<HTMLParagraphElement>('[data-search-empty]')!;
  const status = nav.querySelector<HTMLElement>('[data-search-status]')!;  // outside the panel, so it's in the page even while the panel is hidden
  let index: SearchItem[] | undefined;
  let loading: Promise<void> | undefined;
  // Once per page; a failed fetch is tried again on the next open. What's typed while it loads shows when it lands.
  const load = () => (loading ??= fetch('/search-index.json').then((r) => r.json()).then(
    (d: SearchItem[]) => { index = d; if (nav.classList.contains('is-searching')) render(searchQ.value); },
    () => { loading = undefined; },
  ));
  const render = (q: string) => {
    if (!index) return;
    const found = matches(index, q);
    results.innerHTML = suggestionsHTML(groupByKind(found), q);
    empty.hidden = found.length > 0 || q.trim() === '';
    panel.hidden = q.trim() === '';
    status.textContent = q.trim() === '' ? '' : found.length ? `${found.length} result${found.length > 1 ? 's' : ''}` : 'No matches';
  };
  const setOpen = (open: boolean) => {
    nav.classList.toggle('is-searching', open);
    toggle.setAttribute('aria-expanded', String(open));
    searchLabel.textContent = open ? 'Close search' : 'Search';
    // preventScroll: without it, focusing an element inside a position:sticky header can make the browser
    // scroll to where that element WOULD sit in normal document flow (the very top of the page) — it doesn't
    // account for sticky already having pinned it on-screen wherever you are.
    // Focus inside the tap itself (not a frame later): iPhone only opens the keyboard for focus that comes straight from a tap
    if (open) { load(); searchQ.value = ''; render(''); searchQ.focus({ preventScroll: true }); }
    else { panel.hidden = true; toggle.focus({ preventScroll: true }); }
  };
  toggle.addEventListener('click', () => setOpen(!nav.classList.contains('is-searching')));
  searchQ.addEventListener('input', () => render(searchQ.value));
  // The native `search` event on <input type="search"> fires for Enter and for a mobile keyboard's own
  // search/go key alike, so both are covered by the one listener.
  searchQ.addEventListener('search', () => {
    if (searchQ.value.trim()) location.href = `/search/?q=${encodeURIComponent(searchQ.value.trim())}`;
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('is-searching')) setOpen(false); });
  document.addEventListener('click', (e) => {
    if (nav.classList.contains('is-searching') && !nav.contains(e.target as Node)) setOpen(false);
  });
</script>

<style>
  /* Bar */
  /* Glass bar. Over a hero/banner photo it starts transparent with white text, then frosts on scroll. */
  .nav {
    position: sticky; top: 0; z-index: 50; color: var(--ink);
    background: var(--glass-bg); -webkit-backdrop-filter: var(--glass-blur); backdrop-filter: var(--glass-blur);
    transition: background-color var(--dur-3) var(--ease-out), box-shadow var(--dur-3), color var(--dur-3);
    view-transition-name: site-header;  /* stays put while the page underneath cross-fades */
  }
  /* Once the page scrolls: a very faint line and soft shadow under the bar (none at the top) */
  .nav.is-stuck { box-shadow: 0 1px 0 rgb(12 25 37 / .06), 0 8px 24px -16px rgb(12 25 37 / .2); }
  :global(html:has(main > :is(.hero, .banner):first-child)) .nav:not(.is-stuck) {
    background: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; box-shadow: none; color: var(--on-dark); --focus: var(--on-dark);
  }
  /* White panels inside the bar keep the navy focus ring */
  .sub__list, .search-panel { --focus: var(--s-500); }
  :global(html:has(main > :is(.hero, .banner):first-child)) .nav:not(.is-stuck) .nav__book { background: var(--white); color: var(--ink); }
  :global(html:has(main > :is(.hero, .banner):first-child)) .nav:not(.is-stuck) :global(.ib) { --ib-bg: var(--on-dark-bg); --ib-hover: var(--on-dark-hover); color: var(--on-dark); }
  @media (hover: hover) {
    :global(html:has(main > :is(.hero, .banner):first-child)) .nav:not(.is-stuck) .nav__book:hover { background: var(--p-500); color: var(--ink); }
  }
  .nav__in { position: relative; display: flex; align-items: center; gap: var(--space-2); height: var(--header-h); }
  .nav__logo { flex: none; transition: opacity var(--dur-2); }
  .nav__middle { position: relative; flex: 1; min-width: 0; display: flex; align-items: center; justify-content: flex-end; }
  /* The menu fades out and the field fades in over the same space, instead of one instantly vanishing
     (display:none) while the other's width animates in — that mismatch was the flicker: for a frame nothing
     filled the gap between them. An opacity crossfade never touches layout, so there's nothing to thrash. */
  .menu { transition: opacity var(--dur-2) var(--ease-out), visibility 0s; }
  .nav.is-searching .menu { opacity: 0; visibility: hidden; pointer-events: none; transition: opacity var(--dur-2) var(--ease-out), visibility 0s var(--dur-2); }
  .nav__cta { flex: none; display: flex; align-items: center; gap: var(--space-2); }
  /* Search toggle: one button at a fixed spot in the header, its icon swaps instead of a second button appearing. */
  .nav__search { position: relative; }
  .nav__search :global(.i-close) { display: none; }
  .nav.is-searching .nav__search :global(.i-open) { display: none; }
  .nav.is-searching .nav__search :global(.i-close) { display: block; }
  .menu { display: none; }
  .nav__book { display: none; }

  /* Search field: sits over the same space the menu just faded out of, so opening/closing is a plain
     opacity crossfade — nothing here ever animates a layout property (width, max-width, display). */
  .search-field {
    position: absolute; left: 0; right: 0; top: 50%; translate: 0 -50%; height: 44px;
    display: flex; align-items: center; border-bottom: 1px solid transparent;
    /* visibility (like .menu above) so the closed field is no Tab stop; it turns visible at once on open, before
       setOpen() focuses the input, so the iPhone keyboard still opens */
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity var(--dur-2) var(--ease-out), border-color var(--dur-2) var(--ease-out), visibility 0s var(--dur-2);
  }
  .nav.is-searching .search-field { opacity: 1; visibility: visible; pointer-events: auto; border-bottom-color: var(--border); transition-delay: 0s; }
  :global(html:has(main > :is(.hero, .banner):first-child)) .nav:not(.is-stuck).is-searching .search-field { border-bottom-color: var(--on-dark-line-strong); }
  .search-field__input {
    width: 100%; border: 0; background: none; color: inherit;
    padding: 0 var(--space-1);
  }
  .search-field__input::placeholder { color: var(--text-2); opacity: 1; }
  :global(html:has(main > :is(.hero, .banner):first-child)) .nav:not(.is-stuck) .search-field__input::placeholder { color: var(--on-dark-2); }
  .search-field__input:focus { outline: none; }
  /* The header's own close icon is the one way to dismiss search — no second (native) clear-x competing with it. */
  .search-field__input::-webkit-search-cancel-button, .search-field__input::-webkit-search-decoration { display: none; }

  /* Results: a full-width panel under the whole bar, like a classic expanding search, not a side sheet. */
  .search-panel { position: absolute; top: 100%; left: 0; right: 0; z-index: 1; background: var(--white); border-top: 1px solid var(--border); box-shadow: var(--sh-lg); max-height: 70vh; overflow-y: auto; }
  .search-panel[hidden] { display: none; }
  .search__empty { padding: var(--space-4) var(--gutter); color: var(--text-2); }
  .search__suggestions { list-style: none; margin: 0; padding: var(--space-1) calc(var(--gutter) - var(--space-1)) var(--space-2); }
  /* :global — these rows are built with innerHTML at runtime, so Astro's per-component scoping never
     stamps them; an un-global'd selector here would silently match nothing. */
  :global(.search__group) { padding-top: var(--space-3); }
  :global(.search__group-h) { padding: 0 var(--space-3) var(--space-1); font-family: var(--ff); font-size: var(--fs-label); line-height: var(--lh-label); letter-spacing: var(--ls-label); font-weight: var(--fw-label); color: var(--ink); }
  :global(.search__group ul) { list-style: none; margin: 0; padding: 0; }
  :global(.search__group a) {
    display: block; min-height: 48px; padding: var(--space-3); border-radius: var(--r-md);
    font-family: var(--ff); font-size: var(--fs-caption); line-height: var(--lh-caption); letter-spacing: var(--ls-caption); font-weight: var(--fw-caption); color: var(--ink); transition: background var(--dur-1);
  }
  :global(.search__group a:hover), :global(.search__group a:focus-visible) { background: var(--surface); text-decoration: underline 1.5px var(--p-500); text-underline-offset: var(--space-1); }
  :global(.search__see-all) {
    display: flex; align-items: center; gap: var(--space-2); margin-top: var(--space-2); padding: var(--space-3);
    border-top: 1px solid var(--border); font-family: var(--ff); font-size: var(--fs-link); line-height: var(--lh-link); letter-spacing: var(--ls-link); font-weight: var(--fw-link); color: var(--ink);
  }

  /* Mobile/tablet: Enquire floats over the page instead of squeezing into the bar. */
  .fab {
    position: fixed; right: var(--gutter); bottom: calc(var(--space-6) + env(safe-area-inset-bottom)); z-index: 40;
    display: flex; gap: var(--space-3);
  }
  .fab :global(:is(.btn, .ib)) { box-shadow: var(--sh-lg); }
  /* Over the page the grey circle is solid, so it reads on photos and grey sections alike */
  .fab :global(.ib) { --ib-bg: var(--surface); }
  @media (min-width: 1024px) { .fab { display: none; } }
  /* Keyboard focus scrolls to above the floating buttons, never under them (48px buttons + their offset + a gap) */
  @media (max-width: 1023px) { :global(html:has(.fab)) { scroll-padding-bottom: calc(var(--space-12) + var(--space-6) + var(--space-4) + env(safe-area-inset-bottom)); } }
  /* Hidden over the hero and the footer (see the script). With JS on it waits for that first check. */
  .fab.is-hidden { display: none; }
  @media (scripting: enabled) { .fab:not(.is-ready) { display: none; } }
  /* display:none (not a fade) — on mobile .menu is already hidden outright, so unlike the crossfade above
     there's nothing else animating here for this to clash with; it just frees the logo's width for the field. */
  @media (max-width: 1023px) { .nav.is-searching .nav__logo { display: none; } }

  /* Drawer (mobile/tablet) */
  .drawer__kicker { color: var(--ink); }
  .drawer__list { list-style: none; margin: 0 calc(var(--space-3) * -1); padding: 0; display: grid; gap: 0; }
  /* Phone menu (owner's call): bigger, easy thumb targets. Main links in the sans at the card-title size (20.3 on phones),
     64px rows; their links 18px (Body), 52px rows. The sheet rises from the bottom, so they sit where the thumb rests. */
  .d-link {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); width: 100%; min-height: 64px; padding: 0 var(--space-3); border: 0; border-radius: var(--r-md); background: none; text-align: left; cursor: pointer;
    font-family: var(--ff); font-size: var(--fs-card); line-height: var(--lh-card); letter-spacing: var(--ls-label); font-weight: var(--fw-label); color: var(--ink);
    -webkit-tap-highlight-color: transparent; transition: background var(--dur-1);
  }
  /* Press feedback only while the finger is down (phones keep :hover after a tap, which would look like the current page) */
  .d-link:active { background: var(--surface); }
  @media (hover: hover) { .d-link:hover { background: var(--surface); text-decoration: underline 2px var(--p-500); text-underline-offset: var(--space-2); } }
  .d-link.is-active { text-decoration: underline 2px var(--p-500); text-underline-offset: var(--space-2); }
  /* The chevron at the row's end turns when the list opens */
  .d-link :global(.chev) { flex: none; font-size: var(--icon-xs); color: var(--s-300); rotate: 180deg; transition: rotate var(--dur-2) var(--ease-out); }
  .d-link[aria-expanded='true'] :global(.chev) { rotate: 0deg; }
  .d-sub { list-style: none; margin: 0 0 var(--space-3); padding: 0 var(--space-3); display: grid; }
  .d-sub[hidden] { display: none; }
  .d-sub a {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); min-height: 52px; padding: var(--space-2) 0;
    color: var(--text); transition: color var(--dur-1);
