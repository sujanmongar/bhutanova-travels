---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { SITE, wa } from '../config';
import { TOURS, catPath } from '../utils';

const cats = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
// Only the guides the client ticks "Show in the menu" (falling back to the first few) — the full list is long.
const allGuides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const menuGuides = allGuides.filter((g) => g.data.inMenu);
const guides = (menuGuides.length ? menuGuides : allGuides).slice(0, 5);
const nav = [
  { href: TOURS, label: 'Tours', all: 'All tour packages', children: cats.map((c) => ({ href: catPath(c.id), label: c.data.menuTitle })) },
  {
    href: '/travel-guide/',
    label: 'Travel guide',
    all: 'All travel guides',
    children: [
      { href: '/about-bhutan/', label: 'About Bhutan' },
      ...guides.map((g) => ({ href: `/travel-guide/${g.id}/`, label: g.data.title })),
    ],
  },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];
const path = Astro.url.pathname;
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const tel = `tel:${SITE.phone.replace(/\s/g, '')}`;
---
<header class="nav" data-nav>
  <div class="container nav__in">
    <a href="/" class="nav__logo" aria-label="Bhutanova Travels home"><Logo /></a>

    <nav class="menu" aria-label="Main">
      <ul class="menu__list">
        {nav.map((item) => (
          <li class:list={['menu__item', { 'has-sub': item.children }]}>
            {item.children ? (
              <>
                <a href={item.href} class:list={['menu__link', { 'is-active': active(item.href) }]} aria-current={path === item.href ? 'page' : undefined}>
                  {item.label}<Icon name="chevron-up" class="chev" />
                </a>
                <ul class="sub__list">
                  {item.children.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
                  <li><a href={item.href} class="sub__all">{item.all}<Icon name="arrow-right" /></a></li>
                </ul>
              </>
            ) : (
              <a href={item.href} class:list={['menu__link', { 'is-active': active(item.href) }]} aria-current={active(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav__cta">
      <a href="/contact/" class="btn btn--primary btn--sm nav__book">Plan a trip</a>
      <button class="burger" type="button" aria-haspopup="dialog" aria-controls="drawer" aria-expanded="false" data-burger>
        <Icon name="bars" /><span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile/tablet menu: native modal dialog → focus trap, Esc, inert page, backdrop for free.
     Links and CTAs sit in the lower half where the thumb rests. -->
<dialog id="drawer" class="sheet drawer" aria-labelledby="drawer-t">
  <div class="sheet__in">
    <div class="sheet__head">
      <p id="drawer-t" class="drawer__kicker">Menu</p>
      <button type="button" class="sheet__close" aria-label="Close menu" data-close><Icon name="close" /></button>
    </div>
    <nav aria-label="Main">
      <ul class="drawer__list">
        {nav.map((item, i) => (
          <li style={`--i:${i}`}>
            {item.children ? (
              <>
                <div class="d-row">
                  <a href={item.href} class:list={['d-link', { 'is-active': active(item.href) }]} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
                  <button type="button" class="d-toggle" aria-expanded={active(item.href) ? 'true' : 'false'} aria-controls={`d-sub-${i}`} data-toggle>
                    <Icon name="chevron-up" class="chev" /><span class="sr-only">{item.label}: show all links</span>
                  </button>
                </div>
                <ul class="d-sub" id={`d-sub-${i}`} hidden={!active(item.href)}>
                  {item.children.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
                  <li class="d-sub__all"><a href={item.href}>{item.all}<Icon name="arrow-right" /></a></li>
                </ul>
              </>
            ) : (
              <a href={item.href} class:list={['d-link', { 'is-active': active(item.href) }]} aria-current={active(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="drawer__foot" style={`--i:${nav.length}`}>
      <a class="drawer__mail" href={`mailto:${SITE.email}`}><Icon name="envelope" />{SITE.email}</a>
      <div class="drawer__cta">
        <a class="btn btn--soft" href={tel}><Icon name="phone" />Call us</a>
        <a class="btn btn--soft" href={wa(new URL(Astro.url.pathname, Astro.site).href)} target="_blank" rel="noopener"><Icon name="social_whatsapp" />WhatsApp</a>
        <a class="btn btn--primary btn--lg" href="/contact/">Plan a trip<Icon name="arrow-right" class="i-end" /></a>
      </div>
    </div>
  </div>
</dialog>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const burger = nav.querySelector<HTMLButtonElement>('[data-burger]')!;
  const drawer = document.getElementById('drawer') as HTMLDialogElement;
  burger.addEventListener('click', () => { drawer.showModal(); burger.setAttribute('aria-expanded', 'true'); });
  drawer.addEventListener('close', () => burger.setAttribute('aria-expanded', 'false'));
  // .sheet__in fills the dialog, so target === dialog means a backdrop tap
  drawer.addEventListener('click', (e) => {
    const t = e.target as Element;
    if (t === drawer || t.closest('[data-close], a')) drawer.close();
  });
  addEventListener('resize', () => matchMedia('(min-width: 1200px)').matches && drawer.open && drawer.close());

  // Drawer: the chevron beside "Tours"/"Travel guide" expands its links; opening one closes the other.
  const toggles = [...drawer.querySelectorAll<HTMLButtonElement>('[data-toggle]')];
  toggles.forEach((b) => b.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') !== 'true';
    toggles.forEach((o) => {
      const on = o === b && open;
      o.setAttribute('aria-expanded', String(on));
      document.getElementById(o.getAttribute('aria-controls')!)!.hidden = !on;
    });
  }));
  // Desktop: Esc closes the open dropdown (hovered or keyboard-opened); focus returns to its top link if it was inside.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const item = (e.target as Element).closest?.('.has-sub') ?? nav.querySelector('.has-sub:hover');
    if (!item) return;
    item.classList.add('is-closed');
    if (item.contains(document.activeElement)) item.querySelector<HTMLAnchorElement>('.menu__link')?.focus();
  });
  nav.querySelectorAll('.has-sub').forEach((i) => i.addEventListener('mouseenter', () => i.classList.remove('is-closed')));
  nav.addEventListener('focusout', (e) => { const i = (e.target as Element).closest('.has-sub'); if (i && !i.contains(e.relatedTarget as Node)) i.classList.remove('is-closed'); });
  // Transparent over hero/banner photos; frosted glass once the page scrolls
  const onScroll = () => nav.classList.toggle('is-stuck', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  :global(.hide-sm) { display: none !important; }
  @media (min-width: 768px) { :global(.hide-sm) { display: flex !important; } :global(.sm-only) { display: none !important; } }

  /* Bar */
  /* Glass bar. Over a hero/banner photo it starts transparent with white text, then frosts on scroll. */
  .nav {
    position: sticky; top: 0; z-index: 50; color: var(--ink);
    background: rgb(255 255 255 / .72); -webkit-backdrop-filter: saturate(180%) blur(18px); backdrop-filter: saturate(180%) blur(18px);
    transition: background-color var(--dur-3) var(--ease-out), box-shadow var(--dur-3), color var(--dur-3);
    view-transition-name: site-header;
  }
  /* Once the page scrolls: a very faint line and soft shadow under the bar (none at the top) */
  .nav.is-stuck { box-shadow: 0 1px 0 rgb(12 25 37 / .06), 0 8px 24px -16px rgb(12 25 37 / .2); }
  :global(html:has(main > :is(.hero, .banner):first-child)) .nav:not(.is-stuck) {
    background: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; box-shadow: none; color: #fff;
  }
  :global(html:has(main > :is(.hero, .banner):first-child)) .nav:not(.is-stuck) .nav__book { background: #fff; color: var(--s-800); }
  :global(html:has(main > :is(.hero, .banner):first-child)) .nav:not(.is-stuck) .burger { background: rgb(255 255 255 / .16); color: #fff; }
  @media (hover: hover) {
    :global(html:has(main > :is(.hero, .banner):first-child)) .nav:not(.is-stuck) .nav__book:hover { background: var(--p-500); }
  }
  .nav__in { display: flex; align-items: center; gap: 12px; height: var(--header-h); }
  .nav__logo { margin-right: auto; }
  .nav__cta { display: flex; align-items: center; gap: 10px; }
  .burger {
    display: grid; place-items: center; width: 44px; height: 44px; margin-right: -2px; border: 0; border-radius: 50%;
    background: rgb(12 25 37 / .06); color: inherit; font-size: 18px; cursor: pointer; -webkit-tap-highlight-color: transparent;
    transition: background var(--dur-1), color var(--dur-3), scale var(--dur-1) var(--ease-out);
  }
  .burger:hover { background: rgb(12 25 37 / .1); }
  .burger:active { scale: .92; }
  .menu { display: none; }
  .nav__book { font-size: var(--fs-btn); padding-inline: 24px; }
  @media (max-width: 1199px) { .nav__book { --btn-h: 44px; } }
  @media (min-width: 1200px) { .nav__book { --btn-h: 44px; } }
  @media (max-width: 359px) { .nav__book { display: none; } }

  /* Drawer (mobile/tablet) */
  .drawer__kicker { font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: var(--ls-title); font-weight: 600; color: var(--ink); }
  .drawer__list { list-style: none; margin: 0 -12px; padding: 0; display: grid; gap: 2px; }
  .d-row { display: flex; align-items: center; }
  .d-link {
    flex: 1; display: flex; align-items: center; min-height: 60px; padding: 0 14px; border-radius: var(--r-md);
    font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: var(--ls-caps); text-transform: uppercase; font-weight: 600; color: var(--ink);
    -webkit-tap-highlight-color: transparent; transition: background var(--dur-1);
  }
  .d-link:hover, .d-link:active { background: var(--surface); }
  .d-link.is-active { text-decoration: underline 2px var(--p-500); text-underline-offset: 7px; }
  .d-toggle {
    display: grid; place-items: center; flex: none; width: 52px; height: 52px; border: 0; border-radius: var(--r-md); background: none;
    color: var(--s-300); font-size: 14px; cursor: pointer; -webkit-tap-highlight-color: transparent; transition: background var(--dur-1);
  }
  .d-toggle:hover, .d-toggle:active { background: var(--surface); }
  .d-toggle :global(.chev) { rotate: 180deg; transition: rotate var(--dur-2) var(--ease-out); }
  .d-toggle[aria-expanded='true'] :global(.chev) { rotate: 0deg; }
  .d-sub { list-style: none; margin: 0 0 12px; padding: 0 14px; display: grid; }
  .d-sub[hidden] { display: none; }
  .d-sub a {
    display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 48px; padding: 10px 0;
    font-size: var(--fs-small); line-height: var(--lh-small); font-weight: 500; color: var(--text); transition: color var(--dur-1);
  }
  .d-sub li + li { border-top: 1px solid var(--border); }
  .d-sub a:hover, .d-sub a:active { color: var(--ink); }
  .d-sub a[aria-current='page'] { font-weight: 600; color: var(--ink); }
  .d-sub__all a { font-weight: 600; color: var(--s-500); }
  .d-sub__all :global(.icon) { font-size: 12px; color: var(--p-700); }
  .drawer__foot { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border); }
  .drawer__mail { display: flex; align-items: center; gap: 10px; min-height: 44px; margin-bottom: 12px; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--text-2); }
  .drawer__mail :global(.icon) { color: var(--s-300); }
  .drawer__cta { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .drawer__cta .btn { --btn-h: 52px; font-size: var(--fs-btn); }
  .drawer__cta .btn--primary { grid-column: 1 / -1; --btn-h: 56px; }
  .drawer__cta :global(.icon) { font-size: 18px; }
  @keyframes d-in { from { opacity: 0; translate: 0 14px; } }
  @media (prefers-reduced-motion: no-preference) {
    .drawer[open] :is(.drawer__list > li, .drawer__foot) { animation: d-in .5s var(--ease-out) backwards; animation-delay: calc(90ms + var(--i, 6) * 40ms); }
  }

  /* Desktop */
  @media (min-width: 1200px) {
    .burger, .drawer { display: none; }
    .nav__logo { margin-right: 0; }
    .menu { display: block; margin-left: auto; margin-right: 32px; }
    .menu__list { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
    .menu__item { position: relative; }
    .menu__link {
      position: relative; display: flex; align-items: center; gap: 6px; min-height: var(--header-h);
      font-size: var(--fs-meta); line-height: 1.3; letter-spacing: var(--ls-caps); text-transform: uppercase; font-weight: 500; color: inherit;
      transition: color var(--dur-1), opacity var(--dur-1);
    }
    .menu__link::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 22px; height: 2px; border-radius: 2px; background: var(--p-500);
      scale: 0 1; transform-origin: left; transition: scale var(--dur-3) var(--ease-out);
    }
    .menu__link:hover::after, .menu__link.is-active::after, .has-sub:is(:hover, :has(:focus-visible)):not(.is-closed) > .menu__link::after { scale: 1 1; }
    .menu__link:hover { opacity: .75; }
    .menu :global(.chev) { font-size: 10px; rotate: 180deg; transition: rotate var(--dur-2) var(--ease-out); }
    .has-sub:is(:hover, :has(:focus-visible)):not(.is-closed) > .menu__link :global(.chev) { rotate: 0deg; }
    .sub__list {
      display: none; position: absolute; top: calc(100% - 14px); left: -18px; min-width: 272px; margin: 0; padding: 8px; list-style: none;
      background: #fff; border: 1px solid rgb(12 25 37 / .06); border-radius: var(--r-lg); box-shadow: var(--sh-lg);
    }
    .has-sub:is(:hover, :has(:focus-visible)):not(.is-closed) > .sub__list { display: block; --rise: -6px; animation: rise var(--dur-2) var(--ease-out); }
    /* The item under the pointer wins, so two panels never show at once */
    .menu__list:has(> .has-sub:hover) > .has-sub:not(:hover) > .sub__list { display: none; }
    .menu__list:has(> .has-sub:hover) > .has-sub:not(:hover) > .menu__link :global(.chev) { rotate: 180deg; }
    .menu__list:has(> .has-sub:hover) > .has-sub:not(:hover) > .menu__link:not(.is-active)::after { scale: 0 1; }
    .sub__list a {
      display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 12px; border-radius: var(--r-sm);
      font-size: var(--fs-small); line-height: var(--lh-small); font-weight: 500; color: var(--text); transition: background var(--dur-1), color var(--dur-1);
    }
    .sub__list a:hover { background: var(--surface); color: var(--ink); }
    .sub__list a[aria-current='page'] { color: var(--ink); font-weight: 600; background: var(--p-50); }
    .sub__all { font-weight: 600; color: var(--s-500) !important; border-top: 1px solid var(--border); border-radius: 0 0 var(--r-sm) var(--r-sm) !important; margin-top: 4px; }
    .sub__all :global(.icon) { font-size: 11px; color: var(--p-700); }
  }
</style>
