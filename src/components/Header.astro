---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { SITE } from '../config';

const cats = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order).slice(0, 8);
const nav = [
  { href: '/tours/', label: 'Tours', children: cats.map((c) => ({ href: `/tours/category/${c.id}/`, label: c.data.menuTitle })) },
  { href: '/travel-guide/', label: 'Travel guide', children: guides.map((g) => ({ href: `/travel-guide/${g.id}/`, label: g.data.title })) },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const tel = `tel:${SITE.phone.replace(/\s/g, '')}`;
---
<div class="topbar">
  <div class="container topbar__in">
    <ul class="topbar__info">
      <li class="hide-sm"><a href={`mailto:${SITE.email}`}><Icon name="envelope" />{SITE.email}</a></li>
      <li><a href={tel}><Icon name="phone" />{SITE.phone}</a></li>
      <li class="sm-only"><a href={SITE.social.whatsapp} target="_blank" rel="noopener"><Icon name="social_whatsapp" />WhatsApp us</a></li>
    </ul>
  </div>
</div>

<header class="nav" data-nav>
  <div class="container nav__in">
    <a href="/" class="nav__logo" aria-label="Bhutanova Travels home"><Logo /></a>

    <nav class="menu" aria-label="Main">
      <ul class="menu__list">
        {nav.map((item) => (
          <li class="menu__item">
            {item.children ? (
              <details class="sub" name="menu">
                <summary class:list={['menu__link', { 'is-active': active(item.href) }]}>
                  {item.label}<Icon name="chevron-up" class="chev" />
                </summary>
                <ul class="sub__list">
                  <li><a href={item.href} class="sub__all">View all<Icon name="arrow-right" /></a></li>
                  {item.children.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
                </ul>
              </details>
            ) : (
              <a href={item.href} class:list={['menu__link', { 'is-active': active(item.href) }]} aria-current={active(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav__cta">
      <a href="/contact/" class="btn btn--primary btn--sm nav__book">Plan a trip</a>
      <button class="burger" type="button" aria-haspopup="dialog" aria-controls="drawer" aria-expanded="false" data-burger>
        <Icon name="bars" /><span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile/tablet menu: native modal dialog → focus trap, Esc, inert page, backdrop for free.
     Links and CTAs sit in the lower half where the thumb rests. -->
<dialog id="drawer" class="sheet drawer" aria-labelledby="drawer-t">
  <div class="sheet__in">
    <div class="sheet__head">
      <p id="drawer-t" class="drawer__kicker">Menu</p>
      <button type="button" class="sheet__close" aria-label="Close menu" data-close><Icon name="close" /></button>
    </div>
    <nav aria-label="Main">
      <ul class="drawer__list">
        {nav.map((item, i) => (
          <li style={`--i:${i}`}>
            {item.children ? (
              <details name="drawer" open={active(item.href) || undefined}>
                <summary class:list={['d-link', { 'is-active': active(item.href) }]}>{item.label}<Icon name="chevron-up" class="chev" /></summary>
                <ul class="d-sub">
                  <li class="d-sub__all"><a href={item.href}>View all<Icon name="arrow-right" /></a></li>
                  {item.children.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
                </ul>
              </details>
            ) : (
              <a href={item.href} class:list={['d-link', { 'is-active': active(item.href) }]} aria-current={active(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="drawer__foot" style={`--i:${nav.length}`}>
      <a class="drawer__mail" href={`mailto:${SITE.email}`}><Icon name="envelope" />{SITE.email}</a>
      <div class="drawer__cta">
        <a class="btn btn--soft" href={tel}><Icon name="phone" />Call us</a>
        <a class="btn btn--soft" href={SITE.social.whatsapp} target="_blank" rel="noopener"><Icon name="social_whatsapp" />WhatsApp</a>
        <a class="btn btn--primary btn--lg" href="/contact/">Plan a trip<Icon name="arrow-right" class="i-end" /></a>
      </div>
    </div>
  </div>
</dialog>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const burger = nav.querySelector<HTMLButtonElement>('[data-burger]')!;
  const drawer = document.getElementById('drawer') as HTMLDialogElement;
  burger.addEventListener('click', () => { drawer.showModal(); burger.setAttribute('aria-expanded', 'true'); });
  drawer.addEventListener('close', () => burger.setAttribute('aria-expanded', 'false'));
  // .sheet__in fills the dialog, so target === dialog means a backdrop tap
  drawer.addEventListener('click', (e) => {
    const t = e.target as Element;
    if (t === drawer || t.closest('[data-close], a')) drawer.close();
  });
  addEventListener('resize', () => matchMedia('(min-width: 1200px)').matches && drawer.open && drawer.close());

  // Desktop: hover opens dropdowns; clicking elsewhere closes them
  const desktop = matchMedia('(min-width: 1200px)');
  nav.querySelectorAll<HTMLDetailsElement>('details.sub').forEach((d) => {
    d.addEventListener('mouseenter', () => desktop.matches && (d.open = true));
    d.addEventListener('mouseleave', () => desktop.matches && (d.open = false));
  });
  document.addEventListener('click', (e) => {
    nav.querySelectorAll<HTMLDetailsElement>('details.sub[open]').forEach((d) => !d.contains(e.target as Node) && (d.open = false));
  });
  new IntersectionObserver(([e]) => nav.classList.toggle('is-stuck', !e.isIntersecting)).observe(document.querySelector('.topbar')!);
</script>

<style>
  /* Top bar */
  .topbar { background: var(--s-500); color: #fff; font-size: var(--fs-meta); line-height: var(--lh-meta); letter-spacing: var(--ls-meta); font-weight: 500; }
  .topbar__in { display: flex; justify-content: space-between; align-items: stretch; min-height: 44px; }
  .topbar__info { display: flex; justify-content: space-between; flex: 1; gap: 12px; list-style: none; margin: 0; padding: 0; white-space: nowrap; min-width: 0; }
  .topbar__info li { align-self: stretch; }
  .topbar__info a { height: 100%; }
  .topbar__info li, .topbar__info a { display: flex; align-items: center; gap: 6px; }
  .topbar__info a { transition: color var(--dur-1); }
  .topbar__info a:hover { color: var(--p-100); }
  .topbar :global(.icon) { font-size: 14px; }
  :global(.hide-sm) { display: none !important; }
  @media (min-width: 768px) {
    .topbar__in { min-height: 48px; }
    .topbar__info { flex: none; justify-content: flex-start; gap: 28px; }
    .topbar__info li, .topbar__info a { gap: 8px; }
    :global(.hide-sm) { display: flex !important; }
    :global(.sm-only) { display: none !important; }
  }

  /* Bar */
  .nav { position: sticky; top: 0; z-index: 50; background: rgb(255 255 255 / .96); -webkit-backdrop-filter: saturate(180%) blur(12px); backdrop-filter: saturate(180%) blur(12px); border-bottom: 1px solid var(--border); transition: box-shadow var(--dur-3) var(--ease-out); view-transition-name: site-header; }
  .nav.is-stuck { box-shadow: var(--sh-sm); }
  .nav__in { display: flex; align-items: center; gap: 12px; height: var(--header-h); }
  .nav__logo { margin-right: auto; }
  .nav__cta { display: flex; align-items: center; gap: 10px; }
  .burger {
    display: grid; place-items: center; width: 44px; height: 44px; margin-right: -2px; border: 0; border-radius: var(--r-md);
    background: var(--surface); color: var(--s-500); font-size: 18px; cursor: pointer; -webkit-tap-highlight-color: transparent;
    transition: background var(--dur-1), scale var(--dur-1) var(--ease-out);
  }
  .burger:hover { background: var(--surface-2); }
  .burger:active { scale: .92; }
  .menu { display: none; }
  @media (max-width: 1199px) { .nav__book { --btn-h: 44px; } }
  @media (max-width: 359px) { .nav__book { display: none; } }

  /* Drawer (mobile/tablet) */
  .drawer__kicker { font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: var(--ls-title); font-weight: 600; color: var(--ink); }
  .drawer__list { list-style: none; margin: 0 -12px; padding: 0; display: grid; gap: 2px; }
  .d-link {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 60px; padding: 0 14px; border-radius: var(--r-md);
    font-size: var(--fs-h3); line-height: var(--lh-h3); letter-spacing: var(--ls-h3); font-weight: 600; color: var(--ink); cursor: pointer; list-style: none;
    -webkit-tap-highlight-color: transparent; transition: background var(--dur-1);
  }
  .d-link::-webkit-details-marker { display: none; }
  .d-link:hover, .d-link:active { background: var(--surface); }
  .d-link.is-active { text-decoration: underline 2px var(--p-500); text-underline-offset: 7px; }
  .d-link :global(.icon) { font-size: 14px; color: var(--s-300); transition: translate var(--dur-2) var(--ease-out), rotate var(--dur-2) var(--ease-out); }
  .d-link :global(.chev) { rotate: 180deg; }
  details[open] > .d-link :global(.chev) { rotate: 0deg; }
  .d-sub { list-style: none; margin: 0 0 12px; padding: 0 14px; display: grid; }
  .d-sub a {
    display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 48px; padding: 10px 0;
    font-size: var(--fs-small); line-height: var(--lh-small); font-weight: 500; color: var(--text); transition: color var(--dur-1);
  }
  .d-sub li + li { border-top: 1px solid var(--border); }
  .d-sub a:hover, .d-sub a:active { color: var(--ink); }
  .d-sub a[aria-current='page'] { font-weight: 600; color: var(--ink); }
  .d-sub__all a { font-weight: 600; color: var(--s-500); }
  .d-sub__all :global(.icon) { font-size: 12px; color: var(--p-700); }
  .drawer__foot { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border); }
  .drawer__mail { display: flex; align-items: center; gap: 10px; min-height: 44px; margin-bottom: 12px; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--text-2); }
  .drawer__mail :global(.icon) { color: var(--s-300); }
  .drawer__cta { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .drawer__cta .btn { --btn-h: 52px; font-size: var(--fs-btn); }
  .drawer__cta .btn--primary { grid-column: 1 / -1; --btn-h: 56px; }
  .drawer__cta :global(.icon) { font-size: 18px; }
  @keyframes d-in { from { opacity: 0; translate: 0 14px; } }
  @media (prefers-reduced-motion: no-preference) {
    .drawer[open] :is(.drawer__list > li, .drawer__foot) { animation: d-in .5s var(--ease-out) backwards; animation-delay: calc(90ms + var(--i, 6) * 40ms); }
  }

  /* Desktop */
  @media (min-width: 1200px) {
    .burger, .drawer { display: none; }
    .nav__logo { margin-right: 0; }
    .menu { display: block; margin-left: auto; margin-right: 32px; }
    .menu__list { display: flex; gap: 36px; list-style: none; margin: 0; padding: 0; }
    .menu__item { position: relative; }
    .menu__link {
      position: relative; display: flex; align-items: center; gap: 6px; min-height: var(--header-h); cursor: pointer; list-style: none;
      font-size: var(--fs-small); line-height: var(--lh-small); font-weight: 500; color: var(--ink);
      transition: color var(--dur-1);
    }
    .menu__link::-webkit-details-marker { display: none; }
    .menu__link::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: 22px; height: 2px; border-radius: 2px; background: var(--p-500);
      scale: 0 1; transform-origin: left; transition: scale var(--dur-3) var(--ease-out);
    }
    .menu__link:hover::after, .menu__link.is-active::after, details[open] > .menu__link::after { scale: 1 1; }
    .menu__link:hover { color: var(--s-500); }
    .menu :global(.chev) { font-size: 10px; rotate: 180deg; transition: rotate var(--dur-2) var(--ease-out); }
    details[open] > .menu__link :global(.chev) { rotate: 0deg; }
    .sub__list {
      position: absolute; top: calc(100% - 14px); left: -18px; min-width: 272px; margin: 0; padding: 8px; list-style: none;
      background: #fff; border: 1px solid rgb(12 25 37 / .06); border-radius: var(--r-lg); box-shadow: var(--sh-lg);
    }
    details[open] > .sub__list { --rise: -6px; animation: rise var(--dur-2) var(--ease-out); }
    .sub__list a {
      display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 12px; border-radius: var(--r-sm);
      font-size: var(--fs-small); line-height: var(--lh-small); font-weight: 500; color: var(--text); transition: background var(--dur-1), color var(--dur-1);
    }
    .sub__list a:hover { background: var(--surface); color: var(--ink); }
    .sub__list a[aria-current='page'] { color: var(--ink); font-weight: 600; background: var(--p-50); }
    .sub__all { font-weight: 600; color: var(--s-500) !important; border-bottom: 1px solid var(--border); border-radius: var(--r-sm) var(--r-sm) 0 0 !important; margin-bottom: 4px; }
    .sub__all :global(.icon) { font-size: 11px; color: var(--p-700); }
  }
</style>
