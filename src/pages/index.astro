---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Arrows from '../components/Arrows.astro';
import TourCard from '../components/TourCard.astro';
import Faq from '../components/Faq.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { SITE, img, srcset } from '../config';

const tours = await getCollection('tours');
const reviews = (await getEntry('reviews', 'reviews'))!.data;
const featured = tours.filter((t) => t.data.featured).concat(tours.filter((t) => !t.data.featured)).slice(0, 6);
const cats = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const count = (id: string) => tours.filter((t) => t.data.category.id === id).length;
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const [lead, ...rest] = posts;
const short = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

// Each photo tells its own story and points at the real tour that goes there (labels come from tour data).
const slides = [
  { id: 'photo-1608236475087-615bfbcdf772', pos: '50% 50%', alt: 'Punakha Dzong between two rivers', place: 'Punakha · western Bhutan', h: 'Where two rivers meet', line: 'The Pho Chhu and Mo Chhu join at the dzong.', tour: 'glimpse-of-bhutan', kind: 'trip' },
  { id: 'photo-1585903839731-39da51193913', pos: '72% 30%', alt: 'Masked cham dancers at a tshechu festival', place: 'Cham dance · tshechu festival', h: 'The masks come out in spring', line: 'Paro Tshechu is in March or April. Stay for the dawn thongdrel.', tour: 'paro-tshechu-festival', kind: 'festival trip' },
  { id: 'photo-1772702812424-208b331c58a0', pos: '60% 50%', alt: 'Druk Wangyal chortens on Dochula Pass', place: 'Dochula Pass · 108 chortens', h: 'Lunch at 3,100 metres', line: 'A picnic on the pass between Thimphu and Punakha.', tour: 'bhutan-luxury-escape', kind: 'luxury trip' },
  { id: 'photo-1650747857310-c359fd3ee5c5', pos: '50% 40%', alt: 'Buddha Dordenma statue above Thimphu', place: 'Buddha Dordenma · Thimphu', h: '51 metres of bronze', line: 'Seated on a hill above the capital.', tour: 'bhutan-cultural-extravaganza', kind: 'trip' },
  { id: 'photo-1761048163649-5774b163cb40', pos: '40% 50%', alt: 'Himalayan peaks above forested ridges', place: 'High passes · up to 4,200 m', h: 'Walk to Thimphu the long way', line: 'High lakes and, on a clear day, Jomolhari at 7,326 m.', tour: 'druk-path-trek', kind: 'trek' },
].map((s) => {
  const t = tours.find((x) => x.id === s.tour)!; // fails the build if a slug is wrong
  return { ...s, href: `/tours/${s.tour}/`, name: t.data.title, cta: `See the ${t.data.days}-day ${s.kind}` };
});
const pillars = [
  ['Community', 'Part of every booking goes back into the villages you visit, and we hire local guides, drivers and cooks.'],
  ['People', 'Small groups and private trips, paced around you. Our team answers every message personally.'],
  ['Self', 'Quiet mornings at monasteries, long walks and time to reflect — travel the way Bhutan intends.'],
];
const why = [
  ['Local team', 'Bhutanese-owned and based in Thimphu.'],
  ['Private trips', 'Your dates, your pace, your own guide.'],
  ['One clear price', 'Visa, SDF, hotels, guide and transport included.'],
  ['On call 24/7', 'A planner is a message away throughout your trip.'],
];
const partners = [
  ['bhutan-believe', 'Department of Tourism'],
  ['gab', 'Guide Association of Bhutan'],
  ['abto', 'Association of Bhutanese Tour Operators'],
  ['drukair', 'Drukair – Royal Bhutan Airlines'],
  ['bhutan-airlines', 'Bhutan Airlines'],
];
const brand: Record<string, { icon: string; fg: string }> = {
  Google: { icon: 'brand_google', fg: '#4285f4' },
  Tripadvisor: { icon: 'brand_tripadvisor', fg: '#00aa6c' },
};
const [quote, ...quotes] = reviews.items;
---
<Base title="Home">
  <!-- Hero: one story per photo -->
  <section class="hero" aria-roledescription="carousel" aria-label="Places we travel in Bhutan">
    <h1 class="sr-only">Bhutan tours planned by locals</h1>
    <div class="hero__track" id="hero-track">
      {slides.map((s, i) => (
        <img src={img(s.id, 1600)} srcset={srcset(s.id, [640, 960, 1400, 1920, 2560])} sizes="100vw" alt={s.alt} width="1600" height="900"
          style={`object-position:${s.pos}`} loading={i ? 'lazy' : 'eager'} fetchpriority={i ? undefined : 'high'} decoding="async" />
      ))}
    </div>
    <div class="container hero__in">
      <div class="hero__slides">
        {slides.map((s, i) => (
          <div class:list={['hero__slide', { 'is-on': !i }]} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} data-place={s.place} inert={i > 0}>
            <div class="hero__copy">
              <h2 class="hero-title">{s.h}</h2>
              <p class="hero__line">{s.line}</p>
            </div>
            <a class="btn btn--light btn--lg hero__cta" href={s.href}>{s.cta}<span class="sr-only">: {s.name}</span><Icon name="arrow-right" class="i-end" /></a>
          </div>
        ))}
      </div>
      <div class="hero__bar">
        <p class="hero__place" data-caption>{slides[0].place}</p>
        <div class="hero__dots">
          {slides.map((s, i) => <button type="button" data-to={i} aria-label={`Slide ${i + 1} of ${slides.length}: ${s.place}`} aria-current={i ? undefined : 'true'}><i></i></button>)}
          <button type="button" class="hero__pause" data-pause aria-label="Pause slideshow"></button>
        </div>
      </div>
      <p class="sr-only" aria-live="polite" data-live></p>
    </div>
  </section>

  <!-- About -->
  <section class="section">
    <div class="container">
      <div class="sh sh--split" data-reveal>
        <h2>A fresh perspective on Bhutan</h2>
        <p>We are a small, Bhutanese-owned team based in Babesa, Thimphu. Our trips follow the values the kingdom is known for — Gross National Happiness — and are built around three simple ideas.</p>
      </div>
      <ul class="items items--3" data-reveal="stagger">
        {pillars.map(([t, d]) => <li class="item"><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
      <div class="mission" data-reveal>
        <img src={img('photo-1762179861385-793eba9c7623', 900)} srcset={srcset('photo-1762179861385-793eba9c7623', [480, 800, 1200])} sizes="(min-width:1024px) 45vw, 100vw"
          alt="Two young monks in red robes sitting in the sun" width="900" height="700" loading="lazy" decoding="async" />
        <figure>
          <blockquote class="t-quote">“We want every journey to leave something good behind — for the families who host you, and for you.”</blockquote>
        </figure>
      </div>
    </div>
  </section>

  <!-- Why us -->
  <section class="section section--grey">
    <div class="container">
      <div class="sh" data-reveal><h2>Why travel with us</h2></div>
      <ul class="why" data-reveal="stagger">
        {why.map(([t, d]) => <li><h3>{t}</h3><p class="t-small">{d}</p></li>)}
      </ul>
    </div>
  </section>

  <!-- Packages -->
  <section class="section">
    <div class="container">
      <div class="sh sh--row" data-reveal>
        <h2>Tour packages</h2>
        <p>Handpicked journeys across the kingdom. Every one can be tailored to your dates and pace.</p>
        <div class="sh__act"><a class="link-more" href="/tours/">All {tours.length} packages<Icon name="arrow-right" /></a><Arrows target="rail-tours" label="packages" /></div>
      </div>
      <div class="rail" id="rail-tours" data-reveal="stagger">{featured.map((t) => <TourCard tour={t} />)}</div>
      <a class="link-more m-only" href="/tours/">All {tours.length} packages<Icon name="arrow-right" /></a>
    </div>
  </section>

  <!-- Themes -->
  <section class="section">
    <div class="container">
      <div class="sh sh--split" data-reveal>
        <h2>Travel your way</h2>
        <p>Start with what interests you most — culture, festivals, mountains or simply slowing down.</p>
      </div>
      <ul class="themes" data-reveal="stagger">
        {cats.map((c) => (
          <li>
            <a href={`/tours/category/${c.id}/`} class="theme">
              <img src={img(c.data.image, 700)} srcset={srcset(c.data.image, [400, 700])} sizes="(min-width:1024px) 360px, (min-width:768px) 45vw, 70vw" alt="" width="700" height="525" loading="lazy" decoding="async" />
              <span class="theme__txt"><b class="t-title">{c.data.menuTitle}</b><Icon name="arrow-right" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Blog -->
  <section class="section section--grey">
    <div class="container">
      <div class="sh sh--row" data-reveal>
        <h2>From the blog</h2>
        <p>Stories, festival notes and practical advice from our team.</p>
        <div class="sh__act"><a class="link-more" href="/blog/">All articles<Icon name="arrow-right" /></a></div>
      </div>
      <div class="journal" data-reveal="stagger">
        <article class="journal__lead">
          <div class="journal__img"><img src={img(lead.data.image, 1000)} srcset={srcset(lead.data.image, [480, 800, 1200])} sizes="(min-width:1024px) 55vw, 100vw" alt="" width="1000" height="667" loading="lazy" decoding="async" /></div>
          <p class="t-meta">{lead.data.tags[0]} · {short(lead.data.date)}</p>
          <h3 class="t-h3"><a href={`/blog/${lead.id}/`}>{lead.data.title}</a></h3>
          <p class="journal__ex t-small">{lead.data.excerpt}</p>
        </article>
        <ul class="journal__list">
          {rest.slice(0, 3).map((p) => (
            <li>
              <article>
                <img src={img(p.data.image, 300)} alt="" width="120" height="90" loading="lazy" decoding="async" />
                <div>
                  <p class="t-meta">{p.data.tags[0]} · {short(p.data.date)}</p>
                  <h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3>
                </div>
              </article>
            </li>
          ))}
        </ul>
      </div>
      <a class="link-more m-only" href="/blog/">All articles<Icon name="arrow-right" /></a>
    </div>
  </section>

  <!-- Reviews -->
  <section class="section">
    <div class="container">
      <div class="sh" data-reveal><h2>What travelers say</h2></div>
      <div class="rv" data-reveal>
        <figure class="rv__main">
          <blockquote class="t-quote">“{quote.text}”</blockquote>
          <figcaption><b>{quote.name}</b><span class="t-meta">{quote.place}</span><span class="t-meta">{quote.trip}</span></figcaption>
        </figure>
        <div class="rv__side">
          <ul class="rv__scores">
            {reviews.platforms.map((p) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener">
                  <span class="rv__logo" style={`color:${brand[p.name]?.fg}`} aria-hidden="true"><Icon name={brand[p.name]?.icon ?? 'star'} /></span>
                  {reviews.sample ? (
                    <b class="rv__name t-title">Read our reviews on {p.name}</b>
                  ) : (
                    <>
                      <b class="num t-h3">{p.rating.toFixed(1)}</b>
                      <span class:list={['rate', { 'rate--bubbles': p.name === 'Tripadvisor' }]} style={`--fill:${p.rating * 20}%`} aria-hidden="true"></span>
                      <span class="rv__src t-meta">{p.name} · <span class="num">{p.count}</span> reviews</span>
                    </>
                  )}
                  <Icon name="arrow-up-right" class="rv__ext" /><span class="sr-only"> (opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <ul class="rv__more rail" id="rail-quotes">
        {quotes.map((r) => (
          <li>
            <figure>
              <blockquote class="t-small">“{r.text}”</blockquote>
              <figcaption><b>{r.name}</b><span class="t-meta">{r.place}</span></figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--grey">
    <div class="container">
      <Faq>
        <div class="sh" data-reveal>
          <h2>Questions, answered</h2>
          <p>The things travelers ask us most before booking. Can't find yours? Call <a class="inline" href={`tel:${SITE.phone.replace(/\s/g, '')}`}>{SITE.phone}</a> or <a class="inline" href="/contact/">send us a message</a>.</p>
        </div>
      </Faq>
    </div>
  </section>

  <CtaBanner />

  <!-- Partners -->
  <section class="partners">
    <div class="container partners__in">
      <p class="t-meta">Registered with and flying in partnership with</p>
      <ul>
        {partners.map(([f, n]) => <li><img src={`/images/partners/${f}.png`} alt={n} title={n} width="201" height="140" loading="lazy" /></li>)}
      </ul>
    </div>
  </section>
</Base>

<script>
  const track = document.getElementById('hero-track')!;
  const hero = track.parentElement!;
  const slides = [...hero.querySelectorAll<HTMLElement>('.hero__slide')];
  const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-to]')];
  const caption = hero.querySelector<HTMLElement>('[data-caption]')!;
  const live = hero.querySelector<HTMLElement>('[data-live]')!;
  const pause = hero.querySelector<HTMLButtonElement>('[data-pause]')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const n = slides.length;
  let on = 0, auto = false;
  const cur = () => Math.round(track.scrollLeft / track.clientWidth);
  const go = (i: number) => {
    const to = (i + n) % n, left = to * track.clientWidth;
    if (Math.abs(to - cur()) > 1 && !reduce) {
      // wrap-around / big jump: dip to navy instead of rewinding through every slide
      track.animate([{ opacity: 1 }, { opacity: 0, offset: .5 }, { opacity: 1 }], { duration: 600, easing: 'ease-in-out' });
      setTimeout(() => track.scrollTo({ left, behavior: 'instant' }), 300);
    } else track.scrollTo({ left, behavior: reduce ? 'auto' : 'smooth' });
  };
  const show = (i: number) => {
    if (i === on) return;
    slides[on].classList.remove('is-on'); slides[on].inert = true; dots[on].removeAttribute('aria-current');
    slides[i].classList.add('is-on'); slides[i].inert = false; dots[i].setAttribute('aria-current', 'true');
    caption.textContent = slides[i].dataset.place!;
    if (!reduce) caption.animate({ opacity: [0, 1] }, 400);
    live.textContent = auto ? '' : `${i + 1} of ${n}: ${slides[i].querySelector('h2')!.textContent}`;
    on = i; auto = false;
  };
  track.addEventListener('scroll', () => show(cur()), { passive: true });
  dots.forEach((b, i) => (b.onclick = () => go(i)));
  // The orange fill in the current line is the timer: when it finishes, advance. Pausing the fill pauses the slideshow.
  hero.addEventListener('animationend', (e) => { if ((e.target as Element).matches('.hero__dots i')) { auto = true; go(on + 1); } });
  pause.onclick = () => pause.setAttribute('aria-label', hero.toggleAttribute('data-paused') ? 'Play slideshow' : 'Pause slideshow');
</script>

<style>
  .m-only { margin-top: 18px; }
  @media (min-width: 768px) { .m-only { display: none; } }
  .inline { white-space: nowrap; color: var(--ink); font-weight: 600; text-decoration: underline 1px var(--p-500); text-underline-offset: 4px; }
  .inline:hover { color: var(--p-800); }

  /* Hero — one story per photo; frame (bar) stays fixed, only the story moves */
  .hero { position: relative; height: min(88svh, 760px); min-height: 560px; color: #fff; overflow: hidden; background: var(--s-800); }
  .hero__track { position: absolute; inset: 0; display: flex; overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .hero__track::-webkit-scrollbar { display: none; }
  .hero__track img { flex: 0 0 100%; width: 100%; height: 100%; object-fit: cover; scroll-snap-align: start; }
  .hero::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(rgb(12 25 37 / .3), transparent 20%, transparent 32%, rgb(12 25 37 / .55) 52%, rgb(12 25 37 / .88)); }
  .hero__in { position: relative; z-index: 1; height: 100%; display: grid; align-content: end; row-gap: 28px; padding-bottom: max(12px, env(safe-area-inset-bottom)); pointer-events: none; }
  .hero__in :is(a, button) { pointer-events: auto; }
  .hero__slides { display: grid; }
  .hero__slide { grid-area: 1 / 1; align-self: end; display: grid; justify-items: start; gap: 24px; }
  .hero__slide:not(.is-on) { opacity: 0; visibility: hidden; transition: opacity 200ms var(--ease-in), visibility 0s 200ms; }
  .hero-title { max-width: 15ch; }
  .hero__line { max-width: 36ch; margin-top: 12px; font-size: var(--fs-lead); line-height: var(--lh-lead); color: rgb(255 255 255 / .88); }
  .hero__bar { display: grid; justify-items: start; gap: 4px; }
  .hero__place { font-size: var(--fs-meta); line-height: var(--lh-meta); letter-spacing: var(--ls-meta); font-weight: 500; color: rgb(255 255 255 / .8); }
  .hero__dots { display: flex; margin-inline: -6px; }
  .hero__dots button { display: grid; align-items: center; width: 48px; height: 44px; padding: 0 6px; border: 0; background: none; color: #fff; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .hero__dots i { height: 3px; border-radius: 2px; background: rgb(255 255 255 / .35) linear-gradient(var(--p-500), var(--p-500)) no-repeat; background-size: 0 100%; transition: background-color var(--dur-2); }
  .hero__dots [aria-current] i { background-size: 100% 100%; }
  .hero__dots .hero__pause { width: 44px; justify-items: center; }
  .hero__pause::before { content: ''; width: 8px; height: 10px; border-inline: 2px solid; }
  .hero[data-paused] .hero__pause::before { width: 9px; border: 0; background: currentColor; clip-path: polygon(0 0, 100% 50%, 0 100%); }
  @media (hover: hover) {
    .hero__dots button:not([aria-current]):hover i { background-color: var(--p-500); }
    .hero__dots .hero__pause:hover { color: var(--p-500); }
  }
  @media (scripting: none) { .hero__dots { display: none; } }
  @media (prefers-reduced-motion: reduce) { .hero__pause { display: none !important; } }
  @media (min-width: 768px) {
    .hero::after { background: radial-gradient(75% 85% at 0 100%, rgb(12 25 37 / .55), transparent 80%), linear-gradient(rgb(12 25 37 / .3), transparent 20%, transparent 45%, rgb(12 25 37 / .5) 75%, rgb(12 25 37 / .7)); }
    .hero__in { row-gap: 32px; padding-bottom: 24px; }
    .hero__dots button { width: 56px; }
  }
  /* Desktop: story on the left, the button pinned to the right edge; caption + progress run underneath */
  @media (min-width: 1024px) {
    .hero__slide { grid-template-columns: minmax(0, 1fr) auto; align-items: end; column-gap: 48px; }
    .hero__cta { margin-bottom: 6px; }
    .hero__bar { grid-auto-flow: column; justify-content: space-between; align-items: center; }
    .hero__dots { margin-inline: 0 -6px; }
  }
  @media (min-width: 1200px) {
    .hero { height: min(90svh, 820px); }
    .hero__in { padding-bottom: 40px; }
    .hero__line { margin-top: 16px; }
  }

  @keyframes hero-fill { from { background-size: 0 100%; } }
  @media (prefers-reduced-motion: no-preference) {
    .hero__track > img:first-child { animation: kenburns 7s cubic-bezier(.33, 1, .68, 1) backwards; }
    .hero__slide.is-on .hero-title { --rise: 18px; animation: rise 800ms var(--ease-out) 200ms backwards; }
    .hero__slide.is-on .hero__line { --rise: 12px; animation: rise 800ms var(--ease-out) 280ms backwards; }
    .hero__slide.is-on > .hero__cta { animation: fade 500ms var(--ease-out) 360ms backwards; }
    .hero__bar { animation: fade var(--dur-4) var(--ease-out) 650ms backwards; }
    .hero__dots [aria-current] i { animation: hero-fill 7s linear; }
    .hero:is([data-paused], :has(.hero__in :focus-visible)) .hero__dots i { animation-play-state: paused; }
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .hero:has(.hero__in :is(a, button):hover) .hero__dots i { animation-play-state: paused; }
  }

  /* About */
  .items--3 { margin-bottom: 64px; }
  .mission { display: grid; gap: 28px; align-items: center; }
  .mission img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); background: var(--s-50); }
  .mission blockquote { margin: 0; text-wrap: balance; }
  .mission figure { margin: 0; }
  @media (min-width: 1024px) {
    .mission { grid-template-columns: 5fr 6fr; gap: 80px; }
  }

  /* Why us — four short, concrete points */
  .why { display: grid; gap: 0 32px; list-style: none; margin: 0; padding: 0; }
  .why li { padding-block: 20px; border-top: 1px solid var(--border-dark); }
  .why h3 { margin-bottom: 4px; }
  .why p { max-width: 30ch; }
  @media (min-width: 768px) { .why { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .why { grid-template-columns: repeat(4, 1fr); } .why li { padding-block: 24px 0; } }

  /* Themes — photo tiles, captions set into the image */
  .themes { display: grid; grid-auto-flow: column; grid-auto-columns: min(70%, 280px); gap: 12px; list-style: none; margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: none; }
  .themes::-webkit-scrollbar { display: none; }
  .themes li { scroll-snap-align: start; }
  .theme { position: relative; display: block; aspect-ratio: 4 / 5; border-radius: var(--radius); overflow: hidden; isolation: isolate; background: var(--s-50); }
  .theme img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: scale var(--dur-4) var(--ease-out); }
  .theme::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(transparent 45%, rgb(12 25 37 / .75)); }
  .theme__txt { position: absolute; inset: auto 0 0; display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; padding: 18px; color: #fff; -webkit-font-smoothing: antialiased; }
  .theme__txt :global(.icon) { flex: none; font-size: 14px; margin-bottom: 4px; transition: translate var(--dur-2) var(--ease-out); }
  @media (hover: hover) { .theme:hover .theme__txt :global(.icon) { translate: 3px 0; } }
  @media (hover: hover) { .theme:hover img { scale: 1.04; } }
  .theme:focus-visible { outline-offset: 3px; }
  @media (min-width: 768px) { .themes { grid-auto-columns: calc((100% - 24px) / 3); } }
  @media (min-width: 1024px) {
    .themes { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 0; padding: 0; overflow: visible; }
    .theme { aspect-ratio: 4 / 3; }
  }

  /* Journal — one lead story + a short list */
