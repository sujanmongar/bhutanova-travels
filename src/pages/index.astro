---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import { coverImage } from '../config';

// The homepage is the "Homepage" document in Sanity; its sections are arranged by the editor.
const page = await getEntry('pages', 'home');
if (!page) throw new Error('Sanity has no published "home" page — publish the Homepage in the Studio.');
---
<Base title="Home" image={coverImage(page.data.sections)} seo={page.data.seo}>
  <Blocks sections={page.data.sections} title={page.data.title} />
</Base>
