---
import Base from '../layouts/Base.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { img, srcset } from '../config';

const values = [
  ['arrows-to-circle', 'Community', 'We contribute to the communities we visit: local guides and drivers, village homestays, and a share of every booking returned to local projects.'],
  ['people', 'People', 'Expert guidance, personal service and a team that answers the phone — so your journey is memorable and free of stress.'],
  ['image-user', 'Self', 'Rooted in Gross National Happiness, a trip with us leaves room for reflection, not just sightseeing.'],
];
const hero = 'photo-1762179861385-793eba9c7623';
---
<Base title="About Us" description="Meet Bhutanova Travels — a Thimphu-based tour operator guided by Gross National Happiness, creating responsible cultural, festival and trekking tours across Bhutan." image={hero}>
  <section class="banner">
    <img src={img(hero, 1600)} srcset={srcset(hero)} sizes="100vw" alt="Two young monks in red robes sitting in the sun" width="1600" height="700" fetchpriority="high" />
    <div><p class="eyebrow">About us</p><h1>A small, Bhutanese-owned team in Thimphu</h1></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sh sh--split intro" data-reveal>
        <h2>Who we are</h2>
        <div>
          <p>We are a tour company based in Babesa, Thimphu, in a kingdom still guided by the idea of Gross National Happiness. Our work rests on three pillars that reflect that idea — the <b>community</b>, the <b>people</b> and the <b>self</b>.</p>
          <p>Whether you are looking for a spiritual retreat, mountain scenery or time with local families, we plan it with the same care: expert guidance, clear pricing and real people on the phone.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container story">
      <div class="story__row" data-reveal>
        <img src={img('photo-1605904583059-7880dad25595', 900)} srcset={srcset('photo-1605904583059-7880dad25595', [480, 800, 1200])} sizes="(min-width:1024px) 50vw, 100vw" alt="A monk walking along a dzong corridor" width="900" height="675" loading="lazy" decoding="async" />
        <div>
          <h2>Our vision</h2>
          <p>To grow tourism that lasts: travel that supports local communities, respects Bhutan's culture and leaves every guest a little changed for the better.</p>
        </div>
      </div>
      <div class="story__row story__row--rev" data-reveal>
        <img src={img('photo-1532918235359-7671f525386d', 900)} srcset={srcset('photo-1532918235359-7671f525386d', [480, 800, 1200])} sizes="(min-width:1024px) 50vw, 100vw" alt="Prayer flags strung across a mountain ridge" width="900" height="675" loading="lazy" decoding="async" />
        <div>
          <h2>Our mission</h2>
          <p>We want to show the world's travelers a Bhutan that is honest and unhurried, while making sure the places we visit benefit from every trip.</p>
          <p>That means expert guidance, personal service and a steady focus on your well-being — from the first email to the drive back to Paro airport.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container">
      <div class="sh sh--split" data-reveal><h2>What guides us</h2><p>Three values that shape every itinerary we write.</p></div>
      <ul class="items items--3" data-reveal="stagger">{values.map(([, t, d]) => <li class="item"><h3>{t}</h3><p>{d}</p></li>)}</ul>
    </div>
  </section>

  <CtaBanner title="Ready when you are" text="Share your dates and interests and we will send a first itinerary within a day — no payment needed to ask." cta="Contact us" image="photo-1629778634400-21720d1b92b3" />
</Base>
<style>
  .intro { margin-bottom: 0; }
  .intro > div { display: grid; gap: 16px; margin-top: 16px; }
  .intro > div p { max-width: 60ch; font-size: var(--fs-lead); line-height: var(--lh-lead); color: var(--text-2); }
  .intro b { color: var(--ink); }
  @media (min-width: 1024px) { .intro > div { grid-column: 2; grid-row: 1 / span 2; margin-top: 0; } }
  .story { display: grid; gap: 56px; }
  .story__row { display: grid; gap: 24px; align-items: center; }
  .story__row img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); background: var(--s-50); }
  .story__row p { margin-top: 14px; max-width: 52ch; font-size: var(--fs-lead); line-height: var(--lh-lead); color: var(--text-2); }
  @media (min-width: 768px) {
    .story { gap: 80px; }
    .story__row { grid-template-columns: 1fr 1fr; gap: 56px; }
    .story__row--rev img { order: 2; }
  }
  @media (min-width: 1200px) { .story__row { gap: 96px; } }
</style>
