---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import TourCard from '../../components/TourCard.astro';
import PlanCta from '../../components/PlanCta.astro';
import BannerImg from '../../components/BannerImg.astro';
import Arrows from '../../components/Arrows.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import { img } from '../../config';
import { DESTINATIONS, TOURS } from '../../utils';

export async function getStaticPaths() {
  const destinations = await getCollection('destinations');
  const tours = await getCollection('tours');
  return destinations.map((d) => ({ params: { id: d.id }, props: { d, tours: d.data.tours.map((id) => tours.find((t) => t.id === id)).filter((t) => t !== undefined) } }));
}
const { d, tours } = Astro.props;
const { Content } = await render(d);
const url = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org', '@type': 'TouristDestination', name: d.data.title, description: d.data.excerpt, url,
  image: img(d.data.image, 1200),
  includesAttraction: d.data.highlights.map((h) => ({ '@type': 'TouristAttraction', name: h })),
};
---
<Base title={`${d.data.title} travel guide`} description={d.data.excerpt} image={d.data.image} schema={schema} seo={d.data.seo}>
  <section class="banner">
    <BannerImg src={d.data.image} />
    <div><Breadcrumbs items={[['Destinations', DESTINATIONS], [d.data.title]]} light /><h1>{d.data.title}</h1><p class="banner__line">{d.data.excerpt}</p></div>
  </section>

  <div class="container layout">
    <div class="main">
      {(d.data.bestTime || d.data.gettingThere) && (
        <ul class="facts t-label muted">
          {d.data.bestTime && <li><Icon name="clock" />Best time: {d.data.bestTime}</li>}
          {d.data.gettingThere && <li><Icon name="path" />{d.data.gettingThere}</li>}
        </ul>
      )}

      <div class="prose"><Content /></div>

      {d.data.highlights.length > 0 && (
        <section class="block">
          <h2>Highlights</h2>
          <ul class="bullets">{d.data.highlights.map((h) => <li class="t-body"><Icon name="check" />{h}</li>)}</ul>
        </section>
      )}
    </div>
    <aside class="side"><PlanCta /></aside>
  </div>

  {tours.length > 0 && (
    <section class="section section--grey">
      <div class="container">
        <div class="sh sh--row">
          <h2>Tours that visit {d.data.title}</h2>
          <div class="sh__act"><a class="link-more" href={TOURS}>All packages<Icon name="arrow-right" /></a><Arrows target="rail-tours" label="tours" /></div>
        </div>
        <div class="rail" id="rail-tours" data-reveal="stagger">{tours.map((t) => <TourCard tour={t} rail />)}</div>
        <a class="link-more m-only" href={TOURS}>All packages<Icon name="arrow-right" /></a>
      </div>
    </section>
  )}
  <WhatsAppCta about={`visiting ${d.data.title}`} />
</Base>
<style>
  .layout { display: grid; gap: var(--space-10); padding-block: var(--stack) var(--section); }
  .layout > * { min-width: 0; }
  @media (min-width: 1200px) { .layout { grid-template-columns: minmax(0, 1fr) 360px; gap: var(--space-16); } }
  .facts { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); list-style: none; margin: 0 0 var(--space-8); padding: 0; }
  .facts li { display: flex; gap: var(--space-2); }
  /* Icon centred on the first line, so a fact that wraps keeps its icon at the top */
  .facts :global(.icon) { margin-top: calc((var(--lh-label) * var(--fs-label) - 18px) / 2); font-size: 18px; color: var(--text-3); }
  .block { margin-top: var(--space-10); }
  .block h2 { margin-bottom: var(--space-6); }
  .bullets { display: grid; gap: var(--space-3); list-style: none; margin: 0; padding: 0; }
  @media (min-width: 768px) { .bullets { grid-template-columns: 1fr 1fr; column-gap: var(--space-8); } }
  .bullets li { display: flex; gap: var(--space-3); }
  .bullets :global(.icon) { flex: none; margin-top: calc((var(--lh-body) * var(--fs-body) - 12px) / 2); font-size: 12px; color: var(--s-500); }
  /* The plan card is a desktop sidebar only; below 1200px the closing WhatsApp section is the page's one CTA. */
  .side { display: none; }
  @media (min-width: 1200px) { .side { display: grid; gap: var(--space-4); align-content: start; position: sticky; top: calc(var(--header-h) + var(--space-6)); align-self: start; } }
</style>
