---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import TourCard from '../../components/TourCard.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import { img, srcset } from '../../config';
import { catPath, tourPath } from '../../utils';

const cats = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const tours = await getCollection('tours');
const hero = 'photo-1578556881786-851d4b79cb73';
const list = { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: tours.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(tourPath(t), Astro.site).href, name: t.data.title })) };
---
<Base title="Bhutan Tour Packages" description="Browse Bhutan tour packages by theme — cultural, festival, trekking, luxury, family and off-the-beaten-path journeys. SDF, visa, guide and hotels included." image={hero} schema={list}>
  <section class="banner">
    <img src={img(hero, 1600)} srcset={srcset(hero)} sizes="100vw" alt="Tiger's Nest monastery in Paro" width="1600" height="700" fetchpriority="high" />
    <div><Breadcrumbs items={[['Tours']]} light /><h1>Bhutan tour packages</h1></div>
  </section>

  <nav class="section cats" aria-label="Tour categories">
    <div class="container">
      <div class="sh sh--split" data-reveal><h2>Browse by theme</h2><p>Every package includes the Sustainable Development Fee, visa, licensed guide, private vehicle and certified hotels.</p></div>
      <ul data-reveal="stagger">
        {cats.map((c) => (
          <li><a href={catPath(c.id)}><img src={img(c.data.image, 200)} alt="" width="56" height="42" loading="lazy" /><span>{c.data.menuTitle}</span><Icon name="arrow-right" /></a></li>
        ))}
      </ul>
    </div>
  </nav>

  <section class="section section--flush">
    <div class="container">
      <div class="sh sh--split"><h2>All tour packages</h2><p>Every package can be tailored to your dates, pace and interests.</p></div>
      <div class="grid-3 tours">{tours.map((t, i) => <TourCard tour={t} eager={i < 3} />)}</div>
    </div>
  </section>
  <WhatsAppCta about="your tour packages" />
</Base>
<style>
  .cats ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 0 40px; list-style: none; margin: 0; padding: 0; }
  .cats a { display: flex; align-items: center; gap: 16px; min-height: 72px; padding: 14px 0; border-top: 1px solid var(--border-dark); font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: var(--ls-title); font-weight: 600; color: var(--ink); transition: color var(--dur-1); }
  .cats img { width: 56px; height: 42px; border-radius: var(--r-sm); object-fit: cover; background: var(--s-50); }
  .cats span { flex: 1; }
  .cats a :global(.icon) { font-size: 13px; color: var(--text-3); transition: translate var(--dur-2) var(--ease-out), color var(--dur-2); }
  @media (hover: hover) { .cats a:hover span { text-decoration: underline 1.5px var(--p-500); text-underline-offset: 5px; } .cats a:hover :global(.icon) { translate: 3px 0; color: var(--ink); } }
  .tours { row-gap: 48px; }
</style>
