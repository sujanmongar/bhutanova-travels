---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TourCard from '../../../components/TourCard.astro';
import WhatsAppCta from '../../../components/WhatsAppCta.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { img, srcset } from '../../../config';
import { TOURS } from '../../../utils';

export async function getStaticPaths() {
  const tours = await getCollection('tours');
  return (await getCollection('categories')).map((cat) => ({ params: { cat: cat.id }, props: { cat, tours: tours.filter((t) => t.data.category.id === cat.id) } }));
}
const { cat, tours } = Astro.props;
---
<Base title={cat.data.title} description={cat.data.excerpt} image={cat.data.image} seo={cat.data.seo}>
  <section class="banner">
    <img src={img(cat.data.image, 1600)} srcset={srcset(cat.data.image)} sizes="100vw" alt="" width="1600" height="560" fetchpriority="high" />
    <div>
      <Breadcrumbs items={[['Tours', TOURS], [cat.data.menuTitle]]} light />
      <h1>{cat.data.menuTitle}</h1>
      <p class="banner__line">{cat.data.excerpt}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="count t-meta">{tours.length} {tours.length === 1 ? 'package' : 'packages'} · each one can be tailored to your dates</p>
      {tours.length ? <div class="grid-3 tours">{tours.map((t, i) => <TourCard tour={t} eager={i < 3} />)}</div>
        : <p class="t-lead">New packages coming soon — <a class="accent" href="/contact/">ask us for a custom trip</a>.</p>}
    </div>
  </section>
  <WhatsAppCta about={cat.data.menuTitle.toLowerCase()} />
</Base>
<style>
  .count { margin-bottom: 28px; }
  .tours { row-gap: 48px; }
</style>
