---
// A theme page (/bhutan-tours/<theme>/, opened from the Tours menu): the theme's banner, then its tours in the tour finder
// (theme tabs to move between themes, Duration and Sort). The Tours hub (/bhutan-tours/) keeps the theme cards.
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import BannerImg from '../../../components/BannerImg.astro';
import TourFinder from '../../../components/TourFinder.astro';
import WhatsAppCta from '../../../components/WhatsAppCta.astro';
import { TOURS, tourPath } from '../../../utils';

export async function getStaticPaths() {
  return (await getCollection('categories')).map((cat) => ({ params: { cat: cat.id }, props: { cat } }));
}
const { cat } = Astro.props;
const tours = (await getCollection('tours')).filter((t) => t.data.category.id === cat.id);
const list = { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: tours.map((t, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(tourPath(t), Astro.site).href, name: t.data.title })) };
---
<Base title={cat.data.title} description={cat.data.excerpt} image={cat.data.image} seo={cat.data.seo} schema={list}>
  <section class="banner">
    <BannerImg src={cat.data.image} />
    <div>
      <Breadcrumbs items={[['Tours', TOURS], [cat.data.menuTitle]]} light />
      <h1>{cat.data.menuTitle}</h1>
      <p class="banner__line">{cat.data.excerpt}</p>
    </div>
  </section>
  <TourFinder current={cat} />
  <WhatsAppCta about={cat.data.menuTitle.toLowerCase()} />
</Base>
