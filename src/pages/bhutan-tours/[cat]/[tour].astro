---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Form from '../../../components/Form.astro';
import Faq from '../../../components/Faq.astro';
import TourCard from '../../../components/TourCard.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PlanCta from '../../../components/PlanCta.astro';
import { img, srcset, SITE, wa, tel } from '../../../config';
import { TOURS, catPath } from '../../../utils';

export async function getStaticPaths() {
  return (await getCollection('tours')).map((tour) => ({
    params: { cat: tour.data.category.id, tour: `${tour.data.days}-days-${tour.id}` },
    props: { tour },
  }));
}
const { tour } = Astro.props;
const t = tour.data;
const cat = await getEntry(t.category);
const gallery = t.gallery.length ? t.gallery : [t.image];
const faqs = (await getEntry('faqs', 'faqs'))?.data.items ?? [];
// Same category first, topped up with other tours so the row is never short
const others = (await getCollection('tours')).filter((x) => x.id !== tour.id);
const related = [...others.filter((x) => x.data.category.id === t.category.id), ...others.filter((x) => x.data.category.id !== t.category.id)].slice(0, 6);

// ponytail: paragraphs + "- " bullets only; swap for a markdown lib if editors need bold/links here.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const md = (s: string) =>
  s.trim().split(/\n\s*\n/).map((b) => {
    const lines = b.split('\n').map((l) => l.trim());
    return lines.every((l) => l.startsWith('- '))
      ? `<ul>${lines.map((l) => `<li>${esc(l.slice(2))}</li>`).join('')}</ul>`
      : `<p>${esc(lines.join(' '))}</p>`;
  }).join('');

const tabs = [
  ['highlights', 'Highlights', t.highlights.length || 1],
  ['itinerary', 'Itinerary', t.itinerary.length],
  ['map', 'Route map', t.map],
  ['inclusions', 'Inclusions & exclusions', t.inclusions.length + t.exclusions.length],
  ['additional-info', 'Additional information', t.priceNotes.length],
  ['faq', 'Common questions', faqs.length],
].filter((x) => x[2]);
// Trip facts, shown under the highlights: only what "Inclusions & exclusions" doesn't already say (no hotels, meals,
// guide or transport there). The tour's own fields show only when filled in.
const tripFacts = ([
  ['location-dot', 'Destinations', [...new Set(t.route.map((r) => r.replace(/\s*\(.*?\)\s*$/, '')))].join(', ')],
  ['users-three', 'Group size', t.groupSize],
  ['identification-badge', 'Guide languages', t.guideLanguages],
  ['mountains', 'Max altitude', t.maxAltitude],
  ['gauge', 'Best season', t.bestSeason],
] as const).filter(([, , v]) => v);
const url = new URL(Astro.url.pathname, Astro.site).href;
const chat = wa(url, t.title);
const price = t.price.toLocaleString('en-US');
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'TouristTrip', name: t.title, description: t.summary, url,
    image: gallery.map((g) => img(g, 1200)),
    touristType: cat.data.menuTitle,
    itinerary: { '@type': 'ItemList', itemListElement: t.itinerary.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.title })) },
    offers: { '@type': 'Offer', price: t.price, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url },
    provider: { '@id': new URL('/#org', Astro.site).href },
  },
];
// The route map is never cropped, so its real size (from the Sanity file name, …-WxH.ext) keeps the layout from shifting
const [mapW, mapH] = t.map?.match(/-(\d+)x(\d+)\./)?.slice(1).map(Number) ?? [1200, 800];
---
<Base title={`${t.title} – ${t.nights} nights / ${t.days} days Bhutan tour`} description={t.summary} image={t.image} schema={schema} seo={t.seo}>
  <!-- What the tour is comes first: breadcrumb, title, summary, length, theme and places, then the photos -->
  <div class="container head">
    <Breadcrumbs items={[['Tours', TOURS], [cat.data.menuTitle, catPath(cat.id)], [t.title]]} />
    <h1>{t.title}</h1>
    <p class="lead t-body">{t.summary}</p>
    <ul class="facts t-label muted">
      <li><Icon name="clock" />{t.days} days · {t.nights} nights</li>
      <li><Icon name="ph_compass" />{cat.data.menuTitle}</li>
      <li><Icon name="users-three" />Private tour</li>
    </ul>
  </div>

  <!-- Gallery: the CDN crops every file to its frame (4:3 on phones, 3:2 from 768px); it moves on its own (script below) -->
  <div class="gal">
    <div class="gal__track" id="gal">
      {gallery.map((g, i) => (
        <button type="button" class="gal__open" data-view={i} aria-label={`View photo ${i + 1} of ${gallery.length} full screen`}>
        <picture>
          <source media="(max-width: 767px)" srcset={srcset(g, [480, 800, 1200], 4 / 3)} sizes="100vw" />
          <img src={img(g, 1200, 800)} srcset={srcset(g, [480, 800, 1200, 1600], 3 / 2)} sizes="(min-width:1200px) 756px, calc(72vw - 46px)"
            alt={`${t.title} photo ${i + 1}`} width="1200" height="800" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async"
            style={i === 0 ? 'view-transition-name: hero-img' : undefined} />
        </picture>
        </button>
      ))}
    </div>
    {gallery.length > 1 && (
      <div data-rail="gal">
        <button type="button" class="gal__btn gal__btn--prev" aria-label="Previous photo"><Icon name="chevron-left" /></button>
        <button type="button" class="gal__btn gal__btn--next" aria-label="Next photo"><Icon name="chevron-right" /></button>
      </div>
    )}
  </div>

  <!-- Phones/tablets: photos → price card → sections → help card. From 1200px both cards sit in a sticky sidebar. -->
  <div class="container layout">
    <div class="side">
    <aside class="price-card" aria-label="Price">
      <p class="t-label subtle">From</p>
      <p class="price num t-label subtle"><b class="t-price"><abbr class="t-label" title="US dollars">USD</abbr> {price}</b> / person</p>
      <button class="btn btn--primary btn--block btn--lg" type="button" data-open-enquiry>Send an enquiry</button>
    </aside>
    <div class="help">
      <PlanCta title="Need help booking?" text="Talk to a local trip expert — we'll tailor this tour to your dates." action={{ href: tel(SITE.phone), label: `Call ${SITE.phone}`, icon: 'phone' }} topic={t.title} />
    </div>
    </div>

    <div class="main">
      <nav class="tabs" aria-label="Tour sections">
        {tabs.map(([id, label]) => <a class="t-label" href={`#${id}`}>{label}</a>)}
      </nav>

      {(t.highlights.length > 0 || tripFacts.length > 0) && (
        <section id="highlights" class="block">
          <h2>{t.highlights.length > 0 ? 'Highlights' : 'Trip facts'}</h2>
          {t.highlights.length > 0 && <ul class="bullets">{t.highlights.map((h) => <li class="t-body"><Icon name="check" />{h}</li>)}</ul>}
          {tripFacts.length > 0 && (
            <div class="trip">
              {t.highlights.length > 0 && <h3 class="t-card">Trip facts</h3>}
              <dl class="trip__list">
                {tripFacts.map(([icon, label, value]) => (
                  <div>
                    <dt class="t-label subtle"><Icon name={icon} />{label}</dt>
                    <dd class="t-body">{value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
        </section>
      )}

      {t.itinerary.length > 0 && (
        <section id="itinerary" class="block">
          <h2>Itinerary</h2>
          <ol class="days">
            {t.itinerary.map((d, i) => (
              <li>
                <details open={i === 0}>
                  <summary><h3 class="t-card">{d.title}</h3><Icon name="chevron-up" class="chev" /></summary>
                  <div class="day">
                    {d.places.length === 0 && d.image && <img src={img(d.image, 900, 400)} srcset={srcset(d.image, [600, 900, 1360], 9 / 4)} sizes="(min-width:768px) 680px, calc(100vw - 72px)"
                      alt="" width="900" height="400" loading="lazy" decoding="async" />}
                    <Fragment set:html={md(d.body)} />
                    {d.overnight && <p class="overnight t-caption muted"><Icon name="ph_bed" />Overnight: {d.overnight}</p>}
                    {/* The day's sights at the end of the day: a swipeable row of cards linking to their own pages
                        (a sight without a page links to its destination) */}
                    {d.places.length > 0 && (
                      <div class="stops-wrap">
                        <p class="t-label subtle">Places on this day</p>
                        <ul class="stops">
                          {d.places.map((p) => (
                            <li>
                              <a href={p._type === 'destination' ? `/destinations/${p.slug}/` : p.page ? `/destinations/${p.dest}/${p.slug}/` : `/destinations/${p.dest}/`}>
                                {p.image && <img src={img(p.image, 480, 360)} srcset={srcset(p.image, [240, 480, 720], 4 / 3)} sizes="240px" alt="" width="480" height="360" loading="lazy" decoding="async" />}
                                <span class="stops__t t-label">{p.title}</span>
                                {p.excerpt && <span class="stops__x t-caption muted">{p.excerpt}</span>}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </details>
              </li>
            ))}
          </ol>
        </section>
      )}

      {t.map && (
        <section id="map" class="block">
          <h2>Route map</h2>
          <img class="map" src={img(t.map, 1200)} srcset={srcset(t.map, [600, 900, 1600])} sizes="(min-width:1200px) 776px, (min-width:768px) calc(100vw - 64px), calc(100vw - 32px)"
            alt={`Route map for ${t.title}`} width={mapW} height={mapH} loading="lazy" decoding="async" />
        </section>
      )}

      {(t.inclusions.length > 0 || t.exclusions.length > 0) && (
        <section id="inclusions" class="block">
          <h2>Inclusions & exclusions</h2>
          <div class="inc">
            {t.inclusions.length > 0 && (
              <div>
                <h3 class="t-card">What's included</h3>
                <ul class="checks">{t.inclusions.map((x) => <li class="t-body"><Icon name="check" class="ok" />{x}</li>)}</ul>
              </div>
            )}
            {t.exclusions.length > 0 && (
              <div>
                <h3 class="t-card">Not included</h3>
                <ul class="checks">{t.exclusions.map((x) => <li class="t-body"><Icon name="close" class="no" />{x}</li>)}</ul>
              </div>
            )}
          </div>
        </section>
      )}

      {t.priceNotes.length > 0 && (
        <section id="additional-info" class="block">
          <h2>Additional information</h2>
          <ul class="notes t-body">{t.priceNotes.map((n) => <li>{n}</li>)}</ul>
        </section>
      )}

      {faqs.length > 0 && (
        <section id="faq" class="block">
          <h2>Common questions</h2>
          <Faq items={faqs} />
        </section>
      )}

    </div>
  </div>

  {related.length > 0 && (
    <section class="section section--grey">
      <div class="container">
        <div class="sh" data-reveal><h2>More Bhutan tours</h2></div>
        <div class="rail" data-reveal="stagger">{related.map((r) => <TourCard tour={r} rail />)}</div>
      </div>
    </section>
  )}

  <!-- Mobile/tablet sticky booking bar -->
  <div class="bar">
    <p class="num"><small class="t-label subtle">From</small><b class="t-price"><abbr class="t-label" title="US dollars">USD</abbr> {price}</b></p>
    <a class="btn btn--outline bar__wa" href={chat} target="_blank" rel="noopener" aria-label="Chat on WhatsApp about this tour"><Icon name="social_whatsapp" /></a>
    <button class="btn btn--primary" type="button" data-open-enquiry>Enquire</button>
  </div>

  <dialog class="sheet enq" id="enquiry" aria-labelledby="enq-title">
    <div class="sheet__in">
      <div class="sheet__head">
        <p class="t-card" id="enq-title">Enquire about this tour</p>
        <button type="button" class="sheet__close" aria-label="Close" data-close><Icon name="close" /></button>
      </div>
      <div class="enq__tour">
        <img src={img(t.image, 288, 216)} alt="" width="96" height="72" loading="lazy" decoding="async" />
        <div><p class="t-title">{t.title}</p><p class="num t-label">{t.days} days · From <b>USD {price}</b></p></div>
      </div>
      {/* No form endpoint yet, so the form only opens the visitor's mail app: WhatsApp leads until one is set */}
      {!SITE.formEndpoint && (
        <>
          <a class="btn btn--primary btn--block btn--lg" href={chat} target="_blank" rel="noopener"><Icon name="social_whatsapp" />Chat on WhatsApp</a>
          <p class="enq__or t-caption subtle">Or send your details by email</p>
        </>
      )}
      <Form subject={`Enquiry: ${t.title}`} class="enq__form">
        <input type="hidden" name="package" value={`${t.title} (${t.nights} nights / ${t.days} days)`} />
        <div class="field full"><label for="e-name">Full name *</label><input class="input" id="e-name" name="name" autocomplete="name" required /></div>
        <div class="field full"><label for="e-email">Email address *</label><input class="input" id="e-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field"><label for="e-count">Travelers *</label><input class="input" id="e-count" name="travelers" type="number" inputmode="numeric" min="1" value="2" required /></div>
        <div class="field"><label for="e-arr">Arrival *</label><input class="input" id="e-arr" name="arrival" type="date" required /></div>
        <div class="field full"><label for="e-phone">Phone (with country code)</label><input class="input" id="e-phone" name="phone" type="tel" autocomplete="tel" placeholder="+1 555 000 0000" /></div>
        <div class="field full"><label for="e-nat">Nationality</label><input class="input" id="e-nat" name="nationality" autocomplete="country-name" /></div>
        <div class="field full"><label for="e-msg">Your message</label><textarea class="input" id="e-msg" name="message" placeholder="Anything we should know?"></textarea></div>
        <button class:list={['btn btn--block btn--lg full', SITE.formEndpoint ? 'btn--primary' : 'btn--outline']}>Send enquiry</button>
      </Form>
    </div>
  </dialog>

  <!-- Full-screen photo viewer: swipe on phones, arrows / keyboard on desktop, Esc or the close button to leave -->
  <dialog class="lb" id="lb" aria-label={`${t.title} photos`}>
    <button type="button" class="lb__close" aria-label="Close photos" data-lb-close><Icon name="close" /></button>
    <div class="lb__track" data-lb-track>
      {gallery.map((g, i) => (
        <figure><img src={img(g, 1600)} srcset={srcset(g, [800, 1200, 1600, 2400])} sizes="100vw" alt={`${t.title} photo ${i + 1}`} loading="lazy" decoding="async" /></figure>
      ))}
    </div>
    {gallery.length > 1 && (
      <>
        <button type="button" class="lb__btn lb__btn--prev" aria-label="Previous photo" data-lb-step="-1"><Icon name="chevron-left" /></button>
        <button type="button" class="lb__btn lb__btn--next" aria-label="Next photo" data-lb-step="1"><Icon name="chevron-right" /></button>
      </>
    )}
    <p class="lb__count t-label" aria-live="polite" data-lb-count>1 / {gallery.length}</p>
  </dialog>
</Base>

<script>
  const dlg = document.getElementById('enquiry') as HTMLDialogElement;
  document.querySelectorAll('[data-open-enquiry]').forEach((b) => b.addEventListener('click', () => dlg.showModal()));

  // Photo viewer
  const lb = document.getElementById('lb') as HTMLDialogElement;
  const lbTrack = lb.querySelector<HTMLElement>('[data-lb-track]')!;
  const lbCount = lb.querySelector<HTMLElement>('[data-lb-count]')!;
  const total = lbTrack.children.length;
  const at = () => Math.round(lbTrack.scrollLeft / lbTrack.clientWidth);
  const go = (i: number, instant = false) => lbTrack.scrollTo({ left: Math.max(0, Math.min(total - 1, i)) * lbTrack.clientWidth, behavior: instant ? 'instant' : 'smooth' });
  document.querySelectorAll<HTMLElement>('[data-view]').forEach((b) => b.addEventListener('click', () => {
    lb.showModal();
    go(Number(b.dataset.view), true);
  }));
  lbTrack.addEventListener('scroll', () => (lbCount.textContent = `${at() + 1} / ${total}`), { passive: true });
  lb.querySelectorAll<HTMLElement>('[data-lb-step]').forEach((b) => b.addEventListener('click', () => go(at() + Number(b.dataset.lbStep))));
  lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
  lb.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') go(at() + 1); if (e.key === 'ArrowLeft') go(at() - 1); });
  // .sheet__in fills the dialog, so target === dialog means a backdrop tap
  dlg.addEventListener('click', (e) => { const t = e.target as Element; if (t === dlg || t.closest('[data-close]')) dlg.close(); });

  // Tabs: highlight the section in view and keep the active tab visible
  const tabs = document.querySelector<HTMLElement>('.tabs')!;
  const links = [...tabs.querySelectorAll<HTMLAnchorElement>('a')];
  const spy = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    links.forEach((a) => {
      if (a.hash === '#' + e.target.id) { a.setAttribute('aria-current', 'location'); tabs.scrollTo({ left: a.offsetLeft - (tabs.clientWidth - a.offsetWidth) / 2, behavior: 'smooth' }); }
      else a.removeAttribute('aria-current');
    });
  }), { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('.block[id]').forEach((s) => spy.observe(s));

  // Gallery: next photo every 4.5s while it's on screen, back to the first after the last. Hover or focus pauses it; a swipe,
  // a sideways scroll or the arrows hand it to the visitor for good. Nothing moves for reduced motion.
  const gal = document.getElementById('gal');
  if (gal && gal.children.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let playing = true, seen = false, touching = false;
    const stop = () => (playing = false);
    gal.addEventListener('touchstart', () => (touching = true), { passive: true });
    addEventListener('touchend', () => (touching = false), { passive: true });
    gal.addEventListener('scroll', () => { if (touching) stop(); }, { passive: true });
    gal.addEventListener('wheel', (e) => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) stop(); }, { passive: true });
    gal.parentElement!.querySelectorAll('.gal__btn, .gal__open').forEach((b) => b.addEventListener('click', stop));
    new IntersectionObserver(([e]) => (seen = e.isIntersecting), { threshold: 0.5 }).observe(gal);
    setInterval(() => {
      if (!playing || !seen || document.hidden || gal.matches(':hover, :focus-within')) return;
      const [a, b] = gal.children as unknown as HTMLElement[];
      const atEnd = gal.scrollLeft + gal.clientWidth >= gal.scrollWidth - 2;
      gal.scrollTo({ left: atEnd ? 0 : gal.scrollLeft + (b.offsetLeft - a.offsetLeft), behavior: 'smooth' });
    }, 4500);
  }

  // Hide the booking bar while the price card (same action) is on screen
  const bar = document.querySelector('.bar');
  const pc = document.querySelector('.price-card');
  if (bar && pc) new IntersectionObserver(([e]) => bar.classList.toggle('is-off', e.isIntersecting)).observe(pc);
</script>

<style>
  /* Gallery: full-bleed 4:3 on phones, centred 3:2 with side peeks on tablet/desktop */
  .gal { position: relative; margin-top: var(--space-8); }
  .gal__track { display: flex; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .gal__track::-webkit-scrollbar { display: none; }
  .gal__open { flex: 0 0 100%; scroll-snap-align: center; display: block; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .gal__open picture { display: block; }
  .gal__track img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--s-50); }
  .gal__btn {
    position: absolute; top: 50%; translate: 0 -50%; display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%;
    background: rgb(255 255 255 / .92); color: var(--s-800); font-size: 15px; cursor: pointer; box-shadow: 0 6px 20px -4px rgb(12 25 37 / .35);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); transition: opacity var(--dur-2), scale var(--dur-1) var(--ease-out), background var(--dur-1);
  }
  .gal__btn:hover { background: #fff; }
  .gal__btn:not(:disabled):active { scale: .92; }
  .gal__btn:disabled { opacity: 0; pointer-events: none; }
  .gal__btn--prev { left: var(--space-4); } .gal__btn--next { right: var(--space-4); }
  @media (min-width: 768px) {
    .gal { max-width: calc(var(--container) + var(--gutter) * 2); margin: var(--space-10) auto 0; padding-inline: var(--gutter); }
    .gal__track { gap: var(--space-3); border-radius: var(--radius); corner-shape: squircle; }
    .gal__open { flex-basis: 72%; }
    .gal__track img { aspect-ratio: 3 / 2; border-radius: var(--radius); corner-shape: squircle; }
    .gal__btn { width: 48px; height: 48px; }
    .gal__btn--prev { left: calc(var(--gutter) + var(--space-6)); } .gal__btn--next { right: calc(var(--gutter) + var(--space-6)); }
  }
  @media (min-width: 1200px) { .gal__open { flex-basis: 63%; } }

  /* Full-screen photo viewer */
  .lb { --focus: #fff; width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0; overflow: hidden; background: rgb(8 16 24 / .96); color: #fff; }
  /* Nothing behind the viewer scrolls while it's open */
  :global(html:has(dialog.lb[open])) { overflow: hidden; }
  .lb::backdrop { background: rgb(8 16 24 / .96); }
  .lb__track { display: flex; height: 100%; overflow-x: auto; overflow-y: hidden; overscroll-behavior: contain; scroll-snap-type: x mandatory; scrollbar-width: none; touch-action: pan-x; }
  .lb__track::-webkit-scrollbar { display: none; }
  .lb__track figure { flex: 0 0 100%; height: 100%; min-height: 0; display: grid; place-items: center; margin: 0; padding: var(--space-16) var(--space-4); scroll-snap-align: center; }
  /* Each photo fits the screen: never taller than the viewer (minus room for the close button and counter) */
  .lb__track img { width: auto; height: auto; max-width: 100%; max-height: calc(100dvh - var(--space-16) * 2); object-fit: contain; border-radius: var(--r-sm); }
  .lb__close, .lb__btn { position: absolute; z-index: 2; display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgb(255 255 255 / .14); color: #fff; font-size: 16px; cursor: pointer; }
  .lb__close { top: calc(var(--space-4) + env(safe-area-inset-top, 0px)); right: var(--space-4); }
  .lb__btn { top: 50%; translate: 0 -50%; display: none; }
  .lb__count { position: absolute; left: 50%; bottom: calc(var(--space-6) + env(safe-area-inset-bottom, 0px)); translate: -50% 0; color: var(--on-dark-2); }
  @media (min-width: 768px) { .lb__btn { display: grid; } .lb__btn--prev { left: var(--space-6); } .lb__btn--next { right: var(--space-6); } }

  /* Layout */
  .head { padding-top: var(--space-6); }
  .layout { display: grid; gap: var(--space-8); padding-block: var(--space-10) var(--section); } /* breathing space after the photos */
  .layout > *, .side > * { min-width: 0; }
  /* Phones/tablets: the sidebar dissolves so its two cards take their own places in the page */
  .side { display: contents; }
