---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import Form from '../../../components/Form.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { img, srcset, SITE, wa } from '../../../config';
import { TOURS, catPath } from '../../../utils';

export async function getStaticPaths() {
  return (await getCollection('tours')).map((tour) => ({
    params: { cat: tour.data.category.id, tour: `${tour.data.days}-days-${tour.id}` },
    props: { tour },
  }));
}
const { tour } = Astro.props;
const t = tour.data;
const cat = await getEntry(t.category);
const gallery = t.gallery.length ? t.gallery : [t.image];

// ponytail: paragraphs + "- " bullets only; swap for a markdown lib if editors need bold/links here.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const md = (s: string) =>
  s.trim().split(/\n\s*\n/).map((b) => {
    const lines = b.split('\n').map((l) => l.trim());
    return lines.every((l) => l.startsWith('- '))
      ? `<ul>${lines.map((l) => `<li>${esc(l.slice(2))}</li>`).join('')}</ul>`
      : `<p>${esc(lines.join(' '))}</p>`;
  }).join('');

const tabs = [
  ['overview', 'Overview'],
  ['highlights', 'Highlights', t.highlights.length],
  ['itinerary', 'Day by day', t.itinerary.length],
  ['inclusions', "What's included", t.inclusions.length + t.exclusions.length],
  ['map', 'Map', t.map],
].filter((x) => x.length === 2 || x[2]);
const tel = SITE.phone.replace(/\s/g, '');
const chat = (anchor: string) => wa(`${new URL(Astro.url.pathname, Astro.site).href}#${anchor}`, t.title);
const url = new URL(Astro.url.pathname, Astro.site).href;
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'TouristTrip', name: t.title, description: t.summary, url,
    image: gallery.map((g) => img(g, 1200)),
    touristType: cat.data.menuTitle,
    itinerary: { '@type': 'ItemList', itemListElement: t.itinerary.map((d, i) => ({ '@type': 'ListItem', position: i + 1, name: d.title })) },
    offers: { '@type': 'Offer', price: t.price, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url },
    provider: { '@id': new URL('/#org', Astro.site).href },
  },
];
---
<Base title={`${t.title} – ${t.nights}N/${t.days}D Bhutan Tour`} description={t.summary} image={t.image} schema={schema} seo={t.seo}>
  <!-- Gallery -->
  <div class="gal">
    <div class="gal__track" id="gal">
      {gallery.map((g, i) => (
        <img src={img(g, 1200)} srcset={srcset(g, [480, 800, 1200])} sizes="(min-width:1200px) 700px, 100vw" alt={`${t.title} photo ${i + 1}`}
          width="1200" height="800" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async"
          style={i === 0 ? 'view-transition-name: hero-img' : undefined} />
      ))}
    </div>
    {gallery.length > 1 && (
      <div data-rail="gal">
        <button type="button" class="gal__btn gal__btn--prev" aria-label="Previous photo"><Icon name="chevron-left" /></button>
        <button type="button" class="gal__btn gal__btn--next" aria-label="Next photo"><Icon name="chevron-right" /></button>
      </div>
    )}
  </div>

  <div class="container layout">
    <div class="main">
      <Breadcrumbs items={[['Tours', TOURS], [cat.data.menuTitle, catPath(cat.id)], [t.title]]} />
      <h1>{t.title}</h1>
      <ul class="facts t-small">
        <li><Icon name="gauge" />{t.days} days · {t.nights} nights</li>
        <li><Icon name="location-dot" />{t.route.length} stops</li>
        <li><Icon name="people" />Private tour</li>
      </ul>
      <p class="route t-small">{t.route.map((r, i) => <>{i > 0 && <Icon name="arrow-right" />}<span>{r}</span></>)}</p>

      <nav class="tabs" aria-label="Tour sections">
        {tabs.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>

      <section id="overview" class="block">
        <h2>Overview</h2>
        <p class="lead">{t.summary}</p>
      </section>

      {t.highlights.length > 0 && (
        <section id="highlights" class="block">
          <h2>Highlights</h2>
          <ul class="bullets">{t.highlights.map((h) => <li><Icon name="check" />{h}</li>)}</ul>
        </section>
      )}

      {t.itinerary.length > 0 && (
        <section id="itinerary" class="block">
          <h2>Day by day</h2>
          <ol class="days">
            {t.itinerary.map((d, i) => (
              <li>
                <details open={i === 0}>
                  <summary>{d.title}<Icon name="chevron-up" class="chev" /></summary>
                  <div class="day">
                    {d.image && <img src={img(d.image, 900)} alt="" width="900" height="400" loading="lazy" />}
                    <Fragment set:html={md(d.body)} />
                    {d.overnight && <p class="overnight t-small"><Icon name="hotel" />Overnight: {d.overnight}</p>}
                  </div>
                </details>
              </li>
            ))}
          </ol>
        </section>
      )}

      {t.inclusions.length > 0 && (
        <section id="inclusions" class="block">
          <div class="inc">
            <div>
              <h2>What's included</h2>
              <ul class="checks">{t.inclusions.map((x) => <li><Icon name="check" class="ok" />{x}</li>)}</ul>
            </div>
            {t.exclusions.length > 0 && (
              <div>
                <h2>Not included</h2>
                <ul class="checks">{t.exclusions.map((x) => <li><Icon name="close" class="no" />{x}</li>)}</ul>
              </div>
            )}
          </div>
        </section>
      )}

      {t.map && (
        <section id="map" class="block">
          <h2>Route map</h2>
          <img class="map" src={img(t.map, 1000)} alt={`Route map for ${t.title}`} loading="lazy" />
        </section>
      )}
    </div>

    <aside class="side">
      <div class="price-card">
        <p class="t-meta">From</p>
        <p class="price num t-meta"><b><abbr title="US dollars">USD</abbr> {t.price.toLocaleString('en-US')}</b> / person</p>
        {t.priceNotes.length > 0 && (
          <details class="notes">
            <summary>Show all prices<Icon name="chevron-up" class="chev" /></summary>
            <ul>{t.priceNotes.map((n) => <li>{n}</li>)}</ul>
          </details>
        )}
        <button class="btn btn--primary btn--block btn--lg" type="button" data-open-enquiry>Send an enquiry<Icon name="arrow-right" class="i-end" /></button>
        <p class="assure t-meta"><Icon name="check" />No payment needed to enquire</p>
      </div>
      <div class="help-card">
        <span class="help-card__ic" aria-hidden="true"><Icon name="headphones" /></span>
        <h2 class="t-title">Need help booking?</h2>
        <p class="t-small">Talk to a local trip expert — we'll tailor this tour to your dates.</p>
        <a class="btn btn--outline btn--block" href={`tel:${tel}`}><Icon name="phone" />Call {SITE.phone}</a>
        <a class="btn btn--soft btn--block" href={chat('overview')} target="_blank" rel="noopener"><Icon name="social_whatsapp" />Chat on WhatsApp</a>
      </div>
    </aside>
  </div>

  <!-- Mobile/tablet sticky booking bar -->
  <div class="bar">
    <p class="num"><small class="t-meta">From</small><b><abbr title="US dollars">USD</abbr> {t.price.toLocaleString('en-US')}</b></p>
    <a class="bar__wa" href={chat('overview')} target="_blank" rel="noopener" aria-label="Chat on WhatsApp about this tour"><Icon name="social_whatsapp" /></a>
    <button class="btn btn--primary" type="button" data-open-enquiry>Send an enquiry</button>
  </div>

  <dialog class="sheet enq" id="enquiry" aria-labelledby="enq-title">
    <div class="sheet__in">
      <div class="sheet__head">
        <h2 id="enq-title">Enquire about this tour</h2>
        <button type="button" class="sheet__close" aria-label="Close" data-close><Icon name="close" /></button>
      </div>
      <div class="enq__tour">
        <img src={img(t.image, 300)} alt="" width="96" height="72" />
        <div><h3>{t.title}</h3><p class="num">{t.days} days · From <b>USD {t.price.toLocaleString('en-US')}</b></p></div>
      </div>
      <Form subject={`Enquiry: ${t.title}`} class="enq__form">
        <input type="hidden" name="package" value={t.title} />
        <div class="field full"><label for="e-name">Full name *</label><input class="input" id="e-name" name="name" autocomplete="name" required /></div>
        <div class="field full"><label for="e-email">Email address *</label><input class="input" id="e-email" name="email" type="email" autocomplete="email" required /></div>
        <div class="field full"><label for="e-phone">Phone (with country code) *</label><input class="input" id="e-phone" name="phone" type="tel" autocomplete="tel" placeholder="+1 555 000 0000" required /></div>
        <div class="field"><label for="e-nat">Nationality *</label><input class="input" id="e-nat" name="nationality" autocomplete="country-name" required /></div>
        <div class="field"><label for="e-count">Travelers *</label><input class="input" id="e-count" name="travelers" type="number" inputmode="numeric" min="1" value="2" required /></div>
        <div class="field"><label for="e-arr">Arrival *</label><input class="input" id="e-arr" name="arrival" type="date" required /></div>
        <div class="field"><label for="e-dep">Departure *</label><input class="input" id="e-dep" name="departure" type="date" required /></div>
        <div class="field full"><label for="e-msg">Your message</label><textarea class="input" id="e-msg" name="message" placeholder="Anything we should know?"></textarea></div>
        <button class="btn btn--primary btn--block btn--lg full">Send enquiry</button>
      </Form>
    </div>
  </dialog>
</Base>

<script>
  const dlg = document.getElementById('enquiry') as HTMLDialogElement;
  document.querySelectorAll('[data-open-enquiry]').forEach((b) => b.addEventListener('click', () => dlg.showModal()));
  // .sheet__in fills the dialog, so target === dialog means a backdrop tap
  dlg.addEventListener('click', (e) => { const t = e.target as Element; if (t === dlg || t.closest('[data-close]')) dlg.close(); });

  // Tabs: highlight the section in view and keep the active tab visible
  const tabs = document.querySelector<HTMLElement>('.tabs')!;
  const links = [...tabs.querySelectorAll<HTMLAnchorElement>('a')];
  const spy = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    links.forEach((a) => {
      if (a.hash === '#' + e.target.id) { a.setAttribute('aria-current', 'location'); tabs.scrollTo({ left: a.offsetLeft - (tabs.clientWidth - a.offsetWidth) / 2, behavior: 'smooth' }); }
      else a.removeAttribute('aria-current');
    });
  }), { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll('.block[id]').forEach((s) => spy.observe(s));

  // Hide the booking bar while the price card (same action) is on screen
  const bar = document.querySelector('.bar');
  const pc = document.querySelector('.price-card');
  if (bar && pc) new IntersectionObserver(([e]) => bar.classList.toggle('is-off', e.isIntersecting)).observe(pc);
</script>

<style>
  /* Gallery: full-bleed on mobile, centered with side peeks on tablet/desktop */
  .gal { position: relative; }
  .gal__track { display: flex; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .gal__track::-webkit-scrollbar { display: none; }
  .gal__track img { flex: 0 0 100%; aspect-ratio: 4 / 3; object-fit: cover; scroll-snap-align: center; background: var(--s-50); }
  .gal__btn {
    position: absolute; top: 50%; translate: 0 -50%; display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%;
    background: rgb(255 255 255 / .92); color: var(--s-800); font-size: 15px; cursor: pointer; box-shadow: 0 6px 20px -4px rgb(12 25 37 / .35);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); transition: opacity var(--dur-2), scale var(--dur-1) var(--ease-out), background var(--dur-1);
  }
  .gal__btn:hover { background: #fff; }
  .gal__btn:not(:disabled):active { scale: .92; }
  .gal__btn:disabled { opacity: 0; pointer-events: none; }
  .gal__btn--prev { left: 16px; } .gal__btn--next { right: 16px; }
  @media (min-width: 768px) {
    .gal { max-width: calc(var(--container) + var(--gutter) * 2); margin: 28px auto 0; padding-inline: var(--gutter); }
    .gal__track { gap: 10px; border-radius: var(--r-xl); }
    .gal__track img { flex-basis: 72%; aspect-ratio: 3 / 2; border-radius: var(--r-xl); }
    .gal__btn { width: 48px; height: 48px; }
    .gal__btn--prev { left: calc(var(--gutter) + 20px); } .gal__btn--next { right: calc(var(--gutter) + 20px); }
  }
  @media (min-width: 1200px) { .gal { margin-top: 36px; } .gal__track img { flex-basis: 63%; aspect-ratio: auto; height: 500px; } }

  /* Layout */
  .layout { display: grid; gap: 40px; padding-block: var(--stack) var(--section); }
  .layout > * { min-width: 0; }
  @media (min-width: 1200px) { .layout { grid-template-columns: minmax(0, 1fr) 360px; gap: 64px; } }
  .main :global(.crumbs) { margin-bottom: 16px; }
  .facts { display: flex; flex-wrap: wrap; gap: 8px 24px; list-style: none; margin: 16px 0 12px; padding: 0; }
  .facts li { display: inline-flex; align-items: center; gap: 8px; }
  .facts :global(.icon) { font-size: 14px; color: var(--text-3); }
  .route { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .route :global(.icon) { font-size: 12px; color: var(--p-500); }

  .tabs {
    position: sticky; top: var(--header-h); z-index: 5; display: flex; gap: 4px; margin: 28px calc(var(--gutter) * -1) 0; padding: 0 var(--gutter);
    background: rgb(255 255 255 / .96); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border); overflow-x: auto; scrollbar-width: none; white-space: nowrap;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tabs a { position: relative; padding: 16px 12px; font-size: var(--fs-small); line-height: var(--lh-small); font-weight: 500; color: var(--text-2); transition: color var(--dur-1); }
  .tabs a::after { content: ''; position: absolute; inset: auto 12px -1px; height: 3px; border-radius: 3px 3px 0 0; background: var(--p-500); scale: 0 1; transition: scale var(--dur-3) var(--ease-out); }
  .tabs a:hover { color: var(--ink); }
  .tabs a[aria-current] { color: var(--ink); }
  .tabs a[aria-current]::after { scale: 1 1; }
  @media (max-width: 767px) { .tabs { mask-image: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 32px), transparent); } }
  @media (min-width: 768px) { .tabs { margin-inline: 0; padding: 0; } }

  .block { padding-block: 40px; border-bottom: 1px solid var(--border); scroll-margin-top: calc(var(--header-h) + 60px); }
  .block:last-child { border-bottom: 0; }
  .block h2 { margin-bottom: 20px; font-size: var(--fs-h4); line-height: var(--lh-h4); letter-spacing: var(--ls-h4); }
  .lead { max-width: 68ch; font-size: var(--fs-lead); line-height: var(--lh-lead); color: var(--text-2); }
  .bullets { display: grid; gap: 12px; list-style: none; margin: 0; padding: 0; }
  @media (min-width: 768px) { .bullets { grid-template-columns: 1fr 1fr; column-gap: 32px; } }
  .bullets li { display: flex; gap: 12px; }
  .bullets :global(.icon) { flex: none; margin-top: calc((var(--lh-body) * 1rem - 12px) / 2); font-size: 12px; color: var(--s-500); }

  .days { list-style: none; margin: 0; padding: 0; }
  .days li { position: relative; padding-left: 40px; }
  .days li::before { content: ''; position: absolute; left: 8px; top: 15px; width: 8px; height: 8px; border-radius: 50%; background: var(--s-500); }
  .days li::after { content: ''; position: absolute; left: 11px; top: 30px; bottom: -8px; width: 2px; background: var(--border-dark); }
  .days li:last-child::after { display: none; }
  .days summary {
    display: flex; justify-content: space-between; gap: 12px; padding: 8px 0 16px; cursor: pointer; list-style: none; border-bottom: 1px solid var(--border);
    font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: var(--ls-title); font-weight: 600; color: var(--ink); transition: color var(--dur-1);
  }
  .days summary:hover { color: var(--s-500); }
  .days summary::-webkit-details-marker { display: none; }
  .days :global(.chev) { flex: none; font-size: 12px; margin-top: 6px; rotate: 180deg; transition: rotate var(--dur-2) var(--ease-out); color: var(--text-3); }
  details[open] > summary :global(.chev) { rotate: 0deg; }
  .day { display: grid; gap: 12px; max-width: 68ch; padding: 20px 0 28px; }
  .day img { border-radius: var(--r-md); width: 100%; max-height: 280px; object-fit: cover; background: var(--s-50); }
  .day :global(ul) { padding-left: 18px; display: grid; gap: 8px; margin: 0; }
  .day :global(li::marker) { color: var(--p-500); }
  .overnight { display: inline-flex; align-items: center; gap: 8px; justify-self: start; padding: 6px 12px; border-radius: var(--r-sm); background: var(--surface); }
  .overnight :global(.icon) { color: var(--p-700); }

  .inc { display: grid; gap: 32px; }
  @media (min-width: 768px) { .inc { grid-template-columns: 1.4fr 1fr; gap: 40px; } }
  .checks { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .checks li { display: flex; gap: 12px; }
  .checks :global(.icon) { flex: none; margin-top: calc((var(--lh-body) * 1rem - 12px) / 2); font-size: 12px; }
  .checks :global(.ok) { color: var(--s-500); }
  .checks :global(.no) { color: var(--text-3); }
  .map { border-radius: var(--radius); border: 1px solid var(--border); }

  /* Sidebar */
  .side { display: grid; gap: 16px; align-content: start; }
  @media (min-width: 1200px) { .side { position: sticky; top: calc(var(--header-h) + 24px); align-self: start; } }
  .price-card { display: grid; gap: 10px; padding: 24px; border: 1px solid var(--border-dark); border-radius: var(--radius); background: #fff; }
  .price b { font-size: var(--fs-card); line-height: var(--lh-card); letter-spacing: var(--ls-card); color: var(--ink); }
  .price abbr, .bar abbr { font-size: var(--fs-meta); letter-spacing: var(--ls-meta); font-weight: 500; color: var(--text-3); text-decoration: none; }
  .notes summary { display: inline-flex; align-items: center; gap: 6px; padding-block: 8px; font-size: var(--fs-small); line-height: var(--lh-ui); font-weight: 600; color: var(--s-500); cursor: pointer; list-style: none; }
  .notes summary::-webkit-details-marker { display: none; }
  .notes :global(.chev) { font-size: 10px; rotate: 180deg; transition: rotate var(--dur-2) var(--ease-out); }
  .notes ul { margin: 0 0 8px; padding-left: 18px; font-size: var(--fs-small); line-height: var(--lh-small); color: var(--text-2); display: grid; gap: 6px; }
  .price-card .btn { margin-top: 6px; }
  .assure { display: flex; align-items: center; justify-content: center; gap: 6px; }
  .assure :global(.icon) { color: var(--success); }
  .help-card { display: grid; gap: 10px; padding: 24px; border-radius: var(--radius); background: var(--surface); }
  .help-card__ic { display: none; }
  .help-card p { margin-bottom: 6px; }

  /* Mobile/tablet booking bar: body padding keeps the footer reachable underneath */
  @media (max-width: 1199px) {
    :global(body) { padding-bottom: calc(76px + env(safe-area-inset-bottom)); }
    /* Fewer fixed layers while reading: the site header scrolls away, the tabs stick to the top */
    :global(header.nav[data-nav]) { position: relative; }
    .tabs { top: 0; }
    .block { scroll-margin-top: 64px; }
  }
  .bar {
    position: fixed; inset: auto 0 0; z-index: 40; display: flex; align-items: center; gap: 10px;
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
    background: rgb(255 255 255 / .94); -webkit-backdrop-filter: saturate(180%) blur(14px); backdrop-filter: saturate(180%) blur(14px);
    border-top: 1px solid var(--border); box-shadow: var(--sh-up);
  }
  .bar p { margin-right: auto; display: grid; }
  .bar b { font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: var(--ls-title); color: var(--ink); }
  .bar__wa { display: grid; place-items: center; width: 52px; height: 52px; border: 1px solid var(--border-dark); border-radius: var(--radius-sm); font-size: 22px; color: var(--ink); }
  .bar .btn { --btn-h: 52px; }
  .bar { transition: translate var(--dur-3) var(--ease-out); }
  .bar.is-off { translate: 0 110%; }
  @media (min-width: 1200px) { .bar { display: none; } }
  @media (prefers-reduced-motion: no-preference) { .bar { --rise: 100%; animation: rise var(--dur-4) var(--ease-out) 500ms backwards; } }

  /* Enquiry sheet */
  .enq .sheet__head h2 { font-size: var(--fs-card); line-height: var(--lh-card); letter-spacing: var(--ls-card); }
  .enq h3 { font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: var(--ls-title); }
  @media (min-width: 768px) { .enq { width: min(560px, 100%); } }
  .enq__tour { display: flex; align-items: center; gap: 14px; padding: 12px; margin-bottom: 20px; border-radius: var(--r-md); background: var(--surface); font-size: var(--fs-small); line-height: var(--lh-small); color: var(--text-2); }
  .enq__tour img { width: 96px; height: 72px; border-radius: var(--r-sm); object-fit: cover; }
  .enq__tour h3 { margin-bottom: 2px; }
  .enq__tour b { color: var(--ink); }
  .enq :global(.enq__form) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 12px; }
  .enq :global(.enq__form) .full { grid-column: 1 / -1; }
</style>
