---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="section">
    <div class="container sh sh--center">
      <h1>Lost in the mountains?</h1>
      <p>The page you're looking for doesn't exist or has moved.</p>
      <div class="center"><a class="btn btn--primary" href="/">Back to home</a>&nbsp;<a class="btn btn--outline" href="/tours/">See tour packages</a></div>
    </div>
  </section>
</Base>
<style>h1 { font-size: var(--fs-h1); line-height: var(--lh-h1); }</style>
