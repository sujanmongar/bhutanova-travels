---
import Page from '../layouts/Page.astro';
import EnquireButton from '../components/EnquireButton.astro';
---
<Page title="Page not found" heading="Lost in the mountains?" lede="The page you're looking for doesn't exist or has moved." noindex>
  <form class="nf-search" action="/search/" method="get" role="search">
    <label class="sr-only" for="nf-q">Search tours, guides and articles</label>
    <input class="input" id="nf-q" type="search" name="q" placeholder="Search tours, guides, articles…" enterkeyhint="search" />
  </form>
  <div class="nf-actions"><a class="btn btn--primary" href="/bhutan-tours/">Tour packages</a><EnquireButton variant="outline" label="Ask us" /></div>
</Page>
<style>
  .nf-search { max-width: 56ch; }
  .nf-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-6); }
</style>
