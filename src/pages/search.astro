---
// A real results page for the header's search field — pressing Enter (or a phone's "search"/"go" key)
// lands here instead of stopping at the short suggestion list. Rendered client-side against the same
// build-time index the header already embeds (astro:content isn't available in the browser, so the
// filtering has to happen there, not here) — this page is just the shell plus the script that fills it.
import Base from '../layouts/Base.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { TOURS } from '../utils';

// Shown before a search and when nothing matches, so the page never ends in a blank.
const start = [
  [TOURS, 'Tour packages', 'Prices and day-by-day plans for every private tour'],
  ['/travel-guide/', 'Travel guide', 'Visas, the SDF, money, weather and packing'],
  ['/contact/', 'Ask us', 'Tell us what you are looking for. We reply within 24 hours.'],
];
---
<Base title="Search" noindex>
  <section class="section">
    <div class="container narrow">
      <Breadcrumbs items={[['Search']]} />
      <h1>Search</h1>
      <form role="search" action="/search/" method="get" data-form>
        <label class="sr-only" for="page-search-q">Search tours, guides and articles</label>
        <input id="page-search-q" class="input page-search__q" type="search" name="q" placeholder="Search tours, guides, articles…" autocomplete="off" enterkeyhint="search" />
      </form>
      <p class="page-search__status t-caption" data-status aria-live="polite"></p>
      <ul class="page-search__results" data-results></ul>
      <div class="results__group page-search__start" data-start>
        <h2>Where to start</h2>
        <ul>
          {start.map(([href, title, text]) => <li><a href={href}><span class="page-search__t">{title}</span><span class="t-caption muted">{text}</span></a></li>)}
        </ul>
      </div>
    </div>
  </section>
  <WhatsAppCta />
</Base>

<script>
  import { matches, groupByKind, resultsHTML } from '../scripts/search';

  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const input = document.getElementById('page-search-q') as HTMLInputElement;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const list = document.querySelector<HTMLUListElement>('[data-results]')!;
  const start = document.querySelector<HTMLElement>('[data-start]')!;
  const index: { t: string; k: string; u: string }[] = JSON.parse(document.getElementById('search-index')!.textContent!);

  const run = (q: string, focus = false) => {
    const term = q.trim();
    const found = matches(index, q);
    list.innerHTML = resultsHTML(groupByKind(found));
    start.hidden = found.length > 0;
    status.textContent = !term ? 'Search tours, destinations, travel guides and blog articles.'
      : found.length ? `${found.length} result${found.length === 1 ? '' : 's'} for “${term}”`
      : `No results for “${term}”. Try a different word, or start from one of these.`;
    document.title = term ? `“${term}” — Search — Bhutanova Travels` : 'Search — Bhutanova Travels';
    if (focus) input.focus();
  };

  const q = new URL(location.href).searchParams.get('q') ?? '';
  input.value = q;
  run(q, !q);

  let debounce: ReturnType<typeof setTimeout>;
  const update = () => {
    const next = input.value.trim();
    history.replaceState(null, '', next ? `?q=${encodeURIComponent(next)}` : location.pathname);
    run(input.value);
  };
  input.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(update, 150);
  });
  // Enter / the phone's Search key: results are already live, so just search now and drop the keyboard.
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    clearTimeout(debounce);
    update();
    input.blur();
  });
</script>

<style>
  .narrow { max-width: 760px; }
  h1 { margin-bottom: var(--stack); }
  .page-search__q { margin-bottom: var(--space-1); }
  .page-search__status { margin: var(--space-4) 0 var(--space-1); color: var(--text-2); }
  .page-search__results { list-style: none; margin: var(--space-6) 0 0; padding: 0; display: grid; gap: var(--space-8); }
  .page-search__results:empty { display: none; }
  .page-search__start { margin-top: var(--space-6); }
  /* :global — built with innerHTML at runtime; see the header's own search styles for why this needs it.
     Group names are labels (like the header's suggestion list); the result titles below them are the content. */
  :global(.results__group h2) {
    display: flex; align-items: center; gap: var(--space-2); margin-bottom: var(--space-2);
    font-family: var(--ff); font-size: var(--fs-label); line-height: var(--lh-label); letter-spacing: var(--ls-label); font-weight: var(--fw-label); color: var(--ink);
  }
  :global(.results__group .num) {
    display: inline-grid; place-items: center; min-width: 24px; height: 24px; padding: 0 var(--space-2); border-radius: var(--r-full);
    background: var(--surface); font-family: var(--ff); font-size: var(--fs-label); line-height: var(--lh-label); letter-spacing: var(--ls-label); font-weight: var(--fw-label); color: var(--text-3);
  }
  :global(.results__group ul) { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  :global(.results__group a) {
    display: flex; align-items: center; min-height: 56px; padding: var(--space-3) var(--space-1); border-bottom: 1px solid var(--border);
    font-family: var(--ff-display); font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: var(--ls-title); font-weight: 400; font-variant-numeric: lining-nums; color: var(--ink);
  }
  /* After the shared row rule so it wins at any scoping specificity: title over a one-line description */
  .page-search__start a { flex-direction: column; align-items: flex-start; justify-content: center; gap: var(--space-1); }
  @media (hover: hover) {
    .page-search__results :global(a:hover), .page-search__start a:hover .page-search__t { text-decoration: underline 1.5px var(--p-500); text-underline-offset: 6px; }
  }
</style>
