---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import TripPlanner from '../components/TripPlanner.astro';
import BannerImg from '../components/BannerImg.astro';
import { SITE, tel, wa } from '../config';
const hero = 'photo-1662547150045-7a8d3a9ad0b2';
// Most actionable first: on phones this list sits above the form. Each value is [text, href?].
const info: Array<[string, string, Array<[string, string?]>]> = [
  ['social_whatsapp', 'WhatsApp', [[SITE.phone, wa(`${new URL(Astro.url.pathname, Astro.site).href}#contact`)]]],
  ['phone', 'Call us', [[SITE.phone, tel(SITE.phone)], [SITE.phoneAlt, tel(SITE.phoneAlt)]]],
  ['envelope', 'Email us', [[SITE.email, `mailto:${SITE.email}`]]],
  ['clock', 'Office hours', [['Mon–Sat, 9am–6pm (BTT, GMT+6)']]],
  ['location-dot', 'Visit us', [[SITE.address, 'https://maps.google.com/?q=Babesa,Thimphu,Bhutan']]],
];
---
<Base title="Contact us and plan a trip" description="Contact Bhutanova Travels to plan a Bhutan trip: WhatsApp, email, phone or the enquiry form. A planner in Thimphu replies within 24 hours." image={hero}>
  <section class="banner">
    <BannerImg src={hero} alt="Paro valley" />
    <div><Breadcrumbs items={[['Contact']]} light /><h1>Contact us to plan a trip</h1><p class="banner__line">WhatsApp, email, phone or the form below: they all reach the same planner in Thimphu, and we reply within 24 hours.</p></div>
  </section>

  <section class="section">
    <div class="container contact" id="contact">
      <div>
        <div class="sh" data-reveal><h2>Let's plan your journey</h2><p>Tell us when you'd like to travel and what excites you. A local trip expert will reply with ideas and a clear quote.</p></div>
        <ul class="info" data-reveal="stagger">
          {info.map(([i, t, v]) => (
            <li>
              <Icon name={i} />
              <div><h3 class="t-card">{t}</h3><div class="info__v">{v.map(([text, href]) => href
                ? <a class="t-body" href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener">{text}{href.startsWith('http') && <span class="sr-only"> (opens in a new tab)</span>}</a>
                : <p class="t-body">{text}</p>)}</div></div>
            </li>
          ))}
        </ul>
      </div>
      <div class="form">
        <h2>Send us a message</h2>
        <TripPlanner inline />
        <p class="note t-caption subtle">By sending a message you agree to our <a href="/privacy/">privacy policy</a>.</p>
      </div>
    </div>
  </section>

  <section class="section section--grey">
    <div class="container">
      <div class="frame">
        <iframe class="map" title="Map of Babesa, Thimphu" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          data-src="https://www.google.com/maps?q=Babesa,Thimphu,Bhutan&z=14&output=embed"></iframe>
        <div class="frame__gate"><p>This map is from Google Maps, which may set cookies when it loads.</p><button type="button" class="btn btn--outline" data-consent-load>Show the map</button></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sh" data-reveal>
        <h2>Questions before you write?</h2>
        <p>Visas, the nightly fee, altitude, what a trip costs — all answered in our travel FAQs, or just ask us directly above.</p>
      </div>
      <a class="link-more" href="/travel-guide/travel-faqs/" data-reveal><span>Read the Bhutan travel FAQs</span><Icon name="arrow-up-right" /></a>
    </div>
  </section>
</Base>
<style>
  .contact { display: grid; gap: var(--space-10); }
  @media (min-width: 1200px) { .contact { grid-template-columns: 1fr 1fr; gap: var(--space-16); align-items: start; } }
  .info { list-style: none; margin: 0; padding: 0; display: grid; gap: 0 var(--space-8); }
  @media (min-width: 768px) and (max-width: 1199px) { .info { grid-template-columns: 1fr 1fr; } }
  .info li { display: flex; gap: var(--space-3); padding: var(--space-4) 0; border-top: 1px solid var(--border-dark); }
  .info li > :global(.icon) { font-size: 16px; margin-top: var(--space-1); color: var(--p-600); }
  .info h3 { margin: 0 0 var(--space-3); }
  /* Two values (the phone numbers) wrap when they don't fit; the row gap keeps each link's tap area clear of the next */
  .info__v { display: flex; flex-wrap: wrap; gap: var(--space-6); }
  .info a, .info p { color: var(--text-2); word-break: break-word; }
  .info a { display: inline-block; padding-block: var(--space-3); margin-block: calc(var(--space-3) * -1); }  /* ~50px tap area, same as .crumbs a */
  .info a { text-decoration: underline 1px var(--border-dark); text-underline-offset: 4px; transition: color var(--dur-1), text-decoration-color var(--dur-1); }
  @media (hover: hover) { .info a:hover { color: var(--ink); text-decoration-color: var(--p-500); } }
  .contact :global(.form) { display: grid; gap: var(--space-6); padding: var(--card-pad); border: 1px solid var(--border-dark); border-radius: var(--radius); corner-shape: squircle; background: #fff; }
  @media (min-width: 768px) { .contact :global(.form) { padding: var(--space-8); } }
  .map { display: block; width: 100%; height: 320px; border: 0; border-radius: var(--radius); corner-shape: squircle; background: var(--s-50); }
  @media (min-width: 768px) { .map { height: 420px; } }
  .frame__gate { border-radius: var(--radius); corner-shape: squircle; }
</style>
