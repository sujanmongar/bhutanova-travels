---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import Form from '../components/Form.astro';
import { SITE, img, srcset, wa } from '../config';
const hero = 'photo-1662547150045-7a8d3a9ad0b2';
const tel = (p: string) => `tel:${p.replace(/\s/g, '')}`;
const info = [
  ['location-dot', 'Visit us', SITE.address, 'https://maps.google.com/?q=Babesa,Thimphu,Bhutan'],
  ['social_whatsapp', 'WhatsApp', SITE.phone, wa(`${new URL(Astro.url.pathname, Astro.site).href}#contact`)],
  ['phone', 'Call us', `${SITE.phone} / ${SITE.phoneAlt}`, tel(SITE.phone)],
  ['envelope', 'Email us', SITE.email, `mailto:${SITE.email}`],
  ['headphones', 'Office hours', 'Mon–Sat, 9am–6pm (BTT, GMT+6)', ''],
];
---
<Base title="Contact Us & Plan a Trip" description="Contact Bhutanova Travels to plan a Bhutan trip: WhatsApp, email, phone or the enquiry form. A planner in Thimphu replies within 24 hours." image={hero}>
  <section class="banner">
    <img src={img(hero, 1600)} srcset={srcset(hero)} sizes="100vw" alt="Paro valley" width="1600" height="700" fetchpriority="high" />
    <div><Breadcrumbs items={[['Contact']]} light /><h1>Contact us to plan a trip</h1><p class="banner__line">“Plan a trip” anywhere on this site brings you here. WhatsApp, email, phone or the form — they all reach the same planner in Thimphu, and we reply within 24 hours.</p></div>
  </section>

  <section class="section">
    <div class="container contact" id="contact">
      <div>
        <div class="sh" data-reveal><h2>Let's plan your journey</h2><p>Tell us when you'd like to travel and what excites you. A local trip expert will reply with ideas and a clear quote.</p></div>
        <ul class="info" data-reveal="stagger">
          {info.map(([i, t, v, href]) => (
            <li>
              <Icon name={i} />
              <div><h3>{t}</h3>{href ? <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel="noopener">{v}</a> : <p>{v}</p>}</div>
            </li>
          ))}
        </ul>
      </div>
      <Form subject="Website enquiry" class="form">
        <h2 class="t-card">Send us a message</h2>
        <div class="field"><label for="c-name">Full name *</label><input class="input" id="c-name" name="name" autocomplete="name" required /></div>
        <div class="row">
          <div class="field"><label for="c-email">Email *</label><input class="input" id="c-email" name="email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="c-phone">Phone</label><input class="input" id="c-phone" name="phone" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="row">
          <div class="field"><label for="c-date">Preferred travel month</label><input class="input" id="c-date" name="month" type="month" /></div>
          <div class="field"><label for="c-count">Travelers</label><input class="input" id="c-count" name="travelers" type="number" min="1" value="2" /></div>
        </div>
        <div class="field"><label for="c-msg">Message *</label><textarea class="input" id="c-msg" name="message" required></textarea></div>
        <button class="btn btn--primary btn--block">Send Message</button>
        <p class="note t-meta">By sending this form you agree to our <a href="/privacy/">privacy policy</a>.</p>
      </Form>
    </div>
  </section>

  <section class="section section--flush">
    <div class="container">
      <iframe class="map" title="Map of Babesa, Thimphu" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
        src="https://www.google.com/maps?q=Babesa,Thimphu,Bhutan&z=14&output=embed"></iframe>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="sh" data-reveal>
        <h2>Questions before you write?</h2>
        <p>Visas, the nightly fee, altitude, what a trip costs — thirty answers in our travel FAQs, or just ask us directly above.</p>
      </div>
      <a class="link-more" href="/travel-guide/travel-faqs/" data-reveal>Read the Bhutan travel FAQs<Icon name="arrow-right" /></a>
    </div>
  </section>
</Base>
<style>
  .contact { display: grid; gap: 40px; }
  @media (min-width: 1200px) { .contact { grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; } }
  .info { list-style: none; margin: 0; padding: 0; display: grid; gap: 0 32px; }
  @media (min-width: 768px) and (max-width: 1199px) { .info { grid-template-columns: 1fr 1fr; } }
  .info li { display: flex; gap: 14px; padding: 20px 0; border-top: 1px solid var(--border-dark); }
  .info li > :global(.icon) { font-size: 16px; margin-top: 4px; color: var(--p-600); }
  .info h3 { margin: 0 0 4px; font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: var(--ls-title); }
  .info a, .info p { font-size: var(--fs-small); line-height: var(--lh-small); color: var(--text-2); word-break: break-word; }
  .info a:hover { color: var(--p-700); }
  .contact :global(.form) { display: grid; gap: 16px; padding: 24px 20px; border: 1px solid var(--border-dark); border-radius: var(--radius); background: #fff; }
  .row { display: grid; gap: 16px; }
  @media (min-width: 768px) { .contact :global(.form) { padding: 32px; } .row { grid-template-columns: 1fr 1fr; } }
  .note a { text-decoration: underline; }
  .map { width: 100%; height: 320px; border: 0; border-radius: var(--r-xl); background: var(--s-50); }
  @media (min-width: 768px) { .map { height: 420px; } }
</style>
