---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import BlogCard from '../../components/BlogCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BannerImg from '../../components/BannerImg.astro';
import TabBar from '../../components/TabBar.astro';
import { slug } from '../../utils';
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
const hero = 'photo-1585904194096-15ef66ccd234';
---
<Base title="Blog – stories from Bhutan" description="Travel stories, festival guides, food and hidden gems from our team in Bhutan." image={hero}>
  <section class="banner">
    <BannerImg src={hero} alt="Masked dancers at a Bhutanese tshechu" />
    <div><Breadcrumbs items={[['Blog']]} light /><h1>Stories from Bhutan</h1><p class="banner__line">Stories, festival notes and practical advice from our team in Thimphu.</p></div>
  </section>
  <TabBar label="Filter posts by topic" filter>
    <button class="t-label" type="button" aria-pressed="true" data-topic="">All stories</button>
    {tags.map((t) => <button class="t-label" type="button" aria-pressed="false" data-topic={slug(t)}>{t}</button>)}
  </TabBar>
  <section class="section">
    <div class="container">
      <h2 class="sr-only">All stories</h2>
      <p class="sr-only" aria-live="polite" data-status></p>
      <ul class="grid-3 posts" data-reveal="stagger">
        {posts.map((p) => <li data-tags={p.data.tags.map(slug).join(' ')}><BlogCard post={p} /></li>)}
      </ul>
    </div>
  </section>
  <WhatsAppCta />
</Base>
<script>
  // Filter in place; the chosen topic lives in ?topic= so a filtered view can be shared.
  const bar = document.querySelector<HTMLElement>('[data-filter]')!;
  const buttons = [...bar.querySelectorAll<HTMLButtonElement>('button')];
  const items = [...document.querySelectorAll<HTMLElement>('.posts > li')];
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const apply = (topic: string, announce = true) => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.topic === topic)));
    let shown = 0;
    items.forEach((li) => {
      const on = !topic || li.dataset.tags!.split(' ').includes(topic);
      li.hidden = !on;
      if (on) { shown++; if (!still) li.animate?.([{ opacity: 0 }, { opacity: 1 }], { duration: 240, easing: 'ease-out' }); }
    });
    const url = new URL(location.href);
    topic ? url.searchParams.set('topic', topic) : url.searchParams.delete('topic');
    history.replaceState(null, '', url);
    if (announce) status.textContent = `${shown} ${shown === 1 ? 'post' : 'posts'} shown`;
  };
  // Changing topic while the tabs are stuck to the top: bring the start of the list back up under them
  const list = document.querySelector<HTMLElement>('.posts')!;
  buttons.forEach((b) => b.addEventListener('click', () => {
    apply(b.dataset.topic!);
    const gap = list.getBoundingClientRect().top - bar.getBoundingClientRect().bottom;
    if (gap < 0) scrollBy({ top: gap - 40, behavior: still ? 'auto' : 'smooth' });
  }));
  const initial = new URL(location.href).searchParams.get('topic');
  if (initial && buttons.some((b) => b.dataset.topic === initial)) apply(initial, false);
</script>
<style>
  /* The filter needs JS; without it every post simply shows */
  @media (scripting: none) { :global(.tabbar) { display: none; } }
  .posts { row-gap: var(--space-10); }
  .posts > li[hidden] { display: none; }
</style>
