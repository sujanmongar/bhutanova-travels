---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import Icon from '../../components/Icon.astro';
import { img, srcset } from '../../config';
import { slug } from '../../utils';
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(guides.map((g) => g.data.group))];
const hero = 'photo-1532918235359-7671f525386d';
---
<Base title="Bhutan Travel Guide – Visa, SDF, Weather & Packing" description="Everything you need before visiting Bhutan: how to book, visa and immigration rules, the Sustainable Development Fee, money, weather, packing, mountains and etiquette." image={hero}>
  <section class="banner">
    <img src={img(hero, 1600)} srcset={srcset(hero)} sizes="100vw" alt="Prayer flags on a mountain pass" width="1600" height="700" fetchpriority="high" />
    <div><Breadcrumbs items={[['Travel guide']]} light /><h1>Bhutan travel guide</h1></div>
  </section>

  <nav class="jump" aria-label="Guide topics">
    <div class="container jump__in">{groups.map((g) => <a href={`#${slug(g)}`}>{g}</a>)}</div>
  </nav>

  {groups.map((g) => (
    <section class="section" id={slug(g)}>
      <div class="container">
        <div class="sh" data-reveal><h2>{g}</h2></div>
        <div class="grid-3 guides" data-reveal="stagger">{guides.filter((x) => x.data.group === g).map((x) => <BlogCard post={x} base="/travel-guide/" />)}</div>
      </div>
    </section>
  ))}

  <section class="section section--grey">
    <div class="container">
      <div class="sh" data-reveal>
        <h2>Still have a question?</h2>
        <p>Thirty of the questions guests ask us most, answered in one place — visas, money, altitude, food, wifi and the rest.</p>
      </div>
      <a class="link-more" href="/travel-guide/travel-faqs/" data-reveal>Read the Bhutan travel FAQs<Icon name="arrow-right" /></a>
    </div>
  </section>
</Base>
<style>
  .jump { position: sticky; top: var(--header-h); z-index: 20; background: rgb(255 255 255 / .96); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); }
  .jump__in { display: flex; gap: 28px; overflow-x: auto; scrollbar-width: none; }
  .jump a { flex: none; display: inline-flex; align-items: center; min-height: 52px; font-size: var(--fs-small); line-height: var(--lh-small); font-weight: 500; color: var(--text-2); transition: color var(--dur-1); }
  .jump a:hover { color: var(--ink); text-decoration: underline 1.5px var(--p-500); text-underline-offset: 6px; }
  .guides { row-gap: 40px; }
  section[id] { scroll-margin-top: calc(var(--header-h) + 64px); }
</style>
