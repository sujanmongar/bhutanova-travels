---
import { pageBanner } from '../../config';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Banner from '../../components/Banner.astro';
import BlogCard from '../../components/BlogCard.astro';
import LinkMore from '../../components/LinkMore.astro';
import Section from '../../components/Section.astro';
import TabBar from '../../components/TabBar.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import MatchedTours from '../../components/MatchedTours.astro';
import { slug, topicName } from '../../utils';
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(guides.map((g) => g.data.group))];
const { seo, ...b } = pageBanner('guides', { heading: 'Bhutan travel guide', line: 'Visas, costs, seasons and what to expect: everything to plan a trip to Bhutan.', image: 'photo-1532918235359-7671f525386d', alt: 'Prayer flags on a mountain pass' });
// The FAQ guide's questions are its h3s, so the count below always matches the page.
const faqs = guides.find((g) => g.id === 'travel-faqs');
const asked = faqs ? (await render(faqs)).headings.filter((h) => h.depth === 3).length : 0;
---
<Base title="Bhutan travel guide – visa, SDF, weather & packing" description="Everything you need before visiting Bhutan: how to book, visa and immigration rules, the Sustainable Development Fee, money, weather, packing, mountains and etiquette." image={b.image} seo={seo}>
  <Banner {...b} crumbs={[['Travel guide']]} />

  <TabBar label="Guide topics" links={groups.map((g) => [topicName(g), `#${slug(g)}`])} />

  {groups.map((g, i) => (
    <Section heading={topicName(g)} grey={i % 2 === 1} id={slug(g)} link={g === 'Money & Costs' ? { href: '/bhutan-tours/', label: 'See tour prices' } : undefined}>
      <div class="grid-3 guides" data-reveal="stagger">{guides.filter((x) => x.data.group === g).map((x) => <BlogCard post={x} base="/travel-guide/" list />)}</div>
    </Section>
  ))}

  {faqs && (
    <Section heading="Still have a question?" text={`${asked > 0 ? `The ${asked} questions` : 'The questions'} guests ask us most are answered in one place: visas, money, altitude, food, wifi and the rest.`}>
      <LinkMore href={`/travel-guide/${faqs.id}/`} label="Read the Bhutan travel FAQs" data-reveal="" />
    </Section>
  )}
  <MatchedTours heading="Where to start" />
  <WhatsAppCta title="Ask us" text="If your question isn't answered here, message us on WhatsApp. We reply within 24 hours." about="travelling in Bhutan" />
</Base>
<style>
  /* Phones: every guide in the topic as a list row (the cards' list mode: thumbnail, title, two lines), between hairlines,
     so all of them can be scanned at once */
  @media (max-width: 767px) { .guides { row-gap: 0; border-top: 1px solid var(--border-dark); } }
</style>

