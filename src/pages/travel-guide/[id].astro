---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Icon from '../../components/Icon.astro';
import Section from '../../components/Section.astro';
import BlogCard from '../../components/BlogCard.astro';
import PlanCta from '../../components/PlanCta.astro';
import { withAsk } from '../../utils';
import WhatsAppCta from '../../components/WhatsAppCta.astro';
import MatchedTours from '../../components/MatchedTours.astro';
import Share from '../../components/Share.astro';
export async function getStaticPaths() {
  const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
  return guides.map((guide) => ({ params: { id: guide.id }, props: { guide, guides } }));
}
const { guide, guides } = Astro.props;
const { headings } = await render(guide);
const toc = headings.filter((h) => h.depth === 2);
// Three more guides to read next: the rest of this section first, then the start of the list.
const rest = guides.filter((g) => g.id !== guide.id);
// Tours for the guide's subject (links in its text come first), and a sidebar offer that fits why people read it
const THEMES: Record<string, string[]> = {
  'festival-calendar': ['festival-tours'], 'best-time-to-visit': ['festival-tours', 'cultural-tours'],
  'mountains-and-trekking': ['trekking-tours'], 'what-to-pack': ['trekking-tours'], 'weather-by-region': ['trekking-tours'],
  'hotels-in-bhutan': ['luxury-tours'], 'homestays-and-farmhouses': ['cultural-tours'], 'cultural-etiquette': ['cultural-tours'],
  'responsible-travel': ['exclusive-tours'], 'travel-budget': ['cultural-tours'], 'sustainable-development-fee': ['cultural-tours'],
};
const OFFER: Record<string, { title: string; text: string }> = {
  'Money & Costs': { title: 'Get a price for your dates', text: 'Free day-by-day plan and one all-inclusive price within 24 hours. The SDF, visa, hotels, guide and vehicle are all in it.' },
  'Entry & Visa': { title: 'We handle the paperwork', text: 'Book with us and we arrange your visa, SDF and flights. Free plan and price within 24 hours.' },
};
const offer = OFFER[guide.data.group] ?? { title: 'Plan your Bhutan trip', text: 'Tell us your dates and interests. Free day-by-day plan and price within 24 hours.' };
const related = [...rest.filter((g) => g.data.group === guide.data.group), ...rest.filter((g) => g.data.group !== guide.data.group)].slice(0, 3);
---
<Article title={guide.data.title} description={guide.data.excerpt} image={guide.data.image} alt={guide.data.alt} date={guide.data.updated} back={['/travel-guide/', 'Travel guide']} updatedLabel="Last reviewed" seo={guide.data.seo}>
  {toc.length > 1 && (
    <details class="toc toc-m">
      <summary class="t-label">On this page<Icon name="chevron-up" /></summary>
      <ol>{toc.map((h) => <li><a class="t-label" href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
    </details>
  )}
  <Fragment set:html={withAsk(guide.rendered?.html)} />
  <Fragment slot="aside">
    <div class="widget-sticky">
      {toc.length > 1 && (
        <nav class="widget toc" aria-labelledby="toc-h">
          <p class="widget__h" id="toc-h">On this page</p>
          <ol>{toc.map((h) => <li><a class="t-label" href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <PlanCta {...offer} topic={guide.data.title} />
      <Share title={guide.data.title} />
    </div>
  </Fragment>
  <MatchedTours slot="after" html={guide.rendered?.html} themes={THEMES[guide.id] ?? []} />
  <Section slot="after" heading="More travel guides" link={{ href: '/travel-guide/', label: 'All guides' }} rail="guides" railLabel="guides">
    {related.map((g) => <BlogCard post={g} base="/travel-guide/" rail />)}
  </Section>
  <WhatsAppCta slot="after" about={guide.data.title} />
</Article>
<script>
  // Highlight the section being read in both copies of the TOC, and keep it in view when the sidebar list scrolls
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const idOf = (a: HTMLAnchorElement) => decodeURIComponent(a.hash.slice(1));
  const spy = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    links.forEach((a) => {
      if (idOf(a) !== e.target.id) return a.removeAttribute('aria-current');
      a.setAttribute('aria-current', 'location');
      const box = a.closest<HTMLElement>('.toc')!, r = a.getBoundingClientRect(), b = box.getBoundingClientRect();
      if (r.top < b.top || r.bottom > b.bottom) box.scrollTop += r.top - b.top - b.height / 2;
    });
  }), { rootMargin: '-20% 0px -70% 0px' });
  new Set(links.map(idOf)).forEach((id) => { const h = document.getElementById(id); if (h) spy.observe(h); });
</script>
<style>
  .toc ol { list-style: none; margin: 0; padding: 0; }
  .toc li + li { margin-top: 0; }
  .toc a { display: block; padding: var(--space-2) 0 var(--space-2) var(--space-3); }  /* colour, bar and hover: global.css */
  .toc a[aria-current] { --link-rest: var(--ink); --toc-bar: var(--p-500); }
  /* Below 1024px the contents fold up at the top of the article instead of sitting in the sidebar */
  .toc-m { border-block: 1px solid var(--border); }
  .toc-m summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 44px; padding-block: var(--space-2);
    color: var(--ink); cursor: pointer; list-style: none; -webkit-tap-highlight-color: transparent;
  }
  .toc-m summary::-webkit-details-marker { display: none; }
  .toc-m summary :global(.icon) { font-size: var(--icon-xs); color: var(--s-500); rotate: 180deg; transition: rotate var(--dur-2) var(--ease-out); }
  .toc-m[open] summary :global(.icon) { rotate: 0deg; }
  .toc-m ol { padding-bottom: var(--space-4); }
  /* Below 1024px the sidebar falls under the text: only the share icons stay, the closing contact card asks the question */
  @media (max-width: 1023px) { .toc:not(.toc-m), .widget-sticky :global(.plan) { display: none; } }
  @media (min-width: 1024px) {
    .toc-m { display: none; }
    /* The sticky sidebar is never taller than the screen: the contents list gives way and scrolls, the enquiry box stays whole */
    .widget-sticky { display: flex; flex-direction: column; max-height: calc(100dvh - var(--header-h) - var(--space-12)); }
    .widget-sticky .toc { min-height: min(35vh, var(--space-32) * 2); overflow-y: auto; overscroll-behavior: contain; }
    .widget-sticky > * { flex: none; }
    .widget-sticky .toc { flex: 0 1 auto; }
    /* Short laptop screens: the plan card keeps its buttons, the share icons wait below the text column */
    @media (max-height: 900px) { .widget-sticky :global(.plan :is(.talk-text, .plan__hours)), .widget-sticky :global(.share) { display: none; } }
    .toc .widget__h { position: sticky; top: 0; background: var(--white); }
    .toc a:focus-visible { outline-offset: -2px; }
  }
</style>
