---
import Base from '../layouts/Base.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config';
---
<Base title="Privacy policy" description="How Bhutanova Travels collects and uses your personal information.">
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[['Privacy policy']]} />
      <div class="prose">
      <h1>Privacy policy</h1>
      <p>We collect only the details you send us through our forms or by email — such as your name, contact details, travel dates and passport information needed for your visa — and use them solely to plan and operate your trip.</p>
      <p>We share your details only with the parties needed to deliver your booking (for example the Department of Immigration, hotels and airlines). We never sell your data.</p>
      <p>To access or delete your data, email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
      <h2 id="cookies">Cookies</h2>
      <p>This website does not use advertising or tracking cookies. Some pages show maps and videos from Google Maps, YouTube and Vimeo, and those services may set their own cookies when they load. They load only after you choose Accept all (or switch on Maps and videos under Customise), or press Show on a single map or video. Reject all keeps them off.</p>
      <p>Your choice is kept in one small cookie on your device (bn_consent) for a year. You can change it at any time with Cookie preferences at the bottom of every page.</p>
      </div>
    </div>
  </section>
  <WhatsAppCta />
</Base>
<style>
  .container > :global(.crumbs) { margin-bottom: var(--space-4); }
</style>
