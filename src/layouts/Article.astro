---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { img, srcset } from '../config';
interface Props { title: string; description: string; image: string; date: Date; kicker: string; back: [string, string]; author?: string; updatedLabel?: string }
const { title, description, image, date, kicker, back, author = 'Bhutanova Travels', updatedLabel = 'Published' } = Astro.props;
const hasAside = Astro.slots.has('aside');
const url = new URL(Astro.url.pathname, Astro.site).href;
const schema = {
  '@context': 'https://schema.org', '@type': 'Article', headline: title, description, image: img(image, 1200), url,
  datePublished: date.toISOString(), dateModified: date.toISOString(),
  author: { '@type': 'Organization', name: author }, publisher: { '@id': new URL('/#org', Astro.site).href },
  mainEntityOfPage: url,
};
const fmt = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={title} description={description} image={image} type="article" published={date} schema={schema}>
  <div class="progress" aria-hidden="true"></div>
  <div class:list={['container', 'post', { 'post--aside': hasAside }]}>
    <article class="post__main">
      <header class="ah">
        <Breadcrumbs items={[[back[1], back[0]], [title]]} />
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <p class="meta">{updatedLabel} <time datetime={date.toISOString()}>{fmt}</time> · <b>{author}</b></p>
      </header>
      <img class="cover" src={img(image, 1400)} srcset={srcset(image, [480, 800, 1200, 1600])}
        sizes={hasAside ? '(min-width:1200px) 712px, (min-width:1024px) calc(100vw - 428px), 100vw' : '(min-width:1200px) 1120px, 100vw'}
        alt="" width="1400" height="700" fetchpriority="high" style="view-transition-name: hero-img" />
      <div class="prose body"><slot /></div>
    </article>
    {hasAside && <aside class="post__aside" aria-label="Related"><slot name="aside" /></aside>}
  </div>
  <slot name="after" />
</Base>
<style>
  .post { padding-block: 32px var(--section); }
  .ah, .body { max-width: 760px; margin-inline: auto; }
  .ah :global(.crumbs) { margin-bottom: 16px; }
  .lede { margin-top: 14px; max-width: 60ch; font-size: var(--fs-lead); line-height: var(--lh-lead); color: var(--text-2); }
  .meta { margin: 16px 0 28px; font-size: var(--fs-meta); line-height: var(--lh-meta); letter-spacing: var(--ls-meta); font-weight: 500; color: var(--text-3); }
  .meta b { font-weight: 600; color: var(--text-2); }
  .cover { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; border-radius: var(--radius); background: var(--s-50); }
  .body { margin-top: 36px; font-size: var(--fs-prose); line-height: var(--lh-prose); color: var(--text); }
  .post__aside { display: grid; gap: 36px; align-content: start; margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--border); }
  @media (min-width: 768px) { .post { padding-top: 48px; } .cover { aspect-ratio: 2 / 1; border-radius: var(--r-xl); } }
  @media (min-width: 1024px) {
    .post--aside { display: grid; grid-template-columns: minmax(0, 1fr) 300px; column-gap: 48px; }
    .post--aside :is(.ah, .body) { margin-inline: 0; }
    .post--aside .cover { aspect-ratio: 16 / 9; }
    .post__aside { margin-top: 0; padding-top: 0; border-top: 0; }
  }
  @media (min-width: 1200px) { .post--aside { grid-template-columns: minmax(0, 1fr) 336px; column-gap: 72px; } }
  /* Reading progress, CSS scroll-linked (Chrome 115+, Safari 26+) */
  .progress { display: none; }
  @keyframes grow { from { scale: 0 1; } }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .progress { display: block; position: fixed; inset: 0 0 auto; z-index: 60; height: 3px; background: var(--p-500); transform-origin: 0 50%; animation-name: grow; animation-timing-function: linear; animation-fill-mode: both; animation-timeline: scroll(root); }
    }
  }
</style>
