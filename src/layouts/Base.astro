---
import '../styles/global.css';
import serifUrl from '../fonts/fraunces-latin-opsz-normal-400.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TripPlanner from '../components/TripPlanner.astro';
import CookieNotice from '../components/CookieNotice.astro';
import Lightbox, { type ViewerPhoto } from '../components/Lightbox.astro';
import { getCollection } from 'astro:content';
import { SITE, img, ldJson, type Seo } from '../config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  published?: Date;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  seo?: Seo;
  /** Tour pages: the photos for the viewer, with fit / fill. Other pages build it from their article photos. */
  photos?: ViewerPhoto[];
}
const { title, type = 'website', published, schema, seo = {}, photos } = Astro.props;
const description = seo.description || Astro.props.description || SITE.description;
// Default share image: the one set in Site settings, else a stock photo
const shareImage = SITE.ogImage || 'photo-1578556881786-851d4b79cb73';
const image = seo.image || Astro.props.image || shareImage;
const noindex = Astro.props.noindex || seo.noindex;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = seo.title || (Astro.url.pathname === '/' ? `${SITE.name} | ${SITE.tagline}` : `${title} | ${SITE.name}`);
const ogImage = img(image, 1200, 630);

// SITE.address as typed in Site settings ("4730 Babesa, Thimphu, Bhutan"): the last part is the town, the rest the street
const street = SITE.address.split(',').map((p) => p.trim()).filter((p) => p && !/^bhutan$/i.test(p));
const town = street.length > 1 ? street.pop() : undefined;
// Real profiles only: '#', empty or a bare network home page (https://facebook.com/) is a placeholder
const sameAs = Object.entries(SITE.social).filter(([k, u]) => k !== 'whatsapp' && /^https?:\/\/[^/]+\/./.test(u || '')).map(([, u]) => u);
const orgId = new URL('/#org', Astro.site).href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  '@id': orgId,
  name: SITE.name,
  url: Astro.site?.href,
  logo: new URL('/favicon.svg', Astro.site).href,
  image: img(shareImage, 1200, 630),  // one brand image, not each page's photo
  email: SITE.email,
  telephone: SITE.phone,
  address: { '@type': 'PostalAddress', streetAddress: street.join(', '), addressLocality: town, addressCountry: 'BT' },
  areaServed: { '@type': 'Country', name: 'Bhutan' },
  // Only while the hours shown still read Mon–Sat 9am–6pm, so an edit in Site settings can't leave Google wrong hours
  openingHoursSpecification: /^mon\S*\s*[–-]\s*sat\S*,?\s*9\s*am\s*[–-]\s*6\s*pm/i.test(SITE.hours)
    ? { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'], opens: '09:00', closes: '18:00' }
    : undefined,
  sameAs: sameAs.length ? sameAs : undefined,
};
// Home page: WebSite, so Google shows the brand (not the domain) as the site name
const site = Astro.url.pathname === '/' && { '@context': 'https://schema.org', '@type': 'WebSite', '@id': new URL('/#website', Astro.site).href, name: SITE.name, alternateName: 'Bhutanova', url: Astro.site?.href, publisher: { '@id': orgId } };
const ld = [org, ...(site ? [site] : []), ...(schema ? [schema].flat() : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {SITE.verify?.google && <meta name="google-site-verification" content={SITE.verify.google} />}
    {SITE.verify?.bing && <meta name="msvalidate.01" content={SITE.verify.bing} />}
    <meta name="theme-color" content="#162e44" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <!-- Prefetch same-site pages on hover so page transitions feel instant (Chromium; others ignore) -->
    <script type="speculationrules" set:html={JSON.stringify({ prefetch: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/*.xml' } }] }, eagerness: 'moderate' }] })} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={ldJson(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {/* First after the skip link, so while the card shows it's the first Tab stop, not one hidden behind it */}
    <CookieNotice />
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    {/* The one short enquiry form: every Enquire / Plan / Customise button on the site opens it */}
    <TripPlanner tours={await getCollection('tours')} />
    <Lightbox photos={photos} fill={!!photos?.length} label={photos?.length ? `${title} photos` : 'Photos'} />
    <script>
      const smooth: ScrollBehavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

      // A link to #section only lands correctly if the browser's one-time initial scroll happens after
      // everything above the target has finished loading; images shift things after
      // that, so a deep link (nav "Why us", a guide's table of contents) can land short. Once the page has
      // settled, nudge it back onto the target — instantly, so it doesn't visibly re-scroll.
      if (location.hash) {
        const jump = () => document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView({ behavior: 'instant' as ScrollBehavior, block: 'start' });
        // This script is a deferred module — by the time it runs, `load` has often already fired,
        // so a plain addEventListener would silently miss it.
        document.readyState === 'complete' ? jump() : addEventListener('load', jump, { once: true });
      }

      // Carousel arrows for any [data-rail] (native scroll-snap does the easing)
      document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
        const box = document.getElementById(rail.dataset.rail!);
        if (!box) return;
        const [prev, next] = rail.querySelectorAll<HTMLButtonElement>('button');
        const step = () => ((box.firstElementChild as HTMLElement)?.offsetWidth ?? 0) + (parseFloat(getComputedStyle(box).columnGap) || 0) || box.clientWidth;
        const sync = () => {
          // Everything already fits (e.g. three guides in a three-up row): no arrows at all
          rail.classList.toggle('is-idle', box.scrollWidth <= box.clientWidth + 4);
          prev.disabled = box.scrollLeft < 4;
          next.disabled = box.scrollLeft + box.clientWidth >= box.scrollWidth - 4;
          // A disabled button loses focus; hand it to the other arrow so keyboard users stay in the row
          const f = document.activeElement;
          if ((f === prev || f === next) && f.disabled) (f === next ? prev : next).focus();
        };
        prev.onclick = () => box.scrollBy({ left: -step(), behavior: smooth });
        next.onclick = () => box.scrollBy({ left: step(), behavior: smooth });
        box.addEventListener('scroll', sync, { passive: true });
        // Tabbing to a card half off-screen: bring it in (scroll-snap would otherwise snap back to the first card)
        box.addEventListener('focusin', (e) => {
          const card = [...box.children].find((c) => c.contains(e.target as Node));
          if (!card) return;
          const r = card.getBoundingClientRect(), b = box.getBoundingClientRect();
          // Next frame: the browser's own focus scroll runs after this event and would cancel a smooth scroll started now
          if (r.left < b.left - 1 || r.right > b.right + 1) requestAnimationFrame(() => card.scrollIntoView({ inline: 'start', block: 'nearest', behavior: smooth }));
        });
        addEventListener('resize', sync);
        sync();
      });

      // Scroll-in: [data-reveal] fades up once as it comes into view; in [data-reveal="stagger"] the children follow 60ms
      // apart (capped at 4). Checked on every scroll frame, so nothing is left hidden after a fast flick, a jump to the
      // end or an anchor link: whatever has been scrolled past is shown at once, without the animation (.is-past).
      const waiting = new Set(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      waiting.forEach((el) => {
        if (el.dataset.reveal === 'stagger') [...el.children].forEach((c, i) => (c as HTMLElement).style.setProperty('--i', String(Math.min(i, 4))));
      });
      let queued = false;
      const reveal = () => {
        queued = false;
        const line = innerHeight;  // anything showing at all fades in now, so a heading at the screen's foot is never a blank white strip
        waiting.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top > line) return;
          el.classList.add('is-in');
          if (r.bottom < 0) el.classList.add('is-past');
          waiting.delete(el);
        });
        if (!waiting.size) { removeEventListener('scroll', ask); removeEventListener('resize', ask); }
      };
      const ask = () => { if (!queued) { queued = true; requestAnimationFrame(reveal); } };
      addEventListener('scroll', ask, { passive: true });
      addEventListener('resize', ask);
      reveal();

      // Photos still loading fade in when they arrive (already-loaded ones just show)
      document.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((i) => {
        if (i.complete) return;
        i.addEventListener('load', () => i.classList.add('is-arriving'), { once: true });
      });

      // Lets iOS Safari show :active press states
      document.addEventListener('touchstart', () => {}, { passive: true });
    </script>
  </body>
</html>
