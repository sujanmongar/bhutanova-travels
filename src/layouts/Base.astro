---
import '../styles/global.css';
import fontUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import serifUrl from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, img, ldJson, type Seo } from '../config';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  published?: Date;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  seo?: Seo;
}
const { title, type = 'website', published, schema, seo = {} } = Astro.props;
const description = seo.description || Astro.props.description || SITE.description;
const image = seo.image || Astro.props.image || 'photo-1578556881786-851d4b79cb73';
const noindex = Astro.props.noindex || seo.noindex;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = seo.title || (Astro.url.pathname === '/' ? `${SITE.name} | ${SITE.tagline}` : `${title} | ${SITE.name}`);
const ogImage = img(image, 1200, 630);

const org = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  '@id': new URL('/#org', Astro.site).href,
  name: SITE.name,
  url: Astro.site?.href,
  logo: new URL('/favicon.svg', Astro.site).href,
  image: ogImage,
  email: SITE.email,
  telephone: SITE.phone,
  address: { '@type': 'PostalAddress', streetAddress: '4730 Babesa', addressLocality: 'Thimphu', addressCountry: 'BT' },
  areaServed: { '@type': 'Country', name: 'Bhutan' },
  // Real profiles only: a bare network home page (https://facebook.com/) is a placeholder
  sameAs: Object.entries(SITE.social).filter(([k, u]) => k !== 'whatsapp' && new URL(u).pathname.length > 1).map(([, u]) => u),
};
const ld = [org, ...(schema ? [schema].flat() : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#162e44" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <!-- Prefetch same-site pages on hover so page transitions feel instant (Chromium; others ignore) -->
    <script type="speculationrules" set:html={JSON.stringify({ prefetch: [{ where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/*.xml' } }] }, eagerness: 'moderate' }] })} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={ldJson(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script>
      const smooth: ScrollBehavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

      // A link to #section only lands correctly if the browser's one-time initial scroll happens after
      // everything above the target has finished loading; images and reveal animations shift things after
      // that, so a deep link (nav "Why us", a guide's table of contents) can land short. Once the page has
      // settled, nudge it back onto the target — instantly, so it doesn't visibly re-scroll.
      if (location.hash) {
        const jump = () => document.getElementById(decodeURIComponent(location.hash.slice(1)))?.scrollIntoView({ behavior: 'instant' as ScrollBehavior, block: 'start' });
        // This script is a deferred module — by the time it runs, `load` has often already fired,
        // so a plain addEventListener would silently miss it.
        document.readyState === 'complete' ? jump() : addEventListener('load', jump, { once: true });
      }

      // Carousel arrows for any [data-rail] (native scroll-snap does the easing)
      document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
        const box = document.getElementById(rail.dataset.rail!);
        if (!box) return;
        const [prev, next] = rail.querySelectorAll<HTMLButtonElement>('button');
        const step = () => ((box.firstElementChild as HTMLElement)?.offsetWidth ?? 0) + (parseFloat(getComputedStyle(box).columnGap) || 0) || box.clientWidth;
        const sync = () => {
          prev.disabled = box.scrollLeft < 4;
          next.disabled = box.scrollLeft + box.clientWidth >= box.scrollWidth - 4;
        };
        prev.onclick = () => box.scrollBy({ left: -step(), behavior: smooth });
        next.onclick = () => box.scrollBy({ left: step(), behavior: smooth });
        box.addEventListener('scroll', sync, { passive: true });
        addEventListener('resize', sync);
        sync();
      });

      // Scroll reveal: [data-reveal] rises once; [data-reveal="stagger"] staggers its children.
      // ponytail: a group reveals together (stagger capped at 6); observe per card if long grids should trickle in.
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      }), { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
        if (el.dataset.reveal === 'stagger') [...el.children].forEach((c, i) => (c as HTMLElement).style.setProperty('--i', String(Math.min(i, 5))));
        io.observe(el);
      });

      // Lets iOS Safari show :active press states
      document.addEventListener('touchstart', () => {}, { passive: true });

      // Card → detail image morph: name only the clicked card's image so view-transition names stay unique
      addEventListener('pageswap', (e) => {
        const url = (e as any).activation?.entry?.url;
        if (!url) return;
        const link = document.querySelector<HTMLAnchorElement>(`:is(.tc, .bc) h3 a[href="${new URL(url).pathname}"]`);
        const pic = link?.closest('.tc, .bc')?.querySelector<HTMLImageElement>('img');
        if (pic) pic.style.viewTransitionName = 'hero-img';
      });
      addEventListener('pageshow', () => document.querySelectorAll<HTMLImageElement>(':is(.tc, .bc) img').forEach((i) => (i.style.viewTransitionName = '')));
    </script>
  </body>
</html>
